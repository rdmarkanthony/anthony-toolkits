{%- from "components/atoms/icon.njk" import external -%}
{#
    site header, sticky with a frosted background
    url: the current page.url, marks Components as active on component pages
    GitHub hides below md, the home hero and footer link it too
#}
{% macro header(props) %}
{%- set onComponents = props.url and props.url.startsWith('/components/') -%}
<header class="header-content sticky top-0 z-40 border-b border-kit-line bg-kit-bg/75 px-4 backdrop-blur-lg">
    <div class="mx-auto flex h-16 max-w-295 items-center justify-between gap-4 md:h-20">
        <a class="font-display text-xl font-semibold tracking-tight whitespace-nowrap md:text-2xl" href="/">{{ props.site.name }}<span class="text-kit-accent">.</span></a>
        <nav aria-label="Main">
            <ul class="flex items-center gap-3 md:gap-8">
                <li>
                    <a class="flex items-center gap-2 transition-colors duration-300 hover:text-kit-text {{ 'text-kit-text' if onComponents else 'text-kit-muted' }}" href="/#components" data-auto-scroll{% if onComponents %} aria-current="true"{% endif %}>
                        <span class="size-1.5 rounded-full bg-kit-accent transition-transform duration-300 {{ 'scale-100' if onComponents else 'scale-0' }}" aria-hidden="true"></span>Components
                    </a>
                </li>
                <li class="hidden md:block"><a class="group inline-flex h-11 items-center gap-1.5 rounded-full border border-kit-line px-5 text-sm font-medium transition-colors duration-300 hover:border-kit-accent hover:text-kit-accent" href="{{ props.site.github }}" target="_blank" rel="noopener">GitHub{{ external('duration-500 ease-out-expo group-hover:translate-x-0.5 group-hover:-translate-y-0.5') }}</a></li>
            </ul>
        </nav>
    </div>
</header>
{% endmacro %}
