{%- from "components/atoms/icon.njk" import angle, external, search, menu, close -%}
{%- from "components/atoms/code-block.njk" import codeBlock -%}
{#
    site header, sticky with a frosted background
    url: page.url, marks Components active on component pages
    search on inner pages, the home page has its own
    below lg the links and search move into the sliding menu
#}
{% macro header(props) %}
{%- set onHome = props.url == '/' -%}
{%- set onComponents = props.url and props.url.startsWith('/components/') -%}
<header class="header-content sticky top-0 z-40 border-b border-kit-line bg-kit-bg/75 px-4 backdrop-blur-lg">
    <div class="mx-auto flex h-16 max-w-295 items-center justify-between gap-4 md:h-20">
        <a class="font-display text-xl font-semibold tracking-tight whitespace-nowrap md:text-2xl" href="/" aria-label="{{ props.site.name }}">{{ props.site.shortName }}<span class="text-kit-accent">.</span></a>
        <div class="flex items-center gap-8">
            {% if not onHome %}
            {{ searchForm({ id: 'search-header', class: 'hidden w-72 lg:block', listClass: 'absolute top-full right-0 mt-2 max-h-[70vh] w-96 overflow-y-auto rounded-3xl border border-kit-line bg-kit-bg p-2 shadow-xl' }) }}
            {% endif %}
            <nav class="hidden lg:block" aria-label="Main">
                <ul class="flex items-center gap-8">
                    <li>{{ componentsLink(onComponents) }}</li>
                    {% if props.starterKit.items.length %}<li><a class="text-kit-muted transition-colors duration-300 hover:text-kit-text" href="#starter-kit" data-starter-open>Starter kit</a></li>{% endif %}
                    <li><a class="group inline-flex h-11 items-center gap-2.5 rounded-full border border-kit-line pr-4 pl-5 text-sm font-medium transition-colors duration-300 hover:border-kit-accent hover:text-kit-accent" href="{{ props.site.github }}" target="_blank" rel="noopener">GitHub{{ external('size-[1.4em] duration-500 ease-out-expo group-hover:translate-x-0.5 group-hover:-translate-y-0.5') }}</a></li>
                </ul>
            </nav>
            <button class="-mr-2.5 flex size-11 items-center justify-center rounded-full text-[2rem] transition-colors duration-300 hover:text-kit-accent lg:hidden" type="button" aria-label="Open menu" aria-controls="mobile-menu" aria-expanded="false" data-mobile-menu-open>{{ menu() }}</button>
        </div>
    </div>
</header>

{# sliding menu, outside the header so the blur doesn't trap it #}
<div id="mobile-menu" class="group invisible fixed inset-0 z-50 transition-[visibility] delay-500 duration-0 data-open:visible data-open:delay-0 lg:hidden" data-mobile-menu>
    <div class="absolute inset-0 bg-kit-text/30 opacity-0 transition-opacity duration-500 group-data-open:opacity-100" data-mobile-menu-close></div>
    <div class="absolute inset-y-0 right-0 flex w-full max-w-sm translate-x-full flex-col overflow-y-auto bg-kit-bg px-4 pb-8 shadow-2xl transition-transform duration-500 ease-out-expo group-data-open:translate-x-0 sm:px-6" role="dialog" aria-modal="true" aria-label="Menu" data-mobile-menu-panel>
        <div class="mb-6 flex h-16 shrink-0 items-center justify-between md:h-20">
            <p class="text-xs tracking-wide text-kit-muted uppercase">Menu</p>
            <button class="-mr-2.5 flex size-11 items-center justify-center rounded-full text-2xl transition-colors duration-300 hover:text-kit-accent" type="button" aria-label="Close menu" data-mobile-menu-close>{{ close() }}</button>
        </div>
        {% if not onHome %}
        {{ searchForm({ id: 'search-menu', class: 'mb-8', listClass: 'mt-2 rounded-3xl border border-kit-line p-2' }) }}
        {% endif %}
        <nav aria-label="Main">
            <ul class="flex flex-col gap-4">
                <li><a class="font-display text-3xl font-semibold tracking-tight transition-colors duration-300 hover:text-kit-accent {{ 'text-kit-accent' if onComponents }}" href="/#components" data-directory-open{% if onComponents %} aria-current="true"{% endif %}>Components</a></li>
                {% if props.starterKit.items.length %}<li><a class="font-display text-3xl font-semibold tracking-tight transition-colors duration-300 hover:text-kit-accent" href="#starter-kit" data-starter-open>Starter kit</a></li>{% endif %}
                <li><a class="group inline-flex items-center gap-1.5 font-display text-3xl font-semibold tracking-tight transition-colors duration-300 hover:text-kit-accent" href="{{ props.site.github }}" target="_blank" rel="noopener">GitHub{{ external('duration-500 ease-out-expo group-hover:translate-x-0.5 group-hover:-translate-y-0.5') }}</a></li>
            </ul>
        </nav>
    </div>
</div>

{# components directory popup, names only, opened by the Components links #}
<div class="hidden">
    <div id="components-directory" class="mx-auto w-full max-w-6xl rounded-3xl bg-kit-bg p-6 md:p-10">
        <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
            <h2 class="font-display text-3xl font-semibold tracking-tight md:text-4xl">Components</h2>
            <a class="text-sm font-medium text-kit-muted transition-colors duration-300 hover:text-kit-accent" href="/#components" data-auto-scroll>All with descriptions</a>
        </div>
        <div class="columns-1 gap-10 sm:columns-2 lg:columns-4">
            {% for group in props.components %}
            <div class="mb-8 break-inside-avoid">
                {% set groupActive = group.url and props.url == group.url %}
                {% if group.url %}
                <a class="mb-2 block text-xs tracking-wide uppercase transition-colors duration-300 hover:text-kit-accent {{ 'text-kit-accent' if groupActive else 'text-kit-muted' }}" href="{{ group.url }}"{% if groupActive %} aria-current="page"{% endif %}>{{ group.category }}</a>
                {% else %}
                <p class="mb-2 text-xs tracking-wide text-kit-muted uppercase">{{ group.category }}</p>
                {% endif %}
                <ul>
                    {% for item in group.items %}{% if item.ready %}
                    {% set active = props.url == item.url %}
                    <li>
                        <a class="flex items-center gap-2 py-1 transition-colors duration-300 hover:text-kit-accent {{ 'text-kit-accent' if active }}" href="{{ item.url }}"{% if active %} aria-current="page"{% endif %}>
                            <span class="size-1.5 shrink-0 rounded-full bg-kit-accent {{ 'scale-100' if active else 'scale-0' }}" aria-hidden="true"></span>{{ item.label }}
                        </a>
                    </li>
                    {% endif %}{% endfor %}
                </ul>
            </div>
            {% endfor %}
        </div>
    </div>
</div>

{# starter kit popup, opened by the Starter kit links #}
{% if props.starterKit.items.length %}
<div class="hidden">
    <div id="starter-kit" class="mx-auto w-full max-w-5xl rounded-3xl bg-kit-bg p-6 md:p-10">
        <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
            <div>
                <h2 class="font-display text-3xl font-semibold tracking-tight md:text-4xl">Starter kit</h2>
                <p class="mt-2 text-kit-muted">The ones that go into every new project, and the files to copy.</p>
            </div>
            <button class="inline-flex h-11 cursor-pointer items-center rounded-full border border-kit-line px-5 text-sm font-medium transition-colors duration-300 hover:border-kit-accent hover:text-kit-accent" type="button" data-starter-copy>Copy file list</button>
        </div>
        <div class="grid gap-8 lg:grid-cols-[1fr_1.4fr] lg:gap-10">
            <ul class="border-t border-kit-line">
                {% for item in props.starterKit.items %}
                <li>
                    <a class="group flex items-center justify-between gap-4 border-b border-kit-line py-4" href="{{ item.url }}">
                        <span>
                            <span class="block font-display text-xl font-medium tracking-tight transition-colors duration-300 group-hover:text-kit-accent">{{ item.label }}</span>
                            <span class="block text-sm text-kit-muted">{{ item.utils }}</span>
                        </span>
                        {{ angle('right', 'duration-500 ease-out-expo group-hover:translate-x-0.5 group-hover:text-kit-accent') }}
                    </a>
                </li>
                {% endfor %}
            </ul>
            <div class="min-w-0" data-starter-files>{{ codeBlock(props.starterKit.files, 'files to copy') }}</div>
        </div>
    </div>
</div>
{% endif %}

{# the suggestions, same text the home page filters on #}
{%- set searchItems = [] -%}
{%- for group in props.components -%}
    {%- for item in group.items -%}
        {%- if item.ready -%}
            {%- set _ = searchItems.push({ label: item.label, url: item.url, category: group.category, text: [item.label, item.description, item.utils, group.category] | join(' ') }) -%}
        {%- endif -%}
    {%- endfor -%}
{%- endfor %}
<script type="application/json" id="search-items">{{ searchItems | dump | safe }}</script>
{% endmacro %}

{# Components link with the active dot, opens the directory popup #}
{% macro componentsLink(active) %}
<a class="flex items-center gap-2 transition-colors duration-300 hover:text-kit-text {{ 'text-kit-text' if active else 'text-kit-muted' }}" href="/#components" data-directory-open{% if active %} aria-current="true"{% endif %}>
    <span class="size-1.5 rounded-full bg-kit-accent transition-transform duration-300 {{ 'scale-100' if active else 'scale-0' }}" aria-hidden="true"></span>Components
</a>
{% endmacro %}

{#
    search with suggestions, set up in script.js
    Enter with no pick goes to /?q=
#}
{% macro searchForm(props) %}
<form class="relative {{ props.class }}" action="/" method="get" role="search" data-search>
    <label class="relative block">
        <span class="sr-only">Search components</span>
        <span class="pointer-events-none absolute top-1/2 left-4 -translate-y-1/2 text-kit-muted">{{ search() }}</span>
        <input id="{{ props.id }}" class="h-11 w-full rounded-full border border-kit-line bg-transparent pr-4 pl-10 transition-colors duration-300 placeholder:text-kit-muted focus:border-kit-accent focus:outline-none" type="search" name="q" placeholder="Search components…" autocomplete="off" data-search-input />
    </label>
    <div id="{{ props.id }}-list" class="{{ props.listClass }}" hidden data-search-list></div>
</form>
{% endmacro %}
