{% macro footer(props) %}
<footer class="footer-content border-t border-gray-200 px-4">
    <div class="mx-auto flex max-w-295 flex-wrap items-center justify-between gap-2 py-6 text-xs text-gray-500">
        <p>&copy; {{ props.site.year }} {{ props.site.name }}</p>
        <a class="transition-colors hover:text-gray-950" href="{{ props.site.github }}" target="_blank" rel="noopener">GitHub</a>
    </div>
</footer>
{% endmacro %}
