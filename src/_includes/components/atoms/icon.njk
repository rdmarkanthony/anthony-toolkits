{#
    angle (chevron) icon, sized and colored by the text around it
    usage: {{ angle('right') }}, {{ angle('down', 'group-hover:translate-y-0.5') }}
    direction: right (default), left, up, down
#}
{% macro angle(direction, class) -%}
{%- set paths = { right: 'm9 5 7 7-7 7', left: 'm15 5-7 7 7 7', up: 'm5 15 7-7 7 7', down: 'm5 9 7 7 7-7' } -%}
<svg class="inline-block size-[0.9em] shrink-0 transition-transform {{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="{{ paths[direction | default('right')] }}" /></svg>
{%- endmacro %}

{#
    external (↗) icon for links that open in a new tab, sized and colored by the text around it
    also adds screen reader text, so the link reads "GitHub (opens in a new tab)"
    usage: {{ external() }}, {{ external('group-hover:-translate-y-0.5') }}
#}
{% macro external(class) -%}
<svg class="inline-block size-[0.85em] shrink-0 transition-transform {{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg><span class="sr-only">(opens in a new tab)</span>
{%- endmacro %}

{#
    search (magnifier), menu (burger) and close (×) icons, sized and colored by the text around them
    usage: {{ search() }}, {{ menu('size-6') }}, {{ close('size-6') }}
#}
{% macro search(class) -%}
<svg class="inline-block size-[1em] shrink-0 {{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
{%- endmacro %}

{% macro menu(class) -%}
<svg class="inline-block size-[1em] shrink-0 {{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
{%- endmacro %}

{% macro close(class) -%}
<svg class="inline-block size-[1em] shrink-0 {{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
{%- endmacro %}
