{%- from "utils/combine-classes.njk" import combineClasses -%}
{%- from "utils/dynamic-element.njk" import dynamicElement -%}
{%- from "components/atoms/icon.njk" import external -%}

{#
    pill button, a link when it has a url
    usage: {{ renderButton({ label: 'See the demos', url: '#demos' }) }}
    type: primary (default), outline
    target: _blank adds the external icon
#}
{% macro renderButton(props) -%}
    {%- set type = props.type | default('primary') -%}
    {%- set label = props.label | default('Button') -%}
    {%- set url = props.url | default('') -%}
    {%- set target = props.target | default('') -%}
    {%- set class = props.class | default('') -%}
    {%- set attributes = props.attr | default([]) -%}

    {%- set className = combineClasses([
        class,
        'group inline-flex h-13 items-center justify-center gap-1.5 rounded-full px-7 font-medium transition-colors duration-300',
        (type == 'primary') and 'bg-kit-accent text-kit-accent-ink hover:bg-kit-accent-hover',
        (type == 'outline') and 'border border-kit-line hover:border-kit-accent hover:text-kit-accent'
    ]) -%}

    {%- set buttonTag = "a" if props.url else "button" -%}
    {%- set buttonAttrs = {
        "type": "" if url else "button",
        "class": className,
        "href": url if url else "",
        "target": target if url else "",
        "rel": "noopener" if target == "_blank" else ""
    } %}
    
    {%- set extraAttrs = '' %}
    {% for attr in attributes %}
        {% for key, value in attr %}
            {% set extraAttrs = extraAttrs + ' ' + key + (('="' + value + '"') if value else '') %}
        {% endfor %}
    {% endfor %}

    {%- call dynamicElement(buttonTag, buttonAttrs, extraAttrs) -%}
        <span>{{ label }}</span>{% if target == '_blank' %}{{ external('duration-500 ease-out-expo group-hover:translate-x-0.5 group-hover:-translate-y-0.5') }}{% endif %}
    {%- endcall -%}
{%- endmacro %}
