{%- from "components/atoms/back-link.njk" import backLink -%}
{%- from "components/atoms/code-block.njk" import codeBlock -%}
{%- from "components/atoms/tag.njk" import tags -%}

{#
    page title, for component pages
    usage: {{ pageIntro({ label: '_tabs', title: 'Tabs', description: '...' }) }}
    label: the utils it uses, "_a · _b", shown as tags
    back: { label, url } for a parent page, Components on the home page by default
#}
{% macro pageIntro(props) -%}
<section class="px-4 pt-20 pb-16 md:pt-28">
    <div class="mx-auto max-w-295">
        {{ backLink(props.back or { label: 'Components', url: '/#components' }) }}
        {% if props.label -%}
        {{ tags(props.label, 'mb-6') }}
        {%- endif %}
        <h1 class="mb-6 max-w-4xl font-display text-[--spacing(11)] leading-[1.02] font-semibold tracking-tight text-balance md:text-[--spacing(18)]">{{ props.title }}</h1>
        {% if props.description -%}
        <p class="max-w-2xl text-lg text-kit-muted md:text-xl">{{ props.description | safe }}</p>
        {%- endif %}
    </div>
</section>
{%- endmacro %}

{#
    the page script as code, starting with its // Requirements
    usage:
    {% set pageScript %}{% raw %}// Requirements ... new _tabs({ target });{% endraw %}{% endset %}
    {{ scriptUsage({ code: pageScript, note: '...' }) }}
    optional: markup, markupNote, css, cssNote, more: [{ title, note, code, lang }]
    run it too: {% footerscript %}<script type="module">{{ pageScript | safe }}</script>{% endfooterscript %}
#}
{% macro scriptUsage(props) -%}
<section class="mt-8 border-t border-kit-line px-4 py-16 md:py-28">
    <div class="mx-auto max-w-295">
        <h2 class="mb-10 font-display text-[--spacing(10)] leading-[1.02] font-semibold tracking-tight md:mb-16 md:text-[--spacing(14)]">How to use</h2>
        <div class="grid gap-10">
            {% if props.markup -%}
            <div class="grid gap-4 md:grid-cols-[1fr_2fr] md:gap-10">
                <div>
                    <h3 class="mb-2 font-display text-2xl font-medium tracking-tight">Markup</h3>
                    {% if props.markupNote -%}
                    <p class="text-kit-muted">{{ props.markupNote | safe }}</p>
                    {%- endif %}
                </div>
                {{ codeBlock(props.markup, 'html') }}
            </div>
            {%- endif %}
            {% if props.css -%}
            <div class="grid gap-4 md:grid-cols-[1fr_2fr] md:gap-10">
                <div>
                    <h3 class="mb-2 font-display text-2xl font-medium tracking-tight">CSS</h3>
                    {% if props.cssNote -%}
                    <p class="text-kit-muted">{{ props.cssNote | safe }}</p>
                    {%- endif %}
                </div>
                {{ codeBlock(props.css, 'css') }}
            </div>
            {%- endif %}
            {% if props.code -%}
            <div class="grid gap-4 md:grid-cols-[1fr_2fr] md:gap-10">
                <div>
                    <h3 class="mb-2 font-display text-2xl font-medium tracking-tight">Script</h3>
                    {% if props.note -%}
                    <p class="text-kit-muted">{{ props.note | safe }}</p>
                    {%- endif %}
                </div>
                {{ codeBlock(props.code, 'js') }}
            </div>
            {%- endif %}
            {% for block in props.more -%}
            <div class="grid gap-4 md:grid-cols-[1fr_2fr] md:gap-10">
                <div>
                    <h3 class="mb-2 font-display text-2xl font-medium tracking-tight">{{ block.title }}</h3>
                    {% if block.note -%}
                    <p class="text-kit-muted">{{ block.note | safe }}</p>
                    {%- endif %}
                </div>
                {{ codeBlock(block.code, block.lang or 'js') }}
            </div>
            {%- endfor %}
        </div>
    </div>
</section>
{%- endmacro %}
