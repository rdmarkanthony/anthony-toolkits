{#
    usage:
    {% set code %}{% raw %}<div class="js-example"></div>{% endraw %}{% endset %}
    {{ codeBlock(code, 'html') }}
#}
{% macro codeBlock(code, label) -%}
<div class="min-w-0 overflow-hidden rounded-2xl border border-kit-line bg-kit-surface text-sm">
    {% if label -%}
    <div class="border-b border-kit-line px-5 py-2.5 font-mono text-xs text-kit-muted">{{ label }}</div>
    {%- endif %}
    <pre class="overflow-x-auto p-5 leading-relaxed"><code>{{ code | trim | forceescape }}</code></pre>
</div>
{%- endmacro %}
