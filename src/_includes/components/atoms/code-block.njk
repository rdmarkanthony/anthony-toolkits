{#
    usage:
    {% set code %}{% raw %}<div class="js-example"></div>{% endraw %}{% endset %}
    {{ codeBlock(code, 'html') }}
#}
{% macro codeBlock(code, label) -%}
<div class="overflow-hidden rounded-lg border border-gray-200 bg-gray-50 text-sm text-gray-800">
    {% if label -%}
    <div class="border-b border-gray-200 px-4 py-2 font-mono text-xs text-gray-500">{{ label }}</div>
    {%- endif %}
    <pre class="overflow-x-auto p-4 leading-relaxed"><code>{{ code | trim | forceescape }}</code></pre>
</div>
{%- endmacro %}
