{#
    usage:
    {% set code %}{% raw %}<div class="js-example"></div>{% endraw %}{% endset %}
    {{ codeBlock(code, 'html') }}
#}
{% macro codeBlock(code, label) -%}
<div class="overflow-hidden rounded-lg bg-slate-950 text-sm text-slate-100">
    {% if label -%}
    <div class="border-b border-white/10 px-4 py-2 font-mono text-xs text-slate-400">{{ label }}</div>
    {%- endif %}
    <pre class="overflow-x-auto p-4 leading-relaxed"><code>{{ code | trim | forceescape }}</code></pre>
</div>
{%- endmacro %}
