{#
    the _header demo pages, shown in iframes on /components/header/
    usage: {% from "demos/header.njk" import demoHeader, demoHero, demoGrid, demoEvent %}
#}
{% macro demoHeader() %}
{% set ease = 'ease-[cubic-bezier(0.16,1,0.3,1)]' %}
{% set links = ['Work', 'Services', 'About', 'Journal', 'Contact'] %}
<!-- no top-0 while absolute, so it sits below anything above it -->
<header class="js-header absolute inset-x-0 z-40 text-white transition-[translate,background-color,color,box-shadow] duration-500 {{ ease }} data-fixed:fixed data-fixed:top-0 data-fixed:bg-white data-fixed:text-gray-950 data-fixed:shadow-sm data-hidden:-translate-y-full">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-5 md:h-20 md:px-8">
        <a class="text-xl font-bold tracking-tight" href="#">Studio.</a>
        <nav class="hidden lg:block">
            <ul class="flex items-center gap-8 text-sm font-medium">
                {% for link in links.slice(0, 4) %}<li><a class="opacity-70 transition-opacity hover:opacity-100" href="#">{{ link }}</a></li>{% endfor %}
            </ul>
        </nav>
        <a class="hidden rounded-full border border-current px-4 py-2 text-sm font-medium lg:inline-block" href="#">Contact</a>
        <button class="js-header-menu-toggle -mr-2 flex size-10 cursor-pointer items-center justify-center lg:hidden" type="button" aria-label="Menu">
            <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16" /></svg>
        </button>
    </div>
</header>

<!-- the menu, outside the header: a backdrop-blur on the header would trap it -->
<div class="js-header-menu group/menu invisible fixed inset-0 z-50 outline-none transition-[visibility] delay-500 duration-0 data-open:visible data-open:delay-0 lg:hidden">
    <div class="js-header-menu-close absolute inset-0 bg-gray-950/40 opacity-0 transition-opacity duration-500 group-data-open/menu:opacity-100"></div>
    <div class="absolute inset-y-0 right-0 flex w-[85%] max-w-sm translate-x-full flex-col bg-white px-6 pb-8 transition-transform duration-500 {{ ease }} group-data-open/menu:translate-x-0" role="dialog" aria-modal="true" aria-label="Menu">
        <div class="flex h-16 shrink-0 items-center justify-between md:h-20">
            <p class="font-mono text-xs tracking-wide text-gray-500 uppercase">Menu</p>
            <button class="js-header-menu-close -mr-2 flex size-10 cursor-pointer items-center justify-center" type="button" aria-label="Close menu">
                <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
            </button>
        </div>
        <nav class="mt-6">
            <ul class="flex flex-col gap-3">
                {% for link in links %}
                <li class="translate-y-4 opacity-0 transition-[translate,opacity] duration-500 {{ ease }} group-data-open/menu:translate-y-0 group-data-open/menu:opacity-100 group-data-open/menu:delay-(--delay)" style="--delay: {{ 150 + loop.index0 * 50 }}ms">
                    <a class="text-3xl font-bold tracking-tight transition-colors hover:text-gray-500" href="#">{{ link }}</a>
                </li>
                {% endfor %}
            </ul>
        </nav>
        <a class="mt-auto rounded-full bg-gray-950 py-3 text-center font-medium text-white" href="#">Start a project</a>
    </div>
</div>
{% endmacro %}

{% macro demoHero(title) %}
<div class="flex min-h-96 items-end bg-gray-950 px-5 pt-28 pb-10 text-white md:px-8">
    <h1 class="mx-auto w-full max-w-6xl text-4xl font-bold tracking-tight text-balance md:text-6xl">{{ title }}</h1>
</div>
{% endmacro %}

{% macro demoGrid() %}
<div class="mx-auto grid max-w-6xl gap-6 px-5 py-10 sm:grid-cols-2 md:px-8 lg:grid-cols-3">
    {% for i in range(0, 12) %}
    <div class="flex flex-col gap-3">
        <div class="aspect-4/3 rounded-2xl bg-gray-100"></div>
        <p class="font-semibold">Project {{ i + 1 }}</p>
        <p class="text-sm text-gray-500">Lorem ipsum dolor sit amet consectetur adipisicing elit.</p>
    </div>
    {% endfor %}
</div>
{% endmacro %}

{% macro demoEvent() %}
<p class="pointer-events-none fixed bottom-4 left-4 z-30 rounded-full bg-gray-950 px-3 py-1.5 font-mono text-xs text-white">last event: <span class="js-header-event">-</span></p>
{% endmacro %}
