---
title: Enquire | Anthony Toolkits
---

{% from "components/atoms/component-page.njk" import pageIntro, scriptUsage %}

{{ pageIntro({ label: '_enquire', title: 'Enquire', description: 'Runs code once each time the window enters a breakpoint. For example, move an element on mobile, or open the first accordion item on desktop. It switches at the same width as your CSS.' }) }}

{% set faq = [
    { q: 'Question one', a: 'Lorem ipsum dolor sit amet consectetur adipisicing elit.' },
    { q: 'Question two', a: 'Lorem ipsum dolor sit amet consectetur adipisicing elit.' },
    { q: 'Question three', a: 'Lorem ipsum dolor sit amet consectetur adipisicing elit.' }
] %}

{% set title = 'js-accordion-set-title group flex w-full cursor-pointer items-center justify-between gap-6 py-5 text-left text-lg font-semibold transition-colors hover:text-gray-600' %}
{% set chevron = '<svg class="size-5 shrink-0 transition-transform duration-300 group-aria-expanded:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>' %}

{# demo: the card moves from the sidebar into the article on mobile #}
<section class="px-4 py-16">
    <div class="mx-auto flex max-w-295 flex-col gap-6">
        <div class="flex flex-wrap items-end justify-between gap-4">
            <h2 class="text-3xl font-bold tracking-tight">Move an element</h2>
            <p class="font-mono text-sm text-gray-500">now: <span class="js-enquire-now">-</span></p>
        </div>
        <p class="max-w-2xl text-gray-600">Desktop: card in the sidebar. Mobile: card between the paragraphs.</p>
        <div class="grid gap-8 md:grid-cols-[1fr_20rem]">
            <article class="flex max-w-2xl flex-col gap-4 text-gray-600">
                <h3 class="text-xl font-semibold text-gray-950">Visiting the garden</h3>
                <p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Libero est illo eius laudantium.</p>
                <div class="js-enquire-mobile empty:hidden"></div>
                <p>Officiis voluptatibus natus quae perferendis, explicabo magnam doloribus sequi.</p>
            </article>
            <aside class="js-enquire-desktop">
                <div class="js-enquire-cta flex flex-col items-start gap-4 rounded-2xl bg-gray-950 p-6 text-white">
                    <p class="font-mono text-sm opacity-60">Open daily</p>
                    <p class="text-2xl font-bold tracking-tight">Book a visit</p>
                    <a class="rounded-full bg-white px-5 py-2.5 font-semibold text-gray-950 transition-colors hover:bg-gray-200" href="#">Book now</a>
                </div>
            </aside>
        </div>
    </div>
</section>

{# demo: first set open on desktop, all closed on mobile #}
<section class="bg-gray-50 px-4 py-16">
    <div class="mx-auto flex max-w-295 flex-col gap-6">
        <h2 class="text-3xl font-bold tracking-tight">Accordion</h2>
        <p class="max-w-2xl text-gray-600">Desktop: first item open. Mobile: all closed.</p>
        <div class="js-enquire-accordion max-w-3xl border-t border-gray-200">
            {% for item in faq %}
            <div class="js-accordion-set border-b border-gray-200">
                <button class="{{ title }}" type="button">{{ item.q }}{{ chevron | safe }}</button>
                <div class="js-accordion-set-content" hidden="until-found">
                    <p class="max-w-2xl pb-5 text-gray-600">{{ item.a }}</p>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

{% set pageScript %}{% raw %}
// Requirements
    // JS
        // src/assets/js/utils/_enquire.js
        // src/assets/js/utils/_emitter.js
        // src/assets/js/utils/_accordion.js

// move the card
const _cta = document.querySelector('.js-enquire-cta');

new _enquire({
    0: () => document.querySelector('.js-enquire-mobile').append(_cta),
    768: () => document.querySelector('.js-enquire-desktop').append(_cta),
});

// accordion
const _faq = new _accordion({ target: document.querySelector('.js-enquire-accordion'), openFirst: false });

new _enquire({
    // no animation on load
    0: (enquire) => _faq.sets.forEach((set) => _faq.isOpen(set) && _faq.close(set, enquire.prevBreakpoint !== null)),
    768: (enquire) => _faq.open(_faq.sets[0], enquire.prevBreakpoint !== null),
});

// "now" label
const _now = document.querySelector('.js-enquire-now');

new _enquire({
    0: () => (_now.textContent = 'mobile'),
    768: () => (_now.textContent = 'tablet'),
    1240: () => (_now.textContent = 'desktop'),
});
{% endraw %}{% endset %}

{{ scriptUsage({
    code: pageScript,
    note: 'Keys are min-widths. <code class="font-mono text-sm">enquire.prevBreakpoint</code> is <code class="font-mono text-sm">null</code> on load. <code class="font-mono text-sm">destroy()</code> stops it.'
}) }}

{% footerscript %}
<script type="module">{{ pageScript | safe }}</script>
{% endfooterscript %}
