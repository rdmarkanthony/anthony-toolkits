{% set pageScript %}{% raw %}
// Requirements
    // JS
        // src/assets/js/utils/_emitter.js
        // src/assets/js/utils/_event.js
        // src/assets/js/utils/_inview.js
        // src/assets/js/utils/_threeBackground.js
        // src/assets/js/utils/_threeText.js
    // Packages
        // three

// the font and weight come from the target, here font-display font-extrabold
const _hero = _threeText({ text: 'Hello', rows: 5, gap: 3, size: 1.6 });
new _threeBackground({
    target: document.querySelector('.js-text-dark'),
    // defaults: text: 'Hello', color: '#ffffff', rows: 4, spacing: 0.4, gap: 4, size: 2, opacity: 0.25, light: 2.5, grow: 1.6, follow: 8,
    // font: null, weight: null, radius: 1.2, push: 40, spring: 30, damping: 6, burst: 10, depth: 0.4, parallax: 0.06
    effect: _hero,
});

document.querySelector('.js-text-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const _input = document.querySelector('.js-text-input');
    if (_input.value.trim()) _hero.set(_input.value.trim());
    _input.value = '';
});

// set() and burst()
const _text = _threeText({ text: 'Lorem\nipsum', color: ['#0f172a', '#4f46e5', '#f43f5e'], rows: 3, gap: 3, size: 2.5 });
new _threeBackground({
    target: document.querySelector('.js-text-light'),
    effect: _text,
});
window._text = _text; // demo

document.querySelectorAll('.js-text-set').forEach((button) => button.addEventListener('click', () => _text.set(button.dataset.text)));
document.querySelector('.js-text-burst').addEventListener('click', () => _text.burst());
{% endraw %}{% endset %}

