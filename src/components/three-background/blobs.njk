{% set pageScript %}{% raw %}
// Requirements
    // JS
        // src/assets/js/utils/_emitter.js
        // src/assets/js/utils/_event.js
        // src/assets/js/utils/_inview.js
        // src/assets/js/utils/_threeBackground.js
        // src/assets/js/utils/_threeBlobs.js
    // Packages
        // three

// colors with their spots, [x, y] from -1 to 1, y up
const _spots = [[-0.6, 0.5], [0.55, 0.95], [0.85, -0.6], [-0.3, -1]];
const _palettes = {
    sandstone: { colors: ['#bba898', '#ddc4b8', '#cf5e58', '#d6d3c5'], background: '#b8a797', theme: 'light' },
    merlot: { colors: ['#7c1832', '#141a2b', '#1d5a86', '#a35366'], background: '#5a1f35', theme: 'dark' },
    lagoon: { colors: ['#2e7a6c', '#d4a352', '#c8e6d6', '#5a8f84'], background: '#3a7d6f', theme: 'dark' },
    dusk: { colors: ['#22252c', '#6b7581', '#e6c08a', '#2a3038'], background: '#24272e', theme: 'dark' },
    forest: { colors: ['#2b4538', '#b8d3d6', '#5c8c8a', '#4b7d48'], background: '#33503f', theme: 'dark' },
    olive: { colors: ['#47695c', '#9b7f4f', '#3b5c44', '#727b72'], background: '#4d6a5c', theme: 'dark' },
};

const _target = document.querySelector('.js-three-blobs');
const _blobs = _threeBlobs({
    // defaults: size: 1, opacity: 1, speed: 0.4, wobble: 0.3, flow: 0.25, follow: 0.05, grain: 0.12, transition: 2
    ..._palettes.sandstone,
    positions: _spots,
});
new _threeBackground({ target: _target, effect: _blobs });

const _projects = document.querySelector('.js-blob-projects');
const _pick = (e) => {
    const _button = e.target.closest('[data-project]');
    if (!_button || _button.getAttribute('aria-current')) return;

    const _palette = _palettes[_button.dataset.project];
    _projects.querySelector('[aria-current]')?.removeAttribute('aria-current');
    _button.setAttribute('aria-current', 'true');
    document.querySelectorAll('[data-project-panel]').forEach((panel) => (panel.hidden = panel.dataset.projectPanel !== _button.dataset.project));

    _target.dataset.theme = _palette.theme; // text color
    _blobs.set({ ..._palette, positions: _spots });
};
['pointerover', 'click'].forEach((type) => _projects.addEventListener(type, _pick));
{% endraw %}{% endset %}

