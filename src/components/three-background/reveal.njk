{% set pageScript %}{% raw %}
// Requirements
    // JS
        // src/assets/js/utils/_emitter.js
        // src/assets/js/utils/_event.js
        // src/assets/js/utils/_inview.js
        // src/assets/js/utils/_threeBackground.js
        // src/assets/js/utils/_threeReveal.js
    // Packages
        // three

// gray on top, the same photo in color under the trail
new _threeBackground({
    target: document.querySelector('.js-reveal-hero'),
    // defaults: reveal: the same image, gray: 1, radius: 90, fade: 1.2, soft: 0.25
    effect: _threeReveal({ image: '/assets/img/sample-image.webp' }),
});

// bigger and slower
new _threeBackground({
    target: document.querySelector('.js-reveal-slow'),
    effect: _threeReveal({ image: '/assets/img/sample-image.webp', gray: 0.6, radius: 150, fade: 3, soft: 0.4 }),
});
{% endraw %}{% endset %}

{{ scriptUsage({
    code: pageScript,
    note: 'Options: <code class="font-mono text-sm">reveal</code> a second image, <code class="font-mono text-sm">gray</code> 0 to keep the top one in color, <code class="font-mono text-sm">radius</code> the brush in px, <code class="font-mono text-sm">fade</code> in seconds, <code class="font-mono text-sm">soft</code> the edge. On phones it paints while dragging. Markup and the base are on the <a class="underline" href="/components/three-background/">overview</a>.'
}) }}

