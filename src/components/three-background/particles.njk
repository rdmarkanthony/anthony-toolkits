{% set pageScript %}{% raw %}
// Requirements
    // JS
        // src/assets/js/utils/_emitter.js
        // src/assets/js/utils/_event.js
        // src/assets/js/utils/_inview.js
        // src/assets/js/utils/_threeBackground.js
        // src/assets/js/utils/_threeParticles.js
    // Packages
        // three

new _threeBackground({
    target: document.querySelector('.js-three-dark'),
    // defaults: count: 800, color: '#ffffff', size: 2.5, speed: 0.1, depth: 4, radius: 2, push: 0.8, parallax: 0.08, opacity: 0.6
    effect: _threeParticles(),
});

// methods and events
const _log = document.querySelector('.js-three-log'); // demo
const _light = new _threeBackground({
    target: document.querySelector('.js-three-light'),
    effect: _threeParticles({ color: ['#7dd3fc', '#fcd34d', '#fda4af'], count: 120, size: 7, parallax: 0 }),
    events: {
        // ready: () => console.log('ready'),
        // play: () => console.log('play'),
        // pause: (instance) => console.log('pause', instance.time),
        ready: () => (_log.textContent = 'ready'), // demo
        play: () => (_log.textContent = 'play'), // demo
        pause: (instance) => (_log.textContent = `pause, at ${instance.time.toFixed(1)}s`), // demo
    },
});
window._light = _light; // demo

document.querySelector('.js-three-pause').addEventListener('click', () => _light.pause());
document.querySelector('.js-three-play').addEventListener('click', () => _light.play());
{% endraw %}{% endset %}

