{% set pageScript %}{% raw %}
// Requirements
    // JS
        // src/assets/js/utils/_emitter.js
        // src/assets/js/utils/_event.js
        // src/assets/js/utils/_inview.js
        // src/assets/js/utils/_threeBackground.js
        // src/assets/js/utils/_threeGlow.js
    // Packages
        // three

// set() fades to the other theme
const _themes = {
    dark: { color: '#818cf8', background: '#0c0c0e', strength: 0.3 },
    light: { color: '#818cf8', background: '#f5f4ef', strength: 0.6 },
};
const _target = document.querySelector('.js-three-glow');
const _glow = _threeGlow({
    // defaults: rest: [0.7, 0.45], radius: 0.25, blur: 0.08, mirror: 0.6, grain: 0.28, follow: 1.2
    ..._themes.dark,
});
new _threeBackground({ target: _target, effect: _glow });

document.querySelector('.js-glow-theme').addEventListener('click', () => {
    const _theme = _target.dataset.theme === 'dark' ? 'light' : 'dark';
    _target.dataset.theme = _theme;
    _glow.set(_themes[_theme]);
});
{% endraw %}{% endset %}

