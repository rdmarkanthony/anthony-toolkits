{% set pageScript %}{% raw %}
// Requirements
    // JS
        // src/assets/js/utils/_emitter.js
        // src/assets/js/utils/_event.js
        // src/assets/js/utils/_inview.js
        // src/assets/js/utils/_threeBackground.js
        // src/assets/js/utils/_threeDotGrid.js
    // Packages
        // three

new _threeBackground({
    target: document.querySelector('.js-dots-dark'),
    // defaults: color: '#ffffff', gap: 12, size: 1.5, round: false, amount: 0.5, scale: 1, speed: 0.6, twinkle: 0, opacity: 0.8, radius: 90, fade: 1.2
    effect: _threeDotGrid(),
});

// set() glides to a new amount or color
const _dots = _threeDotGrid({ color: '#6366f1', gap: 18, size: 5, round: true, scale: 0.7, radius: 70 });
new _threeBackground({ target: document.querySelector('.js-dots-light'), effect: _dots });

document.querySelectorAll('.js-dots-amount').forEach((button) => {
    button.addEventListener('click', () => _dots.set({ amount: Number(button.dataset.amount) }));
});

const _colors = ['#6366f1', '#f43f5e', '#10b981'];
document.querySelector('.js-dots-color').addEventListener('click', () => {
    _colors.push(_colors.shift());
    _dots.set({ color: _colors[0] });
});
{% endraw %}{% endset %}

