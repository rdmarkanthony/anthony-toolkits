{% set markup %}{% raw %}
<!-- a parent, its children animate in order -->
<section data-animate>
    <div data-animate="parent">
        <div data-animate="children">
            <!-- pulls up word by word -->
            <h2 class="js-splittext">Title</h2>
            <!-- these children animate on their own, as each scrolls into view -->
            <div data-animate="children-inview">
                <p>...</p>
            </div>
            <!-- keyframe and delay for this child -->
            <div data-animate="rubberBand,calc(var(--animate-delay) + 0.8s)">...</div>
        </div>
    </div>
</section>

<!-- a single element: data-animate="keyframe,delay,duration", in seconds -->
<p data-animate="fadeInDown,1,0.8">...</p>
{% endraw %}{% endset %}

{% set pageScript %}{% raw %}
// Requirements
    // JS
        // split-type (optional, for .js-splittext)
        // src/assets/js/utils/_event.js
        // src/assets/js/utils/_inview.js
        // src/assets/js/utils/_splitText.js (optional, for .js-splittext)
        // src/assets/js/utils/_animate.js
    // CSS
        // animate.css
        // src/assets/css/components/data-animate.css

// once per page, for every [data-animate]
new _animate({
    debug: false, // true keeps the inline animation styles on the elements
    delay: 0.1,
    adjacentDelay: 0.2, // added for each next child
    duration: 0.8,
    keyframe: 'fadeInUpSmall', // default, from data-animate.css
});
{% endraw %}{% endset %}

