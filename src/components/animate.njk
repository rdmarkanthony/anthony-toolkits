{% set markup %}{% raw %}
<!-- in <head> -->
<script>document.documentElement.classList.add("js-animate");</script>

<!-- a parent, its children animate in order -->
<section data-animate>
    <div data-animate="parent">
        <div data-animate="children">
            <!-- pulls up word by word -->
            <h2 class="js-splittext">Title</h2>
            <!-- these animate on their own, when in view -->
            <div data-animate="children-inview">
                <p>...</p>
            </div>
            <!-- keyframe and delay for this child -->
            <div data-animate="rubberBand,calc(var(--animate-delay) + 0.8s)">...</div>
        </div>
    </div>
</section>

<!-- a single element: data-animate="keyframe,delay,duration", in seconds -->
<p data-animate="fadeInDown,1,0.8">...</p>

<!-- a Down keyframe pulls the words down -->
<h2 class="js-splittext" data-animate="fadeInDownSmall">Title</h2>

<!-- added later, then refresh() -->
<div class="js-animate-list">
    <div data-animate="fadeInUpSmall,0.1">...</div>
    <div data-animate="fadeInUpSmall,0.2">...</div>
</div>
{% endraw %}{% endset %}

{% set pageScript %}{% raw %}
// Requirements
    // JS
        // split-type (optional, for .js-splittext)
        // src/assets/js/utils/_event.js
        // src/assets/js/utils/_inview.js
        // src/assets/js/utils/_splitText.js (optional, for .js-splittext)
        // src/assets/js/utils/_animate.js
    // HTML
        // document.documentElement.classList.add("js-animate") in <head>
    // CSS
        // animate.css
        // src/assets/css/components/data-animate.css

// once per page, for every [data-animate]
const _animation = new _animate({
    debug: false, // true keeps the inline animation styles on the elements
    delay: 0.1,
    adjacentDelay: 0.2, // added for each next child
    duration: 0.8,
    keyframe: 'fadeInUpSmall', // default, fadeInUpSmall or fadeInDownSmall from data-animate.css
});

// load more
const _list = document.querySelector('.js-animate-list');
let _count = 0;

const _loadMore = () => {
    const _cards = Array.from({ length: 4 }, (_, index) => {
        _count++;
        return `<div class="rounded-2xl border border-gray-200 bg-white p-6" data-animate="fadeInUpSmall,${(0.1 * (index + 1)).toFixed(1)}">
            <p class="font-mono text-sm text-gray-500">Card ${_count}</p>
        </div>`;
    });

    _list.insertAdjacentHTML('beforeend', _cards.join(''));
    _animation.refresh(_list);
};

_loadMore();
document.querySelector('.js-animate-more').addEventListener('click', _loadMore);
{% endraw %}{% endset %}

