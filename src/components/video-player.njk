---
title: Video player | Anthony Toolkits
---

{% from "components/atoms/component-page.njk" import scriptUsage %}

{% set video = '/assets/video/sample-video.mp4' %}
{% set videoHls = '/assets/video/sample-video/sample-video.m3u8' %}

{# demo: a stretched autoplay video as the background #}
<section class="relative overflow-hidden bg-gray-950 px-4 pt-24 pb-16 text-white md:pt-32">
    <div class="pointer-events-none absolute inset-0">
        <div class="absolute inset-0" data-video-player="{{ video }},autoplay,stretch"></div>
        <div class="absolute inset-0 bg-black/50"></div>
    </div>
    <div class="relative mx-auto max-w-295">
        <p class="mb-4 font-mono text-sm text-gray-300">_videoPlayer</p>
        <h1 class="mb-6 text-5xl font-bold tracking-tight md:text-7xl">Video player</h1>
        <p class="max-w-2xl text-lg text-gray-300 md:text-xl">MP4 and HLS (<code class="font-mono text-base">.m3u8</code>) videos from a data attribute. Autoplay videos are muted loops, and stretch covers the box at any ratio. Playing one video pauses the others, YouTube players too.</p>
    </div>
</section>

{# demo: MP4, HLS and Plyr players #}
{% set groups = [
    {
        title: 'MP4',
        src: video,
        players: [
            { label: 'Standard', options: '', ratio: 'aspect-video' },
            { label: 'Autoplay', options: ',autoplay', ratio: 'aspect-video' },
            { label: 'Stretched, square', options: ',autoplay,stretch', ratio: 'aspect-square' },
            { label: 'Stretched, vertical', options: ',autoplay,stretch', ratio: 'aspect-9/16' }
        ]
    },
    {
        title: 'HLS (.m3u8)',
        src: videoHls,
        players: [
            { label: 'Standard', options: '', ratio: 'aspect-video' },
            { label: 'Autoplay', options: ',autoplay', ratio: 'aspect-video' }
        ]
    },
    {
        title: 'With Plyr',
        description: 'Plyr controls instead of the browser\'s, the same look in every browser. Plyr only loads on pages that use it.',
        src: video,
        srcLabel: video + ' · ' + videoHls,
        players: [
            { label: 'MP4, with a poster', options: ',plyr', ratio: 'aspect-video', poster: '/assets/img/sample-image.webp' },
            { label: 'HLS', src: videoHls, options: ',plyr', ratio: 'aspect-video' }
        ]
    }
] %}
{% for group in groups %}
<section class="px-4 py-16 {{ 'pt-0' if not loop.first }}">
    <div class="mx-auto max-w-295">
        <h2 class="mb-2 text-3xl font-bold tracking-tight">{{ group.title }}</h2>
        {% if group.description %}<p class="mb-2 max-w-2xl text-gray-600">{{ group.description }}</p>{% endif %}
        <p class="mb-8 font-mono text-sm text-gray-500">{{ group.srcLabel or group.src }}</p>
        <div class="grid gap-10 md:grid-cols-2">
            {% for player in group.players %}
            <div class="flex flex-col gap-3">
                <p class="font-semibold">{{ player.label }} <code class="ml-2 font-mono text-xs font-normal text-gray-500">src{{ player.options }}</code></p>
                <div class="relative {{ player.ratio }} bg-black" data-video-player="{{ player.src or group.src }}{{ player.options }}"{% if player.poster %} data-poster="{{ player.poster }}"{% endif %}>
                    {% if 'autoplay' in player.options %}<div class="absolute inset-0 z-10"></div>{% endif %}
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>
{% endfor %}

{# demo: a Plyr video in a lightbox, made on open and destroyed on close #}
<section class="px-4 pb-16">
    <div class="mx-auto max-w-295">
        <h2 class="mb-2 text-3xl font-bold tracking-tight">In a lightbox</h2>
        <p class="mb-8 max-w-2xl text-gray-600">The player is made when the lightbox opens and destroyed when it closes, so nothing keeps loading in the background.</p>
        <a class="js-video-lightbox inline-flex rounded-full bg-gray-950 px-6 py-3 font-medium text-white transition-colors hover:bg-gray-700" href="#video-lightbox" data-src="{{ video }}">Play in a lightbox</a>
        <div class="hidden">
            <div id="video-lightbox" class="relative mx-auto aspect-video w-full max-w-5xl overflow-hidden rounded-2xl bg-black"></div>
        </div>
    </div>
</section>

{% set markup %}{% raw %}
<!-- data-video-player="src,autoplay,stretch,plyr", any options in any order -->
<div class="relative aspect-video bg-black" data-video-player="/assets/video/name/name.m3u8"></div>

<!-- with Plyr controls and a poster -->
<div class="relative aspect-video bg-black" data-video-player="/assets/video/name.mp4,plyr" data-poster="/assets/img/name.webp"></div>

<!-- a muted loop that covers its box -->
<div class="relative aspect-square bg-black" data-video-player="/assets/video/name.mp4,autoplay,stretch"></div>
{% endraw %}{% endset %}

{% set pageScript %}{% raw %}
// Requirements
    // JS
        // hls.js (optional, for .m3u8 videos)
        // src/assets/js/utils/_event.js
        // src/assets/js/utils/_emitter.js
        // src/assets/js/utils/_media.js
        // src/assets/js/utils/_videoPlayer.js
        // plyr + src/assets/js/utils/_plyr.js (optional, for Plyr controls)
        // src/assets/js/utils/_lightbox.js (only for the lightbox sample)
    // CSS
        // @import "plyr/dist/plyr.css"; (with Plyr)

document.querySelectorAll('[data-video-player]').forEach((target) => {
    const [_src, ..._options] = target.dataset.videoPlayer.split(',');
    if (!_src) return;

    const _player = new _videoPlayer({
        target,
        src: _src,
        poster: target.dataset.poster,
        autoplay: _options.includes('autoplay'),
        stretch: _options.includes('stretch'),
        events: {
            // fade autoplay videos in when they start
            beforeInit: (instance) => {
                if (!instance.autoplay) return;

                instance.el.video.style.transition = 'opacity 0.8s';
                instance.el.video.style.opacity = 0;
            },
            // Plyr controls instead of the browser's
            afterInit: (instance) => {
                if (_options.includes('plyr')) _plyr(instance);
            },
        },
    });

    _player.on('play', (instance) => (instance.el.video.style.opacity = ''));
});

// a Plyr video in a lightbox
document.querySelectorAll('.js-video-lightbox').forEach((trigger) => {
    let _player = null;

    trigger.addEventListener('click', (e) => {
        e.preventDefault();

        new _lightbox({
            target: trigger.getAttribute('href'),
            events: {
                afterShow: async (lightbox) => {
                    _player = new _videoPlayer({ target: lightbox.content.original, src: trigger.dataset.src });
                    await _plyr(_player);
                    _player.play();
                },
                afterClose: () => _player?.destroy(),
            },
        });
    });
});
{% endraw %}{% endset %}

{{ scriptUsage({
    markup: markup,
    markupNote: 'The video fills its box, so give the box a size, e.g. <code class="font-mono text-sm">aspect-video</code>.',
    code: pageScript,
    note: 'hls.js loads only for <code class="font-mono text-sm">.m3u8</code> videos where the browser has Media Source Extensions, others (e.g. iOS Safari) play them natively. Events: <code class="font-mono text-sm">beforeInit</code>, <code class="font-mono text-sm">afterInit</code>, <code class="font-mono text-sm">loadstart</code>, <code class="font-mono text-sm">loading</code>, <code class="font-mono text-sm">canplay</code>, <code class="font-mono text-sm">playing</code>, <code class="font-mono text-sm">play</code>, <code class="font-mono text-sm">pause</code>, <code class="font-mono text-sm">ended</code>, <code class="font-mono text-sm">destroy</code>. The box gets state classes to style with: <code class="font-mono text-sm">video-loading</code>, <code class="font-mono text-sm">video-canplay</code>, <code class="font-mono text-sm">video-playing</code>, <code class="font-mono text-sm">video-paused</code>, <code class="font-mono text-sm">video-ended</code>, <code class="font-mono text-sm">sound-on</code>/<code class="font-mono text-sm">sound-off</code>. Playing a video with sound pauses the others, muted background videos keep playing. <code class="font-mono text-sm">play()</code>, <code class="font-mono text-sm">pause()</code>, <code class="font-mono text-sm">destroy()</code> (Plyr and hls.js included).'
}) }}

{% footerscript %}
<script type="module">{{ pageScript | safe }}</script>
{% endfooterscript %}
