{% set pageCss %}{% raw %}/* style.css */
@import "./components/fluid.css";

/* fluid.css (short) */
@utility fluid {
    container-type: inline-size;
    --fluid-rem: calc(100cqw * 16 / var(--fluid-design, 1440));
    --spacing: calc(0.25 * var(--fluid-rem));
    --text-base: max(0.875rem, var(--fluid-rem));
    --text-5xl: calc(3 * var(--fluid-rem));
    /* ...the rest of --text-*, --radius-*, --container-* */
}{% endraw %}{% endset %}

{{ scriptUsage({
    markup: pageMarkup,
    markupNote: 'Add <code class="font-mono text-sm">fluid</code> to a section or box. Spacing, text, radius and max-w sizes inside it scale. Inside a nested <code class="font-mono text-sm">@container</code>, they follow that one.',
    css: pageCss,
    cssNote: 'No script. Copy <code class="font-mono text-sm">src/assets/css/components/fluid.css</code>, Tailwind v4. It also has <code class="font-mono text-sm">container-1</code>, the 1180px page column.'
}) }}

{% footerscript %}
<script type="module">
    // demo readouts only, fluid needs no script
    const _probes = document.querySelectorAll('.js-rem-probe');
    const _showRem = () => _probes.forEach((probe) => {
        const _value = probe.parentElement.querySelector('.js-rem-value');
        _value.textContent = `${probe.getBoundingClientRect().width.toFixed(1)}px`;
    });
    _showRem();
    _event.resize(_showRem);

    const _box = document.querySelector('.js-box');
    const _range = document.querySelector('.js-box-range');
    _range.addEventListener('input', () => {
        _box.style.width = `${_range.value}%`;
        document.querySelector('.js-box-value').textContent = `${_range.value}%`;
        _showRem();
    });

    const _form = document.querySelector('.js-cqw');
    _form.addEventListener('submit', (e) => e.preventDefault());
    _form.addEventListener('input', () => {
        const _cqw = (_form.px.valueAsNumber / _form.design.valueAsNumber) * 100;
        _form.result.value = Number.isFinite(_cqw) ? `${+_cqw.toFixed(2)}cqw` : '-';
    });
</script>
{% endfooterscript %}
