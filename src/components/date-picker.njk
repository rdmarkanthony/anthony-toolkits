    css: '@import "flatpickr/dist/flatpickr.min.css";\n@import "./components/date-picker.css";\n\n/* your colors, project-wide */\n@layer components {\n    .flatpickr-calendar {\n        --date-picker-accent: var(--color-indigo-600);\n        --date-picker-range: var(--color-indigo-50);\n    }\n}',
    cssNote: 'date-picker.css is our look on top of flatpickr. Change the colors with its vars, for all calendars or one with the <code class="font-mono text-sm">class</code> option.'
}) }}

