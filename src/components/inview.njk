{% set pill = 'rounded-full border border-gray-300 px-3 py-1 font-mono text-sm text-gray-500 transition-colors data-visible:border-gray-950 data-visible:bg-gray-950 data-visible:text-white' %}
{% set card = 'flex flex-col justify-center gap-2 rounded-2xl border border-gray-200 p-6 transition-colors duration-500 data-visible:border-gray-950 data-visible:bg-gray-950 data-visible:text-white md:p-10' %}

{# demo: the pills stay on screen and follow the cards below #}
<section class="px-4 py-16">
    <div class="mx-auto max-w-295">
        <div class="sticky top-(--header-height) z-10 -mx-4 flex flex-wrap gap-2 bg-white/90 px-4 py-4 backdrop-blur">
            <span class="js-inview-status {{ pill }}" data-for="inview-once">once: out of view</span>
            <span class="js-inview-status {{ pill }}" data-for="inview-toggle">toggle: out of view</span>
            <span class="js-inview-status {{ pill }}" data-for="inview-half">half: out of view</span>
        </div>
        <p class="mt-4 max-w-2xl text-gray-600">Scroll down and back up. Each pill shows what its card's callback last reported.</p>
        <div class="flex flex-col gap-[50vh] py-[50vh]">
            <div id="inview-once" class="js-inview-card {{ card }} min-h-64">
                <p class="font-mono text-sm opacity-60">default</p>
                <p class="text-3xl font-bold tracking-tight">Once</p>
                <p class="opacity-70">Calls back the first time it's in view, then stops watching. It stays marked when you scroll away.</p>
            </div>
            <div id="inview-toggle" class="js-inview-card {{ card }} min-h-64">
                <p class="font-mono text-sm opacity-60">observeOnce: false</p>
                <p class="text-3xl font-bold tracking-tight">Toggle</p>
                <p class="opacity-70">Calls back each time it enters and leaves the screen.</p>
            </div>
            <div id="inview-half" class="js-inview-card {{ card }} min-h-[70vh]">
                <p class="font-mono text-sm opacity-60">observeOnce: false, observeRatio: 0.5</p>
                <p class="text-3xl font-bold tracking-tight">Half</p>
                <p class="opacity-70">Only counts as in view once half of it shows.</p>
            </div>
        </div>
    </div>
</section>

{% set pageScript %}{% raw %}
// Requirements
    // JS
        // src/assets/js/utils/_inview.js

// marks the card and its pill, instance.visible is true when in view
const _mark = (instance) => {
    const _card = instance.target;
    const _status = document.querySelector(`.js-inview-status[data-for="${_card.id}"]`);
    const _name = _status.textContent.split(':')[0];

    _card.toggleAttribute('data-visible', instance.visible);
    _status.toggleAttribute('data-visible', instance.visible);
    _status.textContent = `${_name}: ${instance.visible ? 'in view' : 'out of view'}`;
};

const _cards = document.querySelectorAll('.js-inview-card');

// once (default): the first time it's in view, then it stops watching
new _inview({ target: _cards[0], callback: _mark });

// every time it enters and leaves
new _inview({ target: _cards[1], observeOnce: false, callback: _mark });

// only when half of it shows
new _inview({ target: _cards[2], observeOnce: false, observeRatio: 0.5, callback: _mark });
{% endraw %}{% endset %}

