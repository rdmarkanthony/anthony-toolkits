{# demo: many values packed in one var #}
<section class="bg-gray-50 px-4 py-16">
    <div class="js-url-loans mx-auto flex max-w-295 flex-col gap-8">
        <div>
            <h2 class="mb-2 text-3xl font-bold tracking-tight">Packed values</h2>
            <p class="max-w-xl text-gray-600">All rows in one var: <code class="font-mono text-sm">_</code> between the fields, <code class="font-mono text-sm">,</code> between the rows, e.g. <code class="font-mono text-sm">?c=10000_1.5_6</code>.</p>
