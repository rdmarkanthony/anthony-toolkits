{% set pageScript %}{% raw %}
// Requirements
    // JS
        // src/assets/js/utils/_urlVars.js

const _urlNow = document.querySelector('.js-url-now');
const _showUrl = () => (_urlNow.textContent = location.pathname + location.search);

// filters: read on load, write on change
const _shop = document.querySelector('.js-url-shop');
const _q = _shop.querySelector('.js-url-q');
const _sort = _shop.querySelector('.js-url-sort');
const _sale = _shop.querySelector('.js-url-sale');
const _list = _shop.querySelector('.js-url-list');

const _products = [
    { name: 'Canvas bag', price: 45, sale: true },
    { name: 'Desk lamp', price: 89, sale: false },
    { name: 'Notebook', price: 12, sale: true },
    { name: 'Water bottle', price: 25, sale: false },
    { name: 'Wool scarf', price: 60, sale: true },
    { name: 'Wall clock', price: 38, sale: false },
];

const _vars = _urlVars.get();
_q.value = _vars.q ?? '';
_sort.value = _vars.sort ?? '';
_sale.checked = _vars.sale === '1';

const _renderShop = () => {
    const _items = _products
        .filter((item) => item.name.toLowerCase().includes(_q.value.trim().toLowerCase()) && (!_sale.checked || item.sale))
        .sort((a, b) => (_sort.value === 'low' ? a.price - b.price : _sort.value === 'high' ? b.price - a.price : a.name.localeCompare(b.name)));

    _list.innerHTML = _items.map((item) => `<li class="flex justify-between rounded-md border border-gray-200 px-4 py-3"><span>${item.name}</span><span class="tabular-nums text-gray-600">$${item.price}${item.sale ? ' · sale' : ''}</span></li>`).join('') || '<li class="text-gray-600">Nothing matches.</li>';
};

const _saveShop = () => {
    _urlVars.set({ q: _q.value.trim(), sort: _sort.value, sale: _sale.checked ? '1' : null });
    _renderShop();
    _showUrl();
};

_shop.addEventListener('input', _saveShop);
_renderShop();

// packed values: amount_rate_terms per row, rows split by ","
const _loans = document.querySelector('.js-url-loans');
const _rows = _loans.querySelector('.js-url-rows');

const _unpack = (value) => (value ? value.split(',').map((row) => row.split('_').map(Number)) : [[10000, 1.5, 6]]);
const _pack = (rows) => rows.map((row) => row.join('_')).join(',');

let _loanRows = _unpack(_urlVars.get('c'));

// monthly payment, rate is % per month
const _monthly = ([amount, rate, terms]) => {
    if (!terms) return 0;
    if (!rate) return amount / terms;
    const _r = rate / 100;
    return (amount * _r) / (1 - (1 + _r) ** -terms);
};

const _renderLoans = () => {
    const _input = (index, field, value, label) => `<label class="flex flex-col gap-1 text-sm text-gray-600">${label}<input class="h-11 w-full rounded-md border border-gray-300 bg-white px-3 text-base text-gray-950 tabular-nums focus:border-gray-950 focus:outline-none" type="number" min="0" step="any" value="${value}" data-row="${index}" data-field="${field}" /></label>`;

    _rows.innerHTML = _loanRows.map((row, i) => `
        <div class="grid items-end gap-3 rounded-2xl border border-gray-200 bg-white p-4 sm:grid-cols-[1fr_1fr_1fr_8rem_auto]">
            ${_input(i, 0, row[0], 'Amount')}
            ${_input(i, 1, row[1], 'Rate % / month')}
            ${_input(i, 2, row[2], 'Months')}
            <p class="text-sm text-gray-600">Monthly<br /><span class="js-url-monthly text-lg font-semibold text-gray-950 tabular-nums">${_monthly(row).toFixed(2)}</span></p>
            <button class="h-11 rounded-md px-3 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-950 disabled:invisible" type="button" data-remove="${i}" ${_loanRows.length === 1 ? 'disabled' : ''}>Remove</button>
        </div>`).join('');
};

const _saveLoans = () => {
    _urlVars.set({ c: _pack(_loanRows) });
    _showUrl();
};

_rows.addEventListener('input', (e) => {
    const _field = e.target.closest('[data-field]');
    if (!_field) return;

    const _row = _loanRows[_field.dataset.row];
    _row[_field.dataset.field] = Number(_field.value) || 0;
    _field.closest('.grid').querySelector('.js-url-monthly').textContent = _monthly(_row).toFixed(2);
    _saveLoans();
});

_rows.addEventListener('click', (e) => {
    const _remove = e.target.closest('[data-remove]');
    if (!_remove) return;

    _loanRows.splice(_remove.dataset.remove, 1);
    _renderLoans();
    _saveLoans();
});

_loans.querySelector('.js-url-add').addEventListener('click', () => {
    _loanRows.push([10000, 1.5, 6]);
    _renderLoans();
    _saveLoans();
});

_renderLoans();
_showUrl();
{% endraw %}{% endset %}

