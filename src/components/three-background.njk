{% set pageScript %}{% raw %}
// Requirements
    // JS
        // src/assets/js/utils/_emitter.js
        // src/assets/js/utils/_event.js
        // src/assets/js/utils/_inview.js
        // src/assets/js/utils/_threeBackground.js
        // src/assets/js/utils/_threeParticles.js, the effect
    // Packages
        // three

new _threeBackground({
    target: document.querySelector('.js-three-dark'),
    // defaults: count: 1500, color: '#ffffff', size: 3, speed: 0.15, depth: 4, radius: 2, push: 1.2, parallax: 0.15, opacity: 1
    effect: _threeParticles({ color: ['#ffffff', '#34d399'], count: 2000 }),
});

// methods and events
const _log = document.querySelector('.js-three-log');
const _light = new _threeBackground({
    target: document.querySelector('.js-three-light'),
    effect: _threeParticles({ color: ['#38bdf8', '#fbbf24', '#fb7185'], count: 300, size: 10, speed: 0.3, parallax: 0 }),
    events: {
        ready: () => (_log.textContent = 'ready'),
        play: () => (_log.textContent = 'play'),
        pause: (instance) => (_log.textContent = `pause, at ${instance.time.toFixed(1)}s`),
    },
});
window._light = _light; // for trying it in the console

document.querySelector('.js-three-pause').addEventListener('click', () => _light.pause());
document.querySelector('.js-three-play').addEventListener('click', () => _light.play());
{% endraw %}{% endset %}

{% set effectCode %}{% raw %}
// your own effect, each gets the instance
// instance: three, scene, camera, renderer, pointer (-1 to 1), view (world size), size (px), time, delta, progress (scroll 0 to 1)
const _spinningBox = () => {
    let _box = null;

    return {
        setup({ three: THREE, scene }) {
            _box = new THREE.Mesh(new THREE.BoxGeometry(2, 2, 2), new THREE.MeshNormalMaterial());
            scene.add(_box);
        },
        update({ delta }) {
            _box.rotation.y += delta;
        },
        // optional: resize(instance), destroy(instance)
    };
};

new _threeBackground({ target, effect: _spinningBox() });
{% endraw %}{% endset %}

