document.querySelectorAll('.js-dropdown').forEach((target) => {
    new _dropdown({
        target,
        // hover: true,
        // delay: 100,
        // closeDelay: 300,
        events: {
            // open: (dropdown) => console.log('open'),
            // change: (dropdown) => console.log(dropdown.active),
            // close: (dropdown) => console.log('close'),
        },
    });
});
{% endraw %}{% endset %}

{{ scriptUsage({
    markup: markup,
    markupNote: 'The open item and panel get <code class="font-mono text-sm">data-open</code>, closed panels are <code class="font-mono text-sm">inert</code>. Keep <code class="font-mono text-sm">visibility</code> in the transition so it hides after the animation.',
    code: pageScript,
    note: '<code class="font-mono text-sm">new _dropdown({ target, hover, delay, closeDelay, events })</code>. <code class="font-mono text-sm">hover: false</code> opens on click only. Methods: <code class="font-mono text-sm">open(index)</code>, <code class="font-mono text-sm">close()</code>, <code class="font-mono text-sm">toggle(index)</code>, <code class="font-mono text-sm">destroy()</code>. Events: <code class="font-mono text-sm">open</code>, <code class="font-mono text-sm">change</code>, <code class="font-mono text-sm">close</code>, <code class="font-mono text-sm">dropdown.active</code> is the open index, -1 when closed. In a mobile menu, use <code class="font-mono text-sm">_accordion</code>.',
    more: [
        { title: 'Other animations', note: 'Swap the panel classes, the rest stays.', code: looksCode, lang: 'html' },
        { title: 'One background', note: 'The nav gets <code class="font-mono text-sm">--dropdown-width</code>, <code class="font-mono text-sm">-height</code>, <code class="font-mono text-sm">-x</code>, <code class="font-mono text-sm">-y</code> of the open panel, <code class="font-mono text-sm">data-open</code>, and <code class="font-mono text-sm">data-switch</code> while moving between items. While one is open, the other panels get <code class="font-mono text-sm">data-side="before"</code> or <code class="font-mono text-sm">"after"</code>.', code: morphCode, lang: 'html' }
    ]
}) }}

{% footerscript %}
<script type="module">{{ pageScript | safe }}</script>
{% endfooterscript %}
