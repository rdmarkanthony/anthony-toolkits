{% set videoScript %}{% raw %}
// Requirements
    // JS
        // src/assets/js/utils/_event.js
        // src/assets/js/utils/_emitter.js
        // src/assets/js/utils/_lightbox.js
        // src/assets/js/utils/_media.js
        // src/assets/js/utils/_videoPlayer.js + plyr + src/assets/js/utils/_plyr.js, for mp4
        // src/assets/js/utils/_youtubePlayer.js, for youtube
    // CSS
        // @import "plyr/dist/plyr.css";

// the play icon always moves forward: the shown one slides out right, the other comes in from the left
const _move = { duration: 500, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'both' };
const _slide = (icon, into) => {
    // from where it is now, mid-move too
    const { translate, opacity } = getComputedStyle(icon);
    const _shown = parseFloat(opacity) > 0.05;
    icon.getAnimations().forEach((animation) => animation.cancel());

    if (into) icon.animate([_shown ? { translate, opacity } : { translate: '-5rem 0', opacity: 0 }, { translate: '0 0', opacity: 1 }], { ..._move, delay: 100 });
    else icon.animate([{ translate, opacity }, { translate: '5rem 0', opacity: 0 }], _move);
};

// the 11 character id from a youtube link
const _youtubeId = (url) => url.match(/(?:youtu\.be\/|[?&]v=|shorts\/|embed\/)([\w-]{11})/)?.[1];

document.querySelectorAll('[data-lightbox-video]').forEach((trigger) => {
    const _rest = trigger.querySelector('[data-play-icon="rest"]');
    const _hover = trigger.querySelector('[data-play-icon="hover"]');
    if (_rest && _hover && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const _swap = (on) => {
            _slide(on ? _rest : _hover, false);
            _slide(on ? _hover : _rest, true);
        };
        trigger.addEventListener('pointerenter', () => _swap(true));
        trigger.addEventListener('pointerleave', () => _swap(false));
        trigger.addEventListener('focusin', () => _swap(true));
        trigger.addEventListener('focusout', () => _swap(false));
    }

    trigger.addEventListener('click', (e) => {
        e.preventDefault();

        const _href = trigger.getAttribute('href');
        const _id = _youtubeId(_href);
        // as big as the screen allows, at 16:9
        const _box = document.createElement('div');
        _box.className = 'relative mx-auto aspect-video w-[min(100%,calc((100dvh-5rem)*16/9))] overflow-hidden rounded-2xl bg-black xl:w-[min(100%,calc((100dvh-6.5rem)*16/9))]';
        let _player = null;

        new _lightbox({
            target: _box,
            events: {
                afterShow: async () => {
                    if (_id) {
                        // youtube's own player
                        _player = new _youtubePlayer({ target: _box, id: _id, events: { onReady: (player) => player.play() } });
                    } else {
                        _player = new _videoPlayer({ target: _box, src: _href });
                        await _plyr(_player);
                        _player.play();
                    }
                },
                afterClose: () => _player?.destroy(),
            },
        });
    });
});
{% endraw %}{% endset %}

