{# demo: image links grouped by data-lightbox-gallery #}
<section id="image-gallery" class="scroll-mt-20 border-t border-gray-200 px-4 py-16">
    <div class="mx-auto max-w-295">
        <h2 class="mb-2 text-3xl font-bold tracking-tight">Image gallery</h2>
        <p class="mb-10 max-w-2xl text-gray-600">Each link's href is the image. Links with the same <code class="font-mono text-sm">data-lightbox-gallery</code> open as one gallery, from the one clicked. Swipe, drag, use the arrows or arrow keys, or pick a thumbnail.</p>
        <div class="grid gap-12 lg:grid-cols-2">
            <div>
                <h3 class="mb-4 text-xl font-semibold">Photos</h3>
                <div class="grid grid-cols-3 gap-2">
                    {% for photo in photos %}
                    <a class="group block aspect-square overflow-hidden rounded-xl bg-gray-950" href="/assets/img/gallery/photo-{{ loop.index }}.webp" data-lightbox-gallery="photos" data-caption="{{ photo.alt }}">
                        <img class="size-full object-cover transition-transform duration-500 group-hover:scale-105" src="/assets/img/gallery/photo-{{ loop.index }}-thumb.webp" alt="{{ photo.alt }}" loading="lazy" />
                    </a>
                    {% endfor %}
                </div>
            </div>
            <div>
                <h3 class="mb-4 text-xl font-semibold">Product</h3>
                <div class="grid grid-cols-3 gap-2">
                    {% for frame in product %}
                    <a class="group block overflow-hidden rounded-xl bg-gray-100 {{ 'col-span-3 aspect-4/3' if loop.first else 'aspect-square' }}" href="/assets/img/headphone/large_{{ frame }}.jpg" data-lightbox-gallery="product" data-thumb="/assets/img/headphone/small_{{ frame }}.webp">
                        <img class="size-full object-cover transition-transform duration-500 group-hover:scale-105" src="/assets/img/headphone/small_{{ frame }}.webp" alt="Headphones, view {{ loop.index }}" loading="lazy" />
                    </a>
                    {% endfor %}
                </div>
            </div>
        </div>
        <div class="mt-10 flex flex-col gap-3 md:flex-row">
            <a class="{{ button }}" href="/assets/img/sample-image.webp" data-lightbox-gallery>One image, no group</a>
            <button class="js-gallery-script {{ button }} cursor-pointer" type="button">Open from a script</button>
        </div>
    </div>
</section>

{% set markup %}{% raw %}
<a href="#my-lightbox" data-lightbox>Open</a>
<!-- data-lightbox="modal" opens on top of the current lightbox -->
<a href="#my-modal" data-lightbox="modal">Open a modal</a>
<!-- data-lightbox="inside" puts the close button on the content's corner, e.g. "modal,inside" -->
<a href="#my-lightbox" data-lightbox="inside">Open</a>

<div class="hidden">
    <div id="my-lightbox" class="mx-auto max-w-3xl rounded-2xl bg-white p-12">...</div>
</div>
{% endraw %}{% endset %}

{% set pageScript %}{% raw %}
// Requirements
    // JS
        // src/assets/js/utils/_event.js
        // src/assets/js/utils/_emitter.js
        // src/assets/js/utils/_lightbox.js

const _openLightbox = (trigger) => {
    const _href = trigger.getAttribute('href');
    const _options = trigger.dataset.lightbox.split(',');

    new _lightbox({
        target: _href && _href !== '#' ? document.querySelector(_href) : null,
        modal: _options.includes('modal'),
        close: _options.includes('inside') ? 'inside' : 'page', // page or inside
        animation: 'zoom', // zoom, fade, fadeUp or none
        events: {
            beforeShow: (lightbox) => {},
            afterShow: (lightbox) => {},
            beforeClose: (lightbox) => {},
            afterClose: (lightbox) => {},
        },
    });
};

document.querySelectorAll('[data-lightbox]').forEach((item) => {
    if (item.getAttribute('target') === '_blank') return;

    item.addEventListener('click', (e) => {
        e.preventDefault();
        _openLightbox(item);
    });
});

// open on load from the url hash, e.g. /page/#my-lightbox
if (location.hash.length > 1) {
    const _trigger = [...document.querySelectorAll('[data-lightbox]')].find((item) => item.getAttribute('href') === location.hash);
    if (_trigger) _openLightbox(_trigger);
}
{% endraw %}{% endset %}

{% set galleryMarkup %}{% raw %}
<!-- href is the image, the same data-lightbox-gallery value makes one gallery -->
<a href="/img/photo-1.jpg" data-lightbox-gallery="photos" data-caption="Shown under the image">
    <img src="/img/photo-1-small.jpg" alt="..." />
</a>
<!-- data-thumb sets the thumbnail, else the link's img -->
<a href="/img/photo-2.jpg" data-lightbox-gallery="photos" data-thumb="/img/photo-2-thumb.jpg">...</a>
<!-- no value: opens on its own -->
<a href="/img/poster.jpg" data-lightbox-gallery>Open</a>
{% endraw %}{% endset %}

