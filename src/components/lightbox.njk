{% set markup %}{% raw %}
<a href="#my-lightbox" data-lightbox>Open</a>
<!-- data-lightbox="modal" opens on top of the current lightbox -->
<a href="#my-modal" data-lightbox="modal">Open a modal</a>

<div class="hidden">
    <div id="my-lightbox" class="mx-auto max-w-3xl rounded-2xl bg-white p-12">...</div>
</div>
{% endraw %}{% endset %}

{% set pageScript %}{% raw %}
// Requirements
    // JS
        // src/assets/js/utils/_event.js
        // src/assets/js/utils/_emitter.js
        // src/assets/js/utils/_lightbox.js

const _openLightbox = (trigger) => {
    const _href = trigger.getAttribute('href');

    new _lightbox({
        target: _href && _href !== '#' ? document.querySelector(_href) : null,
        modal: trigger.dataset.lightbox.split(',')[0] === 'modal',
        animation: 'zoom', // zoom, fade, fadeUp or none
        events: {
            beforeShow: (lightbox) => {},
            afterShow: (lightbox) => {},
            beforeClose: (lightbox) => {},
            afterClose: (lightbox) => {},
        },
    });
};

document.querySelectorAll('[data-lightbox]').forEach((item) => {
    if (item.getAttribute('target') === '_blank') return;

    item.addEventListener('click', (e) => {
        e.preventDefault();
        _openLightbox(item);
    });
});

// open on load from the url hash, e.g. /page/#my-lightbox
if (location.hash.length > 1) {
    const _trigger = [...document.querySelectorAll('[data-lightbox]')].find((item) => item.getAttribute('href') === location.hash);
    if (_trigger) _openLightbox(_trigger);
}
{% endraw %}{% endset %}

{{ scriptUsage({
    markup: markup,
    markupNote: 'The content is moved into the lightbox while it\'s open, and back to its place on close. Visiting the page with a lightbox\'s hash in the url (e.g. <code class="font-mono text-sm">/page/#my-lightbox</code>) opens it on load.',
    code: pageScript,
    note: '<code class="font-mono text-sm">lightbox.hide()</code> closes it with the animation, <code class="font-mono text-sm">lightbox.destroy()</code> removes it at once. Every lightbox fires <code class="font-mono text-sm">lightboxReady</code> on <code class="font-mono text-sm">window</code> when it opens, with the lightbox as <code class="font-mono text-sm">e.detail</code>, for scripts that didn\'t open it.'
}) }}

