{% endraw %}{% endset %}

{% set pageCss %}{% raw %}/* style.css */
@import "./components/text-reveal.css";

/* text-reveal.css */
.text-reveal-gradient {
    --text-reveal-from: #f43f5e;
    --text-reveal-to: #7c3aed;
    --text-reveal-dim: #e5e5e5;
    background-image: linear-gradient(120deg, var(--text-reveal-from), var(--text-reveal-to));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
}
{% endraw %}{% endset %}

{% set pageScript %}{% raw %}
// Requirements
    // JS
        // src/assets/js/utils/_event.js
        // src/assets/js/utils/_emitter.js
        // src/assets/js/utils/_parallax.js
    // CSS, gradient only
        // src/assets/css/components/text-reveal.css

document.querySelectorAll('.js-text-reveal').forEach((target) => {
    new _parallaxScroller({
        target,
        events: {
            init(scroller) {
                // wrap each word in a span
                target.innerHTML = target.textContent.replace(/\S+/g, '<span>$&</span>');
                const _words = [...target.children];
                const _total = 1 + (_words.length - 1) * 0.1;

                // gradient text fades the word's color to clear, the rest fade their opacity
                const _keyframes = target.matches('.text-reveal-gradient') ? { color: ['var(--text-reveal-dim)', 'transparent'] } : { opacity: [0.15, 1] };

                // each word fades over 1, the next starts 0.1 later
                _words.forEach((word, index) => {
                    const _start = index * 0.1;
                    scroller.animate(word, _keyframes, [`${(_start / _total) * 100}%`, `${((_start + 1) / _total) * 100}%`]);
                });
            },
            // top at mid screen to bottom at mid screen
            resize(scroller) {
                scroller.offset.top += _parallax.height() * 0.5;
                scroller.offset.bottom -= _parallax.height() * 0.5;
            },
        },
    });
});
{% endraw %}{% endset %}

