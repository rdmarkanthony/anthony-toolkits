{% set markup %}{% raw %}
<!-- plain text, the script wraps each word in a span -->
<p class="js-text-reveal text-5xl">Good motion follows the reader...</p>
{% endraw %}{% endset %}

{% set pageScript %}{% raw %}
// Requirements
    // JS
        // src/assets/js/utils/_event.js
        // src/assets/js/utils/_emitter.js
        // src/assets/js/utils/_parallax.js

document.querySelectorAll('.js-text-reveal').forEach((target) => {
    new _parallaxScroller({
        target,
        events: {
            init(scroller) {
                // wrap each word in a span
                target.innerHTML = target.textContent.replace(/\S+/g, '<span>$&</span>');
                const _words = [...target.children];
                const _total = 1 + (_words.length - 1) * 0.1;

                // each word fades over 1, the next starts 0.1 later
                _words.forEach((word, index) => {
                    const _start = index * 0.1;
                    scroller.animate(word, { opacity: [0.15, 1] }, [`${(_start / _total) * 100}%`, `${((_start + 1) / _total) * 100}%`]);
                });
            },
            // top at mid screen to bottom at mid screen
            resize(scroller) {
                scroller.offset.top += _parallax.height() * 0.5;
                scroller.offset.bottom -= _parallax.height() * 0.5;
            },
        },
    });
});
{% endraw %}{% endset %}

{{ scriptUsage({
    markup: markup,
    markupNote: 'Plain text with a <code class="font-mono text-sm">js-</code> class. Inner tags like <code class="font-mono text-sm">&lt;strong&gt;</code> are dropped when the words are wrapped.',
    code: pageScript,
    note: 'Just <code class="font-mono text-sm">_parallaxScroller</code>. <code class="font-mono text-sm">resize</code> sets the range from the text top to its bottom at the middle of the screen, and <code class="font-mono text-sm">animate()</code> fades each word over its own part of it, so it stays smooth on phones.'
}) }}

