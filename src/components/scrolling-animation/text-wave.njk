<!-- tall, the extra height is how long the text stays pinned -->
<section class="js-text-wave relative h-[300svh]">
    <div class="sticky top-(--header-height) flex h-[calc(100svh-var(--header-height,0px))] items-center">
        <!-- plain text, it ends in its own color, the variables set the start and the pop -->
        <p class="js-text-wave-text text-8xl text-stone-950 [--text-wave-dim:var(--color-stone-300)] [--text-wave-pop:var(--color-violet-600)]">We make small things with care...</p>
    </div>
</section>
{% endraw %}{% endset %}

{% set pageScript %}{% raw %}
// Requirements
    // JS
        // src/assets/js/utils/_event.js
        // src/assets/js/utils/_emitter.js
        // src/assets/js/utils/_parallax.js

// faux bold, a text-shadow outline in the letter's color, so the line doesn't move
const _bold = ['0.025em 0', '-0.025em 0', '0 0.025em', '0 -0.025em'].map((offset) => `${offset} currentColor`).join(', ');

document.querySelectorAll('.js-text-wave').forEach((target) => {
    new _parallaxScroller({
        target,
        events: {
            init(scroller) {
                // words stay whole, each letter in a span, screen readers get the text
                const _text = target.querySelector('.js-text-wave-text');
                const _letters = _text.textContent.trim().replace(/\S+/g, (word) => `<span class="inline-block">${word.replace(/\S/g, '<span class="inline-block">$&</span>')}</span>`);
                _text.innerHTML = `<span class="sr-only">${_text.textContent.trim()}</span><span aria-hidden="true">${_letters}</span>`;

                // each letter waves over 1, the next starts a step later, all in the first 85%
                // a bigger step pops fewer letters at once, 0.2 is about 5
                const _step = 0.2;
                const _list = [..._text.lastChild.querySelectorAll(':scope > span > span')];
                const _total = 1 + (_list.length - 1) * _step;

                _list.forEach((letter, index) => {
                    const _start = index * _step;

                    // dim, a bold tilted pop, then its own color
                    scroller.animate(
                        letter,
                        [
                            { color: 'var(--text-wave-dim)' },
                            { color: 'var(--text-wave-pop)', scale: 1.12, rotate: `${Math.random() * 8 - 4}deg`, textShadow: _bold, offset: 0.5 },
                            {},
                        ],
                        [`${(_start / _total) * 85}%`, `${((_start + 1) / _total) * 85}%`]
                    );
                });
            },
            // while the text is pinned, --header-height from script.js
            resize(scroller) {
                const _header = parseFloat(getComputedStyle(document.body).getPropertyValue('--header-height')) || 0;
                scroller.offset.top = _parallax.getOffset(target).top - _header;
                scroller.offset.bottom = _parallax.getOffset(target).bottom - _parallax.height();
            },
        },
    });
});
{% endraw %}{% endset %}

