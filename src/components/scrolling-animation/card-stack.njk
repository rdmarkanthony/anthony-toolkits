{% set cards = [
    { heading: 'Each card sticks', text: 'It stays below the header while the page scrolls.', tone: 'bg-lime-200', image: 'photo-1' },
    { heading: 'The next one covers it', text: 'It slides up over the card before it.', tone: 'bg-teal-800 text-white', image: 'photo-2' },
    { heading: 'Covered cards shrink', text: 'They shrink back and dim, a strip of each stays in view.', tone: 'bg-rose-200', image: 'photo-3' },
