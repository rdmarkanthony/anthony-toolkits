{% set markup %}{% raw %}
<div class="js-wash relative isolate">
    <!-- sticky behind the sections, the negative margin keeps it out of the flow -->
    <canvas class="js-wash-canvas sticky top-0 -z-10 -mb-[100lvh] block h-lvh w-full" aria-hidden="true"></canvas>

    <!-- each section's own bg is its color, so it still works without the script -->
    <section class="js-wash-section min-h-[105svh] bg-indigo-950 text-white">...</section>
    <section class="js-wash-section min-h-[105svh] bg-orange-50 text-stone-950">...</section>
    <section class="js-wash-section min-h-[105svh] bg-teal-900 text-white">...</section>
</div>
{% endraw %}{% endset %}

{% set pageScript %}{% raw %}
// Requirements
    // JS
        // src/assets/js/utils/_event.js
        // src/assets/js/utils/_emitter.js
        // src/assets/js/utils/_parallax.js

// edge: how soft the line is, wave: how much the noise bends it
// length: how far up the screen the section's top moves while its color comes in
const _edge = 0.4;
const _wave = 0.5;
const _length = 0.75;

// any css color as [r, g, b]
const _rgb = (color) => {
    const _context = document.createElement('canvas').getContext('2d', { willReadFrequently: true });
    _context.fillStyle = color;
    _context.fillRect(0, 0, 1, 1);
    return [..._context.getImageData(0, 0, 1, 1).data.slice(0, 3)];
};

// smooth value noise, 0 to 1
const _hash = (x, y) => {
    const _n = Math.sin(x * 127.1 + y * 311.7) * 43758.5453;
    return _n - Math.floor(_n);
};
const _noise = (x, y) => {
    const [_x, _y] = [Math.floor(x), Math.floor(y)];
    const [_u, _v] = [x - _x, y - _y].map((t) => t * t * (3 - 2 * t));
    const [_a, _b, _c, _d] = [_hash(_x, _y), _hash(_x + 1, _y), _hash(_x, _y + 1), _hash(_x + 1, _y + 1)];
    return _a + (_b - _a) * _u + (_c - _a) * _v + (_a - _b - _c + _d) * _u * _v;
};
const _smooth = (min, max, value) => {
    const _t = _parallax.clamp((value - min) / (max - min));
    return _t * _t * (3 - 2 * _t);
};

document.querySelectorAll('.js-wash').forEach((target) => {
    const _canvas = target.querySelector('.js-wash-canvas');
    const _context = _canvas.getContext('2d');
    const _sections = [...target.querySelectorAll('.js-wash-section')];

    let _colors = [];
    let _starts = [];
    let _field = [];
    let _image = null;
    let _key = '';

    // the "to" color rises from the bottom, progress 0 to 1
    const _draw = (from, to, progress) => {
        const _range = _wave * 0.5 + _edge;
        const _line = -_range + (1 + _range * 2) * progress;

        _field.forEach((noise, index) => {
            const _height = 1 - (Math.floor(index / _canvas.width) + 0.5) / _canvas.height;
            const _cover = 1 - _smooth(_line - _edge, _line + _edge, _height + (noise - 0.5) * _wave);

            for (let channel = 0; channel < 3; channel++) _image.data[index * 4 + channel] = from[channel] + (to[channel] - from[channel]) * _cover;
            _image.data[index * 4 + 3] = 255;
        });

        _context.putImageData(_image, 0, 0);
    };

    new _parallaxScroller({
        target,
        events: {
            init() {
                // the canvas paints the colors, the sections go clear
                _colors = _sections.map((section) => _rgb(getComputedStyle(section).backgroundColor));
                _sections.forEach((section) => (section.style.backgroundColor = 'transparent'));
            },
            resize() {
                // 32px high, the browser stretches it to the screen, that's the blur
                _canvas.height = 32;
                _canvas.width = Math.round((32 * _parallax.width()) / _parallax.height());
                _image = _context.createImageData(_canvas.width, _canvas.height);
                _field = Array.from({ length: _canvas.width * _canvas.height }, (_, index) => _noise(((index % _canvas.width) / 32) * 2.2, (Math.floor(index / _canvas.width) / 32) * 2.2));

                // a wash starts as the section's top enters the bottom of the screen
                _starts = _sections.map((section) => _parallax.getOffset(section).top - _parallax.height());
                _key = '';
            },
            update() {
                const _index = Math.max(_starts.findLastIndex((start, index) => index && _parallax.scrollTop() > start), 0);
                const _progress = _index ? _parallax.clamp(_parallax.getRange(_starts[_index], _starts[_index] + _parallax.height() * _length)) : 1;

                if (`${_index},${_progress}` === _key) return;
                _key = `${_index},${_progress}`;

                _draw(_colors[Math.max(_index - 1, 0)], _colors[_index], _progress);
            },
        },
    });
});
{% endraw %}{% endset %}

{{ scriptUsage({
    markup: markup,
    markupNote: 'A sticky canvas behind the sections. Each section keeps its own background class, the script reads it, so without the script the page still has its colors.',
    code: pageScript,
    note: 'Just <code class="font-mono text-sm">_parallaxScroller</code>, no three.js. The canvas is only 32px high, and the browser stretches it to the screen, which blurs the edge into a soft cloud. Each wash starts when a section\'s top enters the bottom of the screen and ends when it is a quarter of the way down, <code class="font-mono text-sm">_length</code>. <code class="font-mono text-sm">_edge</code> sets how soft it is, <code class="font-mono text-sm">_wave</code> how much it bends.'
}) }}

