<section class="js-stacking-columns relative">
    <div class="js-stacking-columns-pin md:sticky md:top-(--header-height) md:h-[calc(100svh-var(--header-height,0px))] md:overflow-hidden">
        <ul class="js-stacking-columns-track md:flex md:h-full">
            {% for column in columns %}
            <li class="group sticky top-(--header-height) flex h-[calc(100svh-var(--header-height,0px))] flex-col md:static md:h-auto md:shrink-0 md:flex-row {{ column.tone }}">
                <div class="js-stacking-columns-title group/title relative flex cursor-pointer h-12 flex-row-reverse items-center justify-end gap-3 border-t border-black/10 px-6 transition-colors duration-300 hover:bg-current/8 md:h-auto md:w-20 md:flex-col md:gap-4 md:border-t-0 md:border-l md:px-0 md:py-10">
                    <h2 class="text-lg font-semibold tracking-tight transition-transform duration-300 md:rotate-180 md:text-2xl md:[writing-mode:vertical-rl] md:group-hover/title:-translate-y-2"><button class="cursor-pointer after:absolute after:inset-0" type="button">{{ column.title }}</button></h2>
                    <span class="size-1.5 scale-0 rounded-full bg-orange-500 transition-transform duration-300 group-data-[state=active]:scale-100 md:size-2"></span>
                    <span class="text-xs font-medium opacity-60 transition duration-300 group-data-[state=active]:text-orange-500 group-data-[state=active]:opacity-100 md:text-sm">{{ loop.index | pad(2) }}</span>
