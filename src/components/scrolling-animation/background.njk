---
title: Background | Scrolling Animation | Anthony Toolkits
---

{% from "components/atoms/back-link.njk" import backLink %}
{% from "components/atoms/icon.njk" import angle %}
{% from "components/atoms/code-block.njk" import codeBlock %}

<section class="px-4 pt-24 pb-16 md:pt-32">
    <div class="mx-auto max-w-295">
        {{ backLink({ label: 'Scrolling animation', url: '/components/scrolling-animation/' }) }}
        <p class="mb-4 font-mono text-sm text-gray-500">Demo · _parallaxBackground · _parallaxFloating</p>
        <h1 class="mb-6 text-5xl font-bold tracking-tight md:text-7xl">Parallax background</h1>
        <p class="mb-16 max-w-2xl text-lg text-gray-600 md:text-xl">Backgrounds that move slower than the page, so they look further away. Add a data attribute to the background, the script does the rest.</p>
        <p class="flex animate-bounce items-center gap-1 text-sm font-medium">Scroll down {{ angle('down') }}</p>
    </div>
</section>

{# demo: full width background #}
<section class="relative min-h-screen">
    <div class="pointer-events-none absolute inset-0 overflow-hidden">
        <div class="pointer-events-none absolute inset-0 bg-cover bg-center bg-no-repeat" data-parallax-background style="background-image: url('/assets/img/sample-image.webp')"></div>
    </div>
    <p class="absolute bottom-6 left-6 rounded-full bg-white px-4 py-2 font-mono text-sm shadow-md">data-parallax-background</p>
</section>

{# demo: range and easing #}
<section class="px-4 py-24">
    <div class="mx-auto max-w-295">
        <h2 class="mb-2 text-3xl font-bold tracking-tight">Range and easing</h2>
        <p class="mb-10 max-w-2xl text-gray-600">The range is how far the background moves, in pixels. Easing makes it trail behind the scroll a little instead of following it exactly.</p>
        <div class="grid gap-10 md:grid-cols-2">
            <figure>
                <div class="relative aspect-4/5 overflow-hidden rounded-2xl bg-black">
                    <div class="pointer-events-none absolute inset-0 bg-cover bg-center bg-no-repeat" data-parallax-background style="background-image: url('/assets/img/sample-image.webp')"></div>
                </div>
                <figcaption class="mt-4">
                    <code class="font-mono text-sm font-semibold">data-parallax-background</code>
                    <p class="text-gray-600">Default, 500px range, follows the scroll exactly</p>
                </figcaption>
            </figure>
            <figure>
                <div class="relative aspect-4/5 overflow-hidden rounded-2xl bg-black">
                    <div class="pointer-events-none absolute inset-0 bg-cover bg-center bg-no-repeat" data-parallax-background="100,easing" style="background-image: url('/assets/img/sample-image.webp')"></div>
                </div>
                <figcaption class="mt-4">
                    <code class="font-mono text-sm font-semibold">data-parallax-background="100,easing"</code>
                    <p class="text-gray-600">100px range, eased</p>
                </figcaption>
            </figure>
        </div>
    </div>
</section>

{# demo: floating image #}
<section class="px-4 py-24">
    <div class="mx-auto grid max-w-295 items-center gap-10 md:grid-cols-2">
        <div class="relative aspect-3/2 overflow-hidden rounded-2xl bg-black">
            <img class="absolute inset-x-0 -top-12.5 h-[calc(100%+50px)] w-full object-cover" data-parallax-floating src="/assets/img/sample-image.webp" width="2400" height="1600" alt="" />
        </div>
        <div>
            <h2 class="mb-2 text-3xl font-bold tracking-tight">Floating</h2>
            <p class="mb-4 text-gray-600">The image drifts down as it crosses the screen, up to its range (50px by default), eased. It's taller than its <code class="font-mono text-sm">overflow-hidden</code> frame by the range and starts that far above it, so the frame stays covered.</p>
            <code class="font-mono text-sm font-semibold">data-parallax-floating</code>
        </div>
    </div>
</section>

<section class="px-4 py-24">
    <div class="mx-auto max-w-295">
        <h2 class="mb-8 text-3xl font-bold tracking-tight">How it's built</h2>
        <div class="grid gap-10">
            <div class="grid gap-4 md:grid-cols-[1fr_2fr] md:gap-10">
                <div>
                    <h3 class="mb-2 text-xl font-semibold">Background markup</h3>
                    <p class="text-gray-600">The background fills an <code class="font-mono text-sm">overflow-hidden</code> parent. The script makes it taller by the range so it always covers the parent, and moves it from <code class="font-mono text-sm">-range</code> to 0 as the parent crosses the screen.</p>
                </div>
                {% set code %}{% raw %}
<section class="relative min-h-screen">
    <div class="absolute inset-0 overflow-hidden">
        <div class="absolute inset-0 bg-cover bg-center" data-parallax-background="100,easing" style="background-image: url('/assets/img/sample-image.webp')"></div>
    </div>
</section>
                {% endraw %}{% endset %}
                {{ codeBlock(code, 'html') }}
            </div>
            <div class="grid gap-4 md:grid-cols-[1fr_2fr] md:gap-10">
                <div>
                    <h3 class="mb-2 text-xl font-semibold">Floating markup</h3>
                    <p class="text-gray-600">Any element works. To fill a frame, make it taller than the frame by the range and start it that far above, so no gap shows at the top as it moves down.</p>
                </div>
                {% set code %}{% raw %}
<!-- 80px range: 80px taller, starting 80px above -->
<div class="relative aspect-3/2 overflow-hidden">
    <img class="absolute inset-x-0 -top-20 h-[calc(100%+80px)] w-full object-cover" data-parallax-floating="80" src="/assets/img/sample-image.webp" alt="" />
</div>
                {% endraw %}{% endset %}
                {{ codeBlock(code, 'html') }}
            </div>
            <div class="grid gap-4 md:grid-cols-[1fr_2fr] md:gap-10">
                <div>
                    <h3 class="mb-2 text-xl font-semibold">Script</h3>
                    <p class="text-gray-600">One instance per element. The options come from the data attributes. Both stay still when reduced motion is on.</p>
                </div>
                {% set code %}{% raw %}
document.querySelectorAll('[data-parallax-background]').forEach((target) => {
    new _parallaxBackground({ target });
});

document.querySelectorAll('[data-parallax-floating]').forEach((target) => {
    new _parallaxFloating({ target });
});
                {% endraw %}{% endset %}
                {{ codeBlock(code, 'js') }}
            </div>
            <div class="grid gap-4 md:grid-cols-[1fr_2fr] md:gap-10">
                <div>
                    <h3 class="mb-2 text-xl font-semibold">Options</h3>
                    <p class="text-gray-600">Set in the data attribute, or as props when there's no attribute value.</p>
                </div>
                <dl class="grid gap-x-6 gap-y-1 rounded-2xl border border-gray-200 p-6 text-sm md:grid-cols-[auto_1fr] md:gap-y-3">
                    <dt class="font-mono font-semibold">data-parallax-background="range,easing"</dt>
                    <dd class="mb-3 text-gray-600 last:mb-0 md:mb-0">range in pixels, default 500. Add <code class="font-mono">easing</code> to ease it.</dd>
                    <dt class="font-mono font-semibold">data-parallax-floating="range"</dt>
                    <dd class="mb-3 text-gray-600 last:mb-0 md:mb-0">range in pixels, default 50. Always eased.</dd>
                    <dt class="font-mono font-semibold">{ range, easing }</dt>
                    <dd class="mb-3 text-gray-600 last:mb-0 md:mb-0">Same options as props, e.g. <code class="font-mono">new _parallaxBackground({ target, range: 200 })</code></dd>
                </dl>
            </div>
        </div>
    </div>
</section>

{% footerscript %}
<!-- this script is just for this page -->
<script type="module">
    // Requirements
        // JS
            // gsap
            // src/assets/js/utils/_event.js
            // src/assets/js/utils/_parallax.js

    // for parallax background
    document.querySelectorAll('[data-parallax-background]').forEach((target) => {
        new _parallaxBackground({ target });
    });

    // for floating content
    document.querySelectorAll('[data-parallax-floating]').forEach((target) => {
        new _parallaxFloating({ target });
    });
</script>
{% endfooterscript %}
