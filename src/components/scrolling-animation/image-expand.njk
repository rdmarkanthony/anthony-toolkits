{% set markup %}{% raw %}
<!-- the height is the scroll length, the pin stays for all of it -->
<section class="js-image-expand relative h-[300svh]">
    <div class="js-image-expand-pin sticky top-(--header-height) h-[calc(100svh-var(--header-height,0px))] overflow-hidden">
        <!-- the script clips it to the banner, this one is before it runs -->
        <div class="js-image-expand-media absolute inset-0 [clip-path:inset(30%_10%_round_24px)]">
            <img class="js-image-expand-image absolute inset-0 size-full object-cover" src="image.jpg" alt="" />
            <!-- dims the image for the heading -->
            <div class="js-image-expand-dim absolute inset-0 bg-black opacity-0"></div>
        </div>
        <div class="js-image-expand-heading absolute inset-0 grid place-content-center text-white opacity-0">
            <h2>...</h2>
        </div>
    </div>
</section>
{% endraw %}{% endset %}

{% set pageScript %}{% raw %}
// Requirements
    // JS
        // src/assets/js/utils/_event.js
        // src/assets/js/utils/_emitter.js
        // src/assets/js/utils/_parallax.js

document.querySelectorAll('.js-image-expand').forEach((target) => {
    new _parallaxScroller({
        target,
        events: {
            init(scroller) {
                scroller.el.pin = target.querySelector('.js-image-expand-pin');
                scroller.el.media = target.querySelector('.js-image-expand-media');
                scroller.el.image = target.querySelector('.js-image-expand-image');
                scroller.el.dim = target.querySelector('.js-image-expand-dim');
                scroller.el.heading = target.querySelector('.js-image-expand-heading');

                // the banner opens to the full screen in the first half, the image zooms out a bit
                scroller.animate(scroller.el.media, (scroller) => ({ clipPath: [scroller.banner, 'inset(0px 0px round 0px)'] }), ['0%', '50%']);
                scroller.animate(scroller.el.image, { scale: [1.3, 1] }, ['0%', '50%']);

                // then it dims and the heading comes in, the rest is a hold
                scroller.animate(scroller.el.dim, { opacity: [0, 0.5] }, ['40%', '60%']);
                scroller.animate(scroller.el.heading, { opacity: [0, 1], translate: ['0 40px', '0 0'] }, ['45%', '70%']);
            },
            resize(scroller) {
                // while the section is pinned, --header-height from script.js
                const _header = parseFloat(getComputedStyle(document.body).getPropertyValue('--header-height')) || 0;
                scroller.offset.top = _parallax.getOffset(target).top - _header;
                scroller.offset.bottom = scroller.offset.top + target.offsetHeight - scroller.el.pin.offsetHeight;

                // the banner, centered, up to 640px wide
                const _width = scroller.el.pin.offsetWidth;
                const _height = scroller.el.pin.offsetHeight;
                const _bannerWidth = Math.min(_width - 48, 640);
                const _bannerHeight = Math.min(_bannerWidth * 0.6, _height * 0.5);
                scroller.banner = `inset(${(_height - _bannerHeight) / 2}px ${(_width - _bannerWidth) / 2}px round 24px)`;
            },
        },
    });
});
{% endraw %}{% endset %}

