<section class="px-4 py-24">
    <div class="mx-auto max-w-295">
        <h2 class="mb-8 text-3xl font-bold tracking-tight">How it's built</h2>
        <div class="grid gap-10">
            <div class="grid gap-4 md:grid-cols-[1fr_2fr] md:gap-10">
                <div>
                    <h3 class="mb-2 text-xl font-semibold">Markup</h3>
                    <p class="text-gray-600">A tall section with a sticky, screen-high video. The negative top margin pulls the video up a screen so it's already pinned when the section scrolls in, so the content above needs a higher <code class="font-mono text-sm">z-index</code> and a background. A fixed dim keeps the titles readable over bright footage, and the black cover on top of it fades out. The last title sits in a screen-high sticky box, pulled up half a screen so the title starts at its middle. The box's bottom meets the section's, so the title holds at mid screen and unpins together with the video. Its <code class="font-mono text-sm">min-h</code> beyond <code class="font-mono text-sm">50vh</code> sets how long it holds. Each title is styled by its <code class="font-mono text-sm">data-state</code>: <code class="font-mono text-sm">active</code> or <code class="font-mono text-sm">past</code>.</p>
                </div>
                {% set code %}{% raw %}
<section class="js-title-intro relative min-h-[150vh] bg-black text-white">
    <div class="sticky top-0 mt-[-100vh] h-screen overflow-hidden">
        <video class="js-hls-video absolute inset-0 size-full object-cover" data-src="/assets/video/sample-video/sample-video.m3u8" muted playsinline loop autoplay></video>
        <!-- default dim, keeps the titles readable -->
        <div class="absolute inset-0 bg-black/50"></div>
        <!-- fades out as the section scrolls in -->
        <div class="js-title-intro-cover absolute inset-0 bg-black"></div>
    </div>
    <div class="js-title-intro-content relative pt-[50vh] text-center">
        <ul class="js-title-intro-list">
            <li class="pb-20 opacity-0 transition data-[state=active]:opacity-100"><h2>...</h2></li>
            <!-- the last title holds at mid screen until the video unpins -->
            <li class="flow-root min-h-[80vh] opacity-0 transition data-[state=active]:opacity-100">
                <div class="sticky top-0 -mt-[50vh] min-h-screen pt-[50vh]"><h2 class="-translate-y-1/2">...</h2></div>
            </li>
        </ul>
    </div>
</section>
                {% endraw %}{% endset %}
                {{ codeBlock(code, 'html') }}
            </div>
            <div class="grid gap-4 md:grid-cols-[1fr_2fr] md:gap-10">
                <div>
                    <h3 class="mb-2 text-xl font-semibold">Script</h3>
                    <p class="text-gray-600"><code class="font-mono text-sm">_parallaxScroller</code> follows the content from when it enters the screen until its top reaches the top, and fades the cover out over that range. On resize it also measures where the titles start fading in, and where each title reaches the middle of the screen. On scroll, the last title past that point is <code class="font-mono text-sm">active</code>.</p>
                </div>
                {% set code %}{% raw %}
new _parallaxScroller({
    target: document.querySelector('.js-title-intro-content'),
    events: {
        init(scroller) {
            scroller.el.cover = scroller.target.closest('.js-title-intro').querySelector('.js-title-intro-cover');
            scroller.el.listWrap = scroller.target.querySelector('.js-title-intro-list');
            scroller.el.list = [...scroller.el.listWrap.children];
        },
        resize(scroller) {
            const _height = _parallax.height();
            const _top = _parallax.getOffset(scroller.target).top;

            // while the content enters the screen
            scroller.offset.top = _top - _height;
            scroller.offset.bottom = _top;

            // for the titles fade in
            scroller.fade = [_top - _height * 0.4, _parallax.getOffset(scroller.el.listWrap).top - _height * 0.55];

            // when each title reaches the middle of the display
            scroller.steps = scroller.el.list.map((item) => _parallax.getOffset(item).top - _height * 0.5 - item.querySelector('h2').offsetHeight * 0.25);
        },
        update(scroller) {
            // animate the video dim cover
            gsap.set(scroller.el.cover, { opacity: 1 - _parallax.clamp(scroller.offset.current) });

            // animate the titles parent container
            gsap.set(scroller.target, { opacity: _parallax.clamp(scroller.portion(...scroller.fade)) });

            // which title is in the middle of the display
            const _scrollTop = _parallax.scrollTop();
            const _current = scroller.steps.reduce((current, step, index) => (_scrollTop >= step ? index : current), 0);

            // show the current title
            scroller.el.list.forEach((item, index) => {
                item.dataset.state = index < _current ? 'past' : index === _current ? 'active' : '';
            });
        },
    },
});
                {% endraw %}{% endset %}
                {{ codeBlock(code, 'js') }}
            </div>
        </div>
    </div>
</section>

