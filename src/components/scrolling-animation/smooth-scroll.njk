        <!-- -1 moves left, 1 moves right, repeat the words so it stays full -->
        <div class="w-max [transform:skewX(var(--skew,0deg))]" data-marquee-direction="-1">
            Smooth<img class="inline-block h-[0.7em] w-[1.4em] rounded-full object-cover" src="image.jpg" alt="" />scroll ...
        </div>
    </div>
</section>
