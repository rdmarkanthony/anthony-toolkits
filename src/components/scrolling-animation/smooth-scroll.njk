<div class="relative">
    <section id="smooth-gallery" class="scroll-mt-(--header-height) overflow-hidden bg-stone-950 pt-24 pb-12 text-white md:pt-40">
        <div class="mx-auto max-w-295 px-4 text-center">
            <p class="mb-4 text-sm font-medium text-orange-400">Parallax on a smooth scroll</p>
            <h2 class="mx-auto max-w-4xl text-5xl leading-none font-semibold tracking-tight md:text-[--spacing(28)]">Every scroll, eased.</h2>
        </div>
        <div class="js-smooth-columns mx-auto mt-16 grid max-w-400 grid-cols-2 gap-3 px-3 md:mt-28 md:grid-cols-4 md:gap-5 md:px-5">
            {% for column in columns %}
            <div class="flex flex-col gap-3 md:gap-5 {{ column.tone }}" data-column-speed="{{ column.speed }}">
                {% for item in column.items %}
                {% if item.text %}
                <div class="flex flex-col justify-between rounded-2xl p-4 md:rounded-3xl md:p-6 {{ item.tone }} {{ item.aspect }}">
                    <p class="text-xs font-medium opacity-70 md:text-sm">{{ item.label }}</p>
                    <p class="text-5xl leading-none font-semibold tracking-tighter md:text-[--spacing(20)]">{{ item.text }}</p>
                </div>
                {% else %}
                <img class="w-full rounded-2xl object-cover md:rounded-3xl {{ item[1] }} {{ item[2] }}" src="/assets/img/gallery/{{ item[0] }}.webp" alt="" loading="lazy" />
                {% endif %}
                {% endfor %}
            </div>
            {% endfor %}
        </div>
    </section>

    <section id="smooth-marquee" class="js-smooth-velocity scroll-mt-(--header-height) overflow-hidden bg-stone-100 py-24 md:py-40">
        <p class="mb-10 text-center text-sm font-medium text-stone-500 md:mb-16">Scroll fast, the words lean.</p>
        {% for row in rows %}
        <div class="text-[16vw] leading-[0.95] font-bold tracking-tighter whitespace-nowrap md:text-[11vw] {{ row.tone }}">
            <div class="w-max [transform:skewX(var(--skew,0deg))]" data-marquee-direction="{{ row.direction }}">
                {% for i in range(4) %}
                {{ row.words[0] }}<img class="mx-[0.15em] inline-block h-[0.7em] w-[1.4em] rounded-full object-cover align-[-0.02em] {{ row.filters[0] }}" src="/assets/img/gallery/{{ row.images[0] }}-thumb.webp" alt="" loading="lazy" />{{ row.words[1] }}<img class="mx-[0.15em] inline-block h-[0.7em] w-[1.4em] rounded-full object-cover align-[-0.02em] {{ row.filters[1] }}" src="/assets/img/gallery/{{ row.images[1] }}-thumb.webp" alt="" loading="lazy" />
                {% endfor %}
            </div>
        </div>
        {% endfor %}
    </section>

    <div class="sticky bottom-6 z-10 flex h-0 items-end justify-center">
