{% set pageScript %}{% raw %}
// Requirements
    // JS
        // src/assets/js/utils/_emitter.js
        // src/assets/js/utils/_smoothScroll.js
        // src/assets/js/utils/_event.js
        // src/assets/js/utils/_parallax.js
    // CSS
        // @import "lenis/dist/lenis.css";
    // Package
        // pnpm add lenis

const _velocity = document.querySelectorAll('.js-smooth-velocity');

// the whole page, once
const smooth = new _smoothScroll({
    events: {
        // lean with the scroll speed, back to 0 as it stops
        scroll(smooth) {
            const _skew = Math.max(-12, Math.min(smooth.lenis.velocity * -0.3, 12));
            _velocity.forEach((target) => target.style.setProperty('--skew', `${_skew.toFixed(2)}deg`));
        },
    },
});

// pause it while a popup or menu is open
document.querySelectorAll('.js-smooth-pause').forEach((button) => {
    let _paused = false;

    button.addEventListener('click', () => {
        _paused = !_paused;
        _paused ? smooth.stop() : smooth.start();
        button.textContent = _paused ? 'Play' : 'Pause';
    });
});

// the columns, from the section entering the screen until it leaves
document.querySelectorAll('.js-smooth-columns').forEach((target) => {
    new _parallaxScroller({
        target,
        events: {
            init(scroller) {
                target.querySelectorAll('[data-column-speed]').forEach((column) => {
                    const _speed = parseFloat(column.dataset.columnSpeed) || 0;
                    scroller.animate(column, { translate: [`0 ${_speed}px`, `0 ${-_speed}px`] });
                });
            },
        },
    });
});

// the rows slide sideways, by a share of their own width
document.querySelectorAll('.js-smooth-velocity').forEach((target) => {
    new _parallaxScroller({
        target,
        events: {
            init(scroller) {
                target.querySelectorAll('[data-marquee-direction]').forEach((row) => {
                    const _left = row.dataset.marqueeDirection === '-1';
                    scroller.animate(row, { translate: _left ? ['-10% 0', '-40% 0'] : ['-40% 0', '-10% 0'] });
                });
            },
        },
    });
});
{% endraw %}{% endset %}

