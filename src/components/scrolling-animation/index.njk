<div class="px-4 py-24">
    <div class="mx-auto max-w-295">
        <h2 class="mb-4 text-3xl font-bold tracking-tight">Utilities</h2>
        <p class="mb-12 max-w-2xl text-gray-600">The scroll and parallax utils, all in <code class="font-mono text-sm">src/assets/js/utils/</code> and used in page scripts.</p>

        <div class="grid grid-cols-1 gap-6">
            <div class="rounded-2xl border border-gray-200 p-6">
                <h3 class="mb-1 font-mono font-semibold">_parallaxScroller</h3>
                <p class="mb-4 text-gray-600">Measures the target when the page resizes, then on scroll only does the math, at most once per frame. <code class="font-mono text-sm">offset.current</code> is 0 when the target enters the screen and 1 when it leaves, unclamped. Change <code class="font-mono text-sm">offset.top</code> and <code class="font-mono text-sm">offset.bottom</code> in <code class="font-mono text-sm">resize</code> for another range. <code class="font-mono text-sm">animate(target, keyframes, range)</code> hands values like opacity or translate to the browser, which moves them in step with the scroll, so they stay smooth on phones. Use <code class="font-mono text-sm">update</code> for the rest, like states or canvas frames. Ranges are percents of the range or scroll positions.</p>
                {% set code %}{% raw %}
const _scroller = new _parallaxScroller({
    target: document.querySelector('.js-my-section'),
    events: {
        // once, before measuring
        init(scroller) {
            // keyframes as in element.animate(), range default ['0%', '100%']
            scroller.animate(scroller.target, { scale: [0.8, 1] }, ['20%', '60%']);

            // functions rerun on resize, e.g. fade out at the end
            scroller.animate(scroller.target, { opacity: [1, 0] }, (scroller) => [scroller.offset.bottom - _parallax.height(), scroller.offset.bottom]);
        },
        // after measuring, e.g. set your own range
        resize(scroller) {
            const _offset = _parallax.getOffset(scroller.target);
            scroller.offset.top = _offset.top;
            scroller.offset.bottom = _offset.bottom - _parallax.height();
        },
        // on scroll, for the rest
        update(scroller) {
            const _progress = _parallax.clamp(scroller.portion('20%', '60%')); // 0 - 1 within part of the range
            scroller.target.dataset.state = _progress === 1 ? 'done' : '';
        },
    },
});

_scroller.on('update', (scroller) => {}); // more listeners, remove with off()
_scroller.destroy();
                {% endraw %}{% endset %}
                {{ codeBlock(code, 'js') }}
            </div>
            <div class="rounded-2xl border border-gray-200 p-6">
                <h3 class="mb-1 font-mono font-semibold">_parallax · _event</h3>
                <p class="mb-4 text-gray-600">Helpers the other utils are built on. <code class="font-mono text-sm">_event</code> keeps one scroll and one resize listener for the whole page, however many callbacks are added.</p>
                {% set code %}{% raw %}
_parallax.scrollTop();        // current scroll position
_parallax.width();            // viewport size without the scrollbar
_parallax.height();           // pass true for the document height
_parallax.getOffset(el);      // { top, left, bottom, right } in the document, transforms ignored
_parallax.getRange(min, max); // 0 at min, 1 at max, unclamped
_parallax.clamp(value);       // limit to 0 - 1

_event.resize((state) => {});  // state: init, ready, resize, after, skips the phone address bar
_event.scroll((e) => {});      // runs once now, then at most once per frame while scrolling
_event.observeResize((entry) => {}, el); // el changes size, e.g. images load above it

const _off = _event.scroll(callback); // every subscribe returns a function that removes it
_off();

_event.dispatch(el, 'visible', { index: 1 }); // listeners read e.detail
                {% endraw %}{% endset %}
                {{ codeBlock(code, 'js') }}
            </div>
        </div>
    </div>
</div>

{% footerscript %}
<script type="module">
    // Requirements
        // JS
            // src/assets/js/utils/_event.js
            // src/assets/js/utils/_emitter.js
            // src/assets/js/utils/_parallax.js
            // hls.js, src/assets/js/utils/_hlsVideo.js (for the video preview)

    // hls videos
    document.querySelectorAll('.js-hls-video').forEach((target) => new _hlsVideo({ target }));

    // video intro preview, the cover fades as the card scrolls in
    new _parallaxScroller({
        target: document.querySelector('.js-preview-video'),
        events: {
            init(scroller) {
                scroller.animate(scroller.target.querySelector('.js-preview-video-cover'), { opacity: [1, 0] }, ['0%', '40%']);
            },
        },
    });

    // parallax background preview
    document.querySelectorAll('[data-parallax-background]').forEach((target) => new _parallaxBackground({ target }));

    // text reveal preview, each word fades in turn
    new _parallaxScroller({
        target: document.querySelector('.js-preview-text'),
        events: {
            init(scroller) {
                scroller.target.innerHTML = scroller.target.textContent.replace(/\S+/g, '<span>$&</span>');
                const _words = [...scroller.target.children];
                const _total = 1 + (_words.length - 1) * 0.1;
                _words.forEach((word, index) => {
                    scroller.animate(word, { opacity: [0.15, 1] }, [`${((index * 0.1) / _total) * 100}%`, `${((index * 0.1 + 1) / _total) * 100}%`]);
                });
            },
        },
    });
</script>
{% endfooterscript %}
