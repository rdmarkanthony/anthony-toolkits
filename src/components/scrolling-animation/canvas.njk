<section class="px-4 py-16">
    <div class="mx-auto max-w-295">
        <h2 class="mb-2 text-3xl font-bold tracking-tight">The frames</h2>
        <p class="mb-8 max-w-2xl text-gray-600">50 JPGs named <code class="font-mono text-sm">large_0000.jpg</code> to <code class="font-mono text-sm">large_0049.jpg</code>, and a half-size WebP set <code class="font-mono text-sm">small_0000.webp</code> for phones. Only the frames near the current one stay loaded, decoded ahead so drawing one is instant.</p>
        <ul class="grid grid-cols-10 gap-1">
            {% for i in range(0, 50) %}
            <li><img class="w-full" src="/assets/img/headphone/large_{{ i | pad(4) }}.jpg" alt="" loading="lazy" /></li>
            {% endfor %}
        </ul>
        <p class="mt-16 flex animate-bounce items-center gap-1 text-sm font-medium">Scroll down {{ angle('down') }}</p>
    </div>
</section>

{# demo, pinned below the sticky site header #}
<section class="js-canvas-section relative min-h-[300vh]">
    <div class="sticky top-(--header-height) flex h-[calc(100vh-var(--header-height,0px))] items-center justify-center p-6">
        <canvas class="js-canvas"></canvas>
        <p class="absolute right-6 bottom-6 rounded-full bg-white px-4 py-2 font-mono text-sm shadow-md">Frame <span class="js-canvas-frame">1</span> / 50</p>
    </div>
</section>

{% set markup %}{% raw %}
<!-- tall section, the canvas stays pinned while it scrolls past -->
<section class="js-canvas-section relative min-h-[300vh]">
    <div class="sticky top-0 flex h-screen items-center justify-center p-6">
        <canvas class="js-canvas"></canvas>
    </div>
</section>
{% endraw %}{% endset %}

{% set pageScript %}{% raw %}
// Requirements
    // JS
        // src/assets/js/utils/_event.js
        // src/assets/js/utils/_emitter.js
        // src/assets/js/utils/_parallax.js
        // src/assets/js/utils/_canvasBanner.js

// frames are path + zero-padded number + .type, starting at 0
const _canvas = new _canvasBanner({
    target: document.querySelector('.js-canvas'),
    assets: {
        count: 50,
        path: '/assets/img/headphone/large_',
        // type: 'jpg', default
        digits: 4, // zero-padding, default from the count
        size: [1004, 1214], // [width, height], for the ratio
        resizeMode: 'contain', // width (default), height or contain
        // step: 1, every nth frame, the last is always kept
        // buffer: 20, frames kept loaded around the current one
        // path, type, size, step, buffer below 768px or on media
        mobile: {
            path: '/assets/img/headphone/small_',
            type: 'webp',
            size: [502, 607],
            step: 2,
        },
    },
    // transition: { duration: 0 }, crossfade between frames in ms
    // events: init, beforeUpdate, afterUpdate, resize, more with on() / off()
});
const _frame = document.querySelector('.js-canvas-frame');

new _parallaxScroller({
    target: document.querySelector('.js-canvas-section'),
    events: {
        // while the section is pinned
        resize(scroller) {
            const _offset = _parallax.getOffset(scroller.target);

            scroller.offset.top = _offset.top;
            scroller.offset.bottom = _offset.bottom - _parallax.height();
        },
        update(scroller) {
            // 0 is the first frame, 1 the last
            _canvas.update(scroller.offset.current);

            // frame counter, optional
            if (_frame) _frame.textContent = _canvas.assets.frames[_canvas.assets.current] + 1;
        },
    },
});
{% endraw %}{% endset %}

