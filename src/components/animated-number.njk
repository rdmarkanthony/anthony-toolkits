    <div class="js-animated-number mx-auto flex max-w-295 flex-col gap-6">
        <p class="js-animated-number-label text-6xl font-bold tracking-tight tabular-nums md:text-8xl">0</p>
        <form class="flex max-w-md gap-2">
            <label class="grow">
                <span class="sr-only">Number</span>
