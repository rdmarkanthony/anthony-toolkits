{% set pageScript %}{% raw %}
const _wrap = document.querySelector('.js-animated-number');
const _label = _wrap.querySelector('.js-animated-number-label');
const _input = _wrap.querySelector('input');
let _instance = null;

const _cleanNumber = (value) => value.replace(/,/g, '').replace(/[^0-9.]/g, '');

// only numbers, one decimal point and 2 decimals, with commas
_input.addEventListener('input', () => {
    const _parts = _cleanNumber(_input.value).split('.');
    const _integer = _parts[0] ? Number(_parts[0]).toLocaleString() : '';
    const _decimal = _parts.length > 1 ? '.' + _parts.slice(1).join('').slice(0, 2) : '';

    _input.value = _integer + _decimal;
});

// count to the entered number
_wrap.querySelector('form').addEventListener('submit', (e) => {
    e.preventDefault();

    const _value = parseFloat(_cleanNumber(_input.value));
    if (isNaN(_value) || _instance) return;

    _instance = new _animatedNumber({
        target: _label,
        from: parseFloat(_cleanNumber(_label.innerText)) || 0,
        to: _value,
        decimals: _value % 1 !== 0 ? 2 : null,
        duration: 500,
        callback: () => (_instance = null),
    });
});

// count up when it scrolls into view
new _inview({
    target: _label,
    delay: 500,
    callback: () => {
        new _animatedNumber({ target: _label, from: 0, to: 1234567890, duration: 2000 });
    },
});
{% endraw %}{% endset %}

