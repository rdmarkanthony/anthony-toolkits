{% endraw %}{% endset %}

{{ scriptUsage({
    markup: markup,
    markupNote: 'The track is a normal scroller with Tailwind scroll snap, so touch and trackpad scrolling are the browser\'s own. The card width is set by its class. Each card gets <code class="font-mono text-sm">--offset</code> (-1 to 1, 0 in place) and <code class="font-mono text-sm">--near</code> (1 in place, 0 a card away) for parallax.',
    code: pageScript,
    note: 'Adds mouse dragging and the buttons, both glide to a card with a slow ease out. No library.'
}) }}

{% footerscript %}
<script type="module">{{ pageScript | safe }}</script>
{% endfooterscript %}
