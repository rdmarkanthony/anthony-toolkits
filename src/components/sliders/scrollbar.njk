{{ scriptUsage({
    markup: markup,
    markupNote: 'The track is a normal scroller with no snap, so touch and trackpad scrolling are the browser\'s own. The slider gets <code class="font-mono text-sm">--progress</code> (0 to 1), <code class="font-mono text-sm">--thumb-size</code> (how much of the row is in view, 0 to 1) and <code class="font-mono text-sm">data-scrollable</code> while the row overflows.',
    code: pageScript,
    note: 'Adds mouse dragging with a throw, the bar (drag the thumb or press anywhere on it) and the arrows, which glide one card. Events: <code class="font-mono text-sm">update</code> as it scrolls, <code class="font-mono text-sm">change</code> when the card at the start changes. No library.'
}) }}

{% footerscript %}
