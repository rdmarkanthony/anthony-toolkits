{% set markup %}{% raw %}
<!-- overflow-clip hides the row's ends, and focus can't scroll it sideways -->
<section class="overflow-clip">
    <!-- the row: its children are the items, gap is fine -->
    <ul class="js-loop-scroll flex gap-4 select-none">
        <li class="w-[70%] shrink-0 sm:w-[24rem]">...</li>
        <li class="w-[70%] shrink-0 sm:w-[24rem]">...</li>
    </ul>
</section>

<!-- cards: links and buttons inside still click, a drag doesn't -->
<ul class="js-loop-cards flex gap-4 select-none">
    <li class="w-[70%] shrink-0 sm:w-[22rem]"><a href="..." draggable="false">...</a></li>
</ul>

<!-- marquee: whitespace-nowrap keeps each word on one line -->
<ul class="js-loop-marquee flex select-none">
    <li class="shrink-0 whitespace-nowrap">...</li>
</ul>
{% endraw %}{% endset %}

{% set pageScript %}{% raw %}
// Requirements
    // JS
        // src/assets/js/utils/_horizontalLoop.js
    // Package
        // pnpm add gsap

// on scroll: still, the page scroll moves them, the first row left and the second right
const _scrollRows = [...document.querySelectorAll('.js-loop-scroll')].map((target) => new _horizontalLoop({ target, paused: true, snap: false }));

// cards: still until dragged, a throw stops with a card centered
document.querySelectorAll('.js-loop-cards').forEach((target) => new _horizontalLoop({ target, paused: true, center: true }));

// marquee: plays on its own, pauses on hover
const _marquees = [...document.querySelectorAll('.js-loop-marquee')].map((target) => new _horizontalLoop({ target, speed: 0.8, pauseOnHover: true }));

let _lastScroll = window.scrollY;
_event.scroll(() => {
    const _distance = window.scrollY - _lastScroll;
    _lastScroll = window.scrollY;
    if (!_distance) return;

    _scrollRows.forEach((row, i) => row.move(i % 2 === 0 ? _distance : -_distance));
    // the marquee turns when the page scrolls up, and the scroll pushes it along faster
    _marquees.forEach((marquee) => {
        marquee.setDirection(_distance > 0 ? 'left' : 'right');
        marquee.move(_distance * 0.5);
    });
});
{% endraw %}{% endset %}

