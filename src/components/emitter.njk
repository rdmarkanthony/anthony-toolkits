{% set pageScript %}{% raw %}
// Requirements
    // JS
        // src/assets/js/utils/_emitter.js

// your own util: pass props.events to super(), then emit()
class _counter extends _emitter {
    constructor(props) {
        super(props.events);

        this.count = 0;
        this.max = props.max ?? 5;
    }

    add() {
        if (this.count >= this.max) return;

        this.count++;
        this.emit('change');

        if (this.count === this.max) this.emit('max');
    }

    reset() {
        this.count = 0;
        this.emit('reset');
        this.emit('change');
    }
}

const _wrap = document.querySelector('.js-emitter');
const _value = _wrap.querySelector('.js-emitter-value');
const _log = _wrap.querySelector('.js-emitter-log');

const _write = (text) => {
    const _item = document.createElement('li');
    _item.textContent = text;
    _log.prepend(_item);

    while (_log.children.length > 8) _log.lastChild.remove();
};

// events in the props, one callback each, they get the instance
const _myCounter = new _counter({
    max: 5,
    events: {
        change: (instance) => (_value.textContent = instance.count),
        max: (instance) => _write(`max: ${instance.max}, from events`),
    },
});

// more listeners with on(), removed with off()
const _onChange = (instance) => _write(`change: ${instance.count}, from on()`);
_myCounter.on('change', _onChange);
_myCounter.on('reset', () => _write('reset, from on()'));

_wrap.querySelector('.js-emitter-add').addEventListener('click', () => _myCounter.add());
_wrap.querySelector('.js-emitter-reset').addEventListener('click', () => _myCounter.reset());
_wrap.querySelector('.js-emitter-listen').addEventListener('change', (e) => {
    if (e.target.checked) _myCounter.on('change', _onChange);
    else _myCounter.off('change', _onChange);
});
{% endraw %}{% endset %}

