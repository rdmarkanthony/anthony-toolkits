            <p class="font-mono text-sm text-gray-950/60">Card hover, tilt 12, scale 1.2</p>
            <p class="js-weight-pop-big font-display text-7xl leading-[0.95] font-bold tracking-tight md:text-[7.5rem]">Say<br />hello</p>
