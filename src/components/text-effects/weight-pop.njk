<section class="px-4 pb-4">
    <div class="mx-auto grid max-w-295 gap-4 md:grid-cols-[3fr_2fr]">
        <div class="flex min-h-112 flex-col justify-between gap-10 rounded-3xl bg-gray-950 p-8 text-white md:p-12">
