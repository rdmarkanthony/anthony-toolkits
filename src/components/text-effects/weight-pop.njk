{% set markup %}{% raw %}
<!-- any font, the letters are split with split-type, screen readers still get the text -->
<a class="js-weight-pop" href="#">Work</a>

<!-- hovering the card plays the heading -->
<a class="js-weight-pop-card" href="#">
    <p class="js-weight-pop-big">Say<br />hello</p>
</a>
{% endraw %}{% endset %}

{% set pageScript %}{% raw %}
// Requirements
    // JS
        // split-type (npm)
        // src/assets/js/utils/_emitter.js
        // src/assets/js/utils/_weightPop.js

document.querySelectorAll('.js-weight-pop').forEach((target) => {
    new _weightPop({
        target,
        // defaults: trigger: the target, stagger: 35, tilt: 7, scale: 1.14, bold: 0.025, duration: 900
        events: {
            // play: () => console.log('play'),
        },
    });
});

// the card is hovered, the heading pops, slower and wilder
new _weightPop({
    target: document.querySelector('.js-weight-pop-big'),
    trigger: document.querySelector('.js-weight-pop-card'),
    stagger: 50,
    tilt: 12,
    scale: 1.2,
});

// a button: subtle
new _weightPop({ target: document.querySelector('.js-weight-pop-button'), tilt: 4, scale: 1.08, bold: 0.02 });
{% endraw %}{% endset %}

{{ scriptUsage({
    markup: markup,
    markupNote: 'Text with a <code class="font-mono text-sm">js-</code> class, icons and other tags inside stay as they are.',
    code: pageScript,
    note: 'Options: <code class="font-mono text-sm">target</code>, <code class="font-mono text-sm">trigger</code>, <code class="font-mono text-sm">stagger</code> (ms per letter), <code class="font-mono text-sm">tilt</code> (deg), <code class="font-mono text-sm">scale</code>, <code class="font-mono text-sm">bold</code> (em), <code class="font-mono text-sm">duration</code> (ms). Methods: <code class="font-mono text-sm">play()</code>, <code class="font-mono text-sm">destroy()</code>. Events: <code class="font-mono text-sm">play</code>. It plays on hover and on keyboard focus, a pop still going finishes first. The bold is a text-shadow in the text color, so the letters keep their width and the line stays put. Reduced motion keeps the text as it is.'
}) }}

