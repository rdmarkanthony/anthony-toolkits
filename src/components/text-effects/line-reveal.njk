{% set markup %}{% raw %}
<h2 class="js-line-reveal">We build websites that feel fast, calm and easy to use</h2>

<!-- links and styled words keep their style -->
<h2 class="js-line-reveal">Good design is <em>quiet</em>, it lets the <a href="#">work</a> speak</h2>
{% endraw %}{% endset %}

{% set pageScript %}{% raw %}
// Requirements
    // JS
        // src/assets/js/utils/_emitter.js
        // src/assets/js/utils/_inview.js
        // src/assets/js/utils/_lineReveal.js

// plays once in view
document.querySelectorAll('.js-line-reveal').forEach((target) => {
    new _lineReveal({
        target,
        // defaults: duration: 900, stagger: 120 (ms per line), delay: 0, inview: true, once: true
    });
});

// the text below comes in after the title
new _lineReveal({ target: document.querySelector('.js-line-reveal-title') });
new _lineReveal({ target: document.querySelector('.js-line-reveal-text'), delay: 300, stagger: 60 });

// plays again each time it comes back into view
new _lineReveal({ target: document.querySelector('.js-line-reveal-menu'), once: false, stagger: 80 });

// your own timing, methods and events
const _log = document.querySelector('.js-line-reveal-log'); // demo
const _control = new _lineReveal({
    target: document.querySelector('.js-line-reveal-control'),
    // inview: false, to only play it from your script
    events: {
        // start: () => console.log('start'),
        // complete: () => console.log('complete'),
        start: () => (_log.textContent = 'start'), // demo
        complete: () => (_log.textContent = 'complete'), // demo
    },
});

document.querySelector('.js-line-reveal-play').addEventListener('click', () => _control.play());
document.querySelector('.js-line-reveal-hide').addEventListener('click', () => _control.hide());
{% endraw %}{% endset %}

