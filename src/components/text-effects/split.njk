{# demo: the whole card splits its title #}
<section class="px-4 pb-16">
    <div class="mx-auto grid max-w-295 gap-4 md:grid-cols-3">
        {% for card in [{ name: 'Lumen', type: 'Branding', photo: 1 }, { name: 'Northwind', type: 'Website', photo: 3 }, { name: 'Oakline', type: 'App', photo: 5 }] %}
        <a class="split-hover-trigger group flex flex-col gap-4 [--split-color:var(--color-emerald-600)]" href="#">
            <div class="aspect-4/3 overflow-hidden rounded-3xl"><img class="size-full object-cover transition-transform duration-700 group-hover:scale-105" src="/assets/img/gallery/photo-{{ card.photo }}.webp" alt="" loading="lazy" /></div>
            <div class="flex items-baseline justify-between gap-4">
                <h3 class="text-3xl font-bold tracking-tight"><span class="split-hover" data-text="{{ card.name }}"><span>{{ card.name }}</span></span></h3>
                <p class="text-gray-500">{{ card.type }}</p>
            </div>
        </a>
        {% endfor %}
    </div>
</section>

{% set markup %}{% raw %}
<!-- the parent's hover or focus splits it, data-text = the text -->
<a href="#"><span class="split-hover" data-text="Work"><span>Work</span></span></a>

<!-- a whole card splits its title with .split-hover-trigger -->
<a class="split-hover-trigger" href="#">
    <img src="project.webp" alt="" />
    <h3><span class="split-hover" data-text="Lumen"><span>Lumen</span></span></h3>
</a>

<!-- the copy's color -->
<a class="[--split-color:var(--color-emerald-400)]" href="#">
    <span class="split-hover" data-text="Work"><span>Work</span></span>
</a>
{% endraw %}{% endset %}

{% set pageCss %}{% raw %}/* style.css */
@import "./components/split-hover.css";

/* split-hover.css */
@layer components {
    .split-hover {
        position: relative;
        display: inline-block;
        padding-block: 0.1em;
        margin-block: -0.1em;
        vertical-align: top;
        white-space: nowrap;
        overflow: hidden;
    }
    /* the halves, screen readers skip them */
    .split-hover::before,
    .split-hover::after {
        content: attr(data-text);
        content: attr(data-text) / "";
        position: absolute;
        inset: 0;
        padding-block: inherit;
    }
    .split-hover::before {
        clip-path: inset(0 0 50% 0);
    }
    .split-hover::after {
        clip-path: inset(50% 0 0 0);
    }
    .split-hover > span {
        display: block;
        color: var(--split-color, currentColor);
        clip-path: inset(50% 0 50% 0);
    }

    @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
        .split-hover::before,
        .split-hover::after,
        .split-hover > span {
            transition:
                translate 0.7s cubic-bezier(0.22, 1, 0.36, 1),
                clip-path 0.7s cubic-bezier(0.22, 1, 0.36, 1);
        }
        :is(:hover, :focus-visible) > .split-hover::before,
        .split-hover-trigger:is(:hover, :focus-visible) .split-hover::before {
            translate: 0 -50%;
        }
        :is(:hover, :focus-visible) > .split-hover::after,
        .split-hover-trigger:is(:hover, :focus-visible) .split-hover::after {
            translate: 0 50%;
        }
        :is(:hover, :focus-visible) > .split-hover > span,
        .split-hover-trigger:is(:hover, :focus-visible) .split-hover > span {
            clip-path: inset(-0.1em 0 -0.1em 0);
        }
    }
}{% endraw %}{% endset %}

