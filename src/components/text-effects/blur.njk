{# demo: a title word by word, then the text as a whole #}
<section class="px-4 pb-4">
    <div class="mx-auto max-w-295">
        <div class="flex min-h-96 flex-col justify-between gap-10 rounded-3xl bg-gray-100 p-8 md:p-12">
            <p class="font-mono text-sm text-gray-500">Title, then the text</p>
            <div>
                <h2 class="js-splittext mb-6 max-w-4xl text-5xl leading-[1.05] font-bold tracking-tight md:text-7xl" data-animate="blurIn">Quiet websites for busy people</h2>
                <p class="max-w-xl text-lg text-gray-600" data-animate="blurIn,0.8,1.2">Lorem ipsum dolor sit amet consectetur adipisicing elit. Libero est illo eius laudantium, earum culpa corporis.</p>
            </div>
        </div>
    </div>
</section>

{# demo: a dark hero, slower #}
<section class="px-4 pb-16">
    <div class="mx-auto max-w-295">
        <div class="flex min-h-[28rem] flex-col justify-between gap-10 rounded-3xl bg-gray-950 p-8 text-white md:p-12">
            <p class="font-mono text-sm text-white/60">Hero, after a pause</p>
            <h2 class="js-splittext max-w-5xl text-6xl leading-none font-light tracking-tight md:text-9xl" data-animate="blurIn,0.4">Made with care, built to last</h2>
