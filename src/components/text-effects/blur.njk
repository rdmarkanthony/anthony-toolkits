{% set markup %}{% raw %}
<!-- in <head> -->
<script>document.documentElement.classList.add("js-animate");</script>

<!-- a title, word by word -->
<h2 class="js-splittext" data-animate="blurIn">Quiet websites for busy people</h2>

<!-- any element as a whole: data-animate="blurIn,delay,duration", in seconds -->
<p data-animate="blurIn,0.8,1.2">...</p>
{% endraw %}{% endset %}

{% set pageScript %}{% raw %}
// Requirements
    // JS
        // split-type
        // src/assets/js/utils/_event.js
        // src/assets/js/utils/_inview.js
        // src/assets/js/utils/_splitText.js
        // src/assets/js/utils/_animate.js
    // HTML
        // document.documentElement.classList.add("js-animate") in <head>
    // CSS
        // animate.css
        // src/assets/css/components/data-animate.css (the blurIn keyframe)

// once per page, the same call as Animate
new _animate();
{% endraw %}{% endset %}

