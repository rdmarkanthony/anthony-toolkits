{% set markup %}{% raw %}
<!-- a variable font, its own weight is where the letters rest -->
<h2 class="js-weight-hover font-light">Move the mouse across this line</h2>
{% endraw %}{% endset %}

{% set pageScript %}{% raw %}
// Requirements
    // JS
        // split-type (npm)
        // src/assets/js/utils/_emitter.js
        // src/assets/js/utils/_event.js
        // src/assets/js/utils/_weightHover.js
    // Font
        // a variable font with a weight axis, here DM Sans 100..1000 from Google Fonts

new _weightHover({
    target: document.querySelector('.js-weight-hover'),
    // defaults: min: the text's own weight, max: 900, radius: 200, ease: 0.15
});

// thin to black, felt from further away
new _weightHover({ target: document.querySelector('.js-weight-hover-wide'), max: 1000, radius: 320 });

// a menu: subtle and close
document.querySelectorAll('.js-weight-hover-menu').forEach((target) => {
    new _weightHover({
        target,
        min: 400,
        max: 700,
        radius: 60,
        events: {
            // enter: () => console.log('enter'),
            // leave: () => console.log('leave'),
        },
    });
});
{% endraw %}{% endset %}

