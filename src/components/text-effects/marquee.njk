{% set markup %}{% raw %}
<!-- overflow-hidden hides the cover until hover -->
<a class="js-hover-marquee relative block overflow-hidden" href="#">
    <span class="js-hover-marquee-label block">Work</span>

    <!-- the cover waits below, a copy for the eye only -->
    <span class="js-hover-marquee-cover absolute inset-0 translate-y-full" aria-hidden="true">
        <!-- the row: its children are the items, copied to fill it -->
        <span class="js-hover-marquee-track flex h-full items-center">
            <span class="shrink-0 pr-6 whitespace-nowrap">Work ·</span>
        </span>
    </span>
</a>

<!-- data-direction="right" runs it the other way -->
{% endraw %}{% endset %}

{% set pageScript %}{% raw %}
// Requirements
    // JS
        // src/assets/js/utils/_emitter.js
        // src/assets/js/utils/_event.js
        // src/assets/js/utils/_horizontalLoop.js
    // Package
        // pnpm add gsap

// the cover comes in from the side the mouse enters, and leaves by the side it leaves
const _reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
const _timing = { duration: 700, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fill: 'forwards' };

// from its spot if it's still moving, so a quick back and forth doesn't jump
const _slide = (el, from, to) => {
    const _moving = el.getAnimations().some((animation) => animation.playState === 'running');
    const _from = _moving ? getComputedStyle(el).translate : from;
    el.getAnimations().forEach((animation) => animation.cancel());
    el.animate({ translate: [_from, to] }, _timing);
};

// top or bottom, the nearest edge, keyboard comes from below
const _edge = (e, link) => {
    if (e.clientY === undefined) return 1;
    const _rect = link.getBoundingClientRect();
    return e.clientY < _rect.top + _rect.height / 2 ? -1 : 1;
};

document.querySelectorAll('.js-hover-marquee').forEach((link) => {
    const _label = link.querySelector('.js-hover-marquee-label');
    const _cover = link.querySelector('.js-hover-marquee-cover');
    const _loop = new _horizontalLoop({
        target: link.querySelector('.js-hover-marquee-track'),
        paused: true,
        draggable: false,
        // speed: 1 is 100px a second
    });
    if (link.dataset.direction) _loop.setDirection(link.dataset.direction);

    const _enter = (e) => {
        if (_reduce) return;
        const _side = _edge(e, link) * 100;
        _slide(_cover, `0 ${_side}%`, '0 0');
        _slide(_label, '0 0', `0 ${-_side}%`);
        _loop.play();
    };
    const _leave = (e) => {
        if (_reduce) return;
        const _side = _edge(e, link) * 100;
        _slide(_cover, '0 0', `0 ${_side}%`);
        _slide(_label, `0 ${-_side}%`, '0 0');
        _loop.pause();
    };

    link.addEventListener('pointerenter', _enter);
    link.addEventListener('pointerleave', _leave);
    link.addEventListener('focusin', (e) => link.matches(':focus-visible') && _enter(e));
    link.addEventListener('focusout', _leave);
});
{% endraw %}{% endset %}

