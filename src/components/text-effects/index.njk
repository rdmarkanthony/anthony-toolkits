{% from "components/atoms/icon.njk" import angle %}
{% from "components/atoms/component-page.njk" import pageIntro %}

{{ pageIntro({ title: 'Text effects', description: 'Text effects for links, buttons, menus and headings, each with its own script. Hover a card to try it. Each demo shows its markup and script, ready to copy.' }) }}

{% set demos = [
    { url: '/components/text-effects/blur/', title: 'Blur reveal', text: 'Words come in from blurred to sharp as a title scrolls into view.', utils: '_animate · _splitText', id: 'blur', word: 'Into focus', class: 'bg-gray-950 text-white', previewClass: 'font-light' },
    { url: '/components/text-effects/highlight/', title: 'Highlight', text: 'A marker color grows behind a few words as they come into view.', utils: '_animate · _inview', id: 'highlight', word: 'Make it <mark class="highlight">pop</mark>', class: 'bg-gray-100' },
    { url: '/components/text-effects/marquee/', title: 'Hover marquee', text: 'A link whose label turns into an endless row while hovered.', utils: '_horizontalLoop · GSAP', id: 'marquee', word: '<span class="flex shrink-0 items-center gap-4 pr-4 whitespace-nowrap">Hover me<span class="size-2.5 rounded-full bg-emerald-400"></span></span>', class: 'bg-gray-950 text-white', previewClass: 'flex w-full' },
    { url: '/components/animate/#split-text', title: 'Line reveal', text: "Title words slide up from behind each line's mask, part of Animate.", utils: '_animate · _splitText', id: 'line-reveal', word: 'Lines that<br />slide up', class: 'bg-gray-100' },
    { url: '/components/text-effects/scramble/', title: 'Scramble text', text: 'Letters flip through random characters, then settle into the text.', utils: '_scrambleText', id: 'scramble', word: 'GET STARTED', class: 'bg-gray-50 font-mono' },
    { url: '/components/text-effects/split/', title: 'Split hover', text: 'The word splits at the middle, the halves slide apart and a copy opens.', utils: 'CSS only', id: 'split', word: '<span class="split-hover" data-text="Split"><span>Split</span></span>', class: 'bg-gray-100 [--split-color:var(--color-rose-500)]', cardClass: 'split-hover-trigger' },
    { url: '/components/text-effects/roll/', title: 'Text roll', text: 'Link and button text that rolls up on hover, a copy coming in from below.', utils: '_textRoll', id: 'roll', word: "Let's talk", class: 'bg-gray-950 text-white' },
    { url: '/components/text-effects/typing/', title: 'Typing animation', text: 'Types and erases lines, with styled parts and a steady cursor.', utils: '_typing', id: 'typing', word: 'Hello', class: 'bg-gray-100' },
    { url: '/components/text-effects/weight/', title: 'Weight hover', text: 'Letters near the mouse get bolder, a wave that follows the cursor.', utils: '_weightHover', id: 'weight', word: 'Weight', class: 'bg-gray-950 text-white', previewClass: 'text-7xl font-thin' },
    { url: '/components/text-effects/weight-pop/', title: 'Weight pop', text: 'On hover the letters pop bolder one after another, then settle back.', utils: '_weightPop', id: 'weight-pop', word: 'Say hello', class: 'bg-lime-300', previewClass: 'font-display text-6xl' }
] %}
<section id="demos" class="px-4 pb-16">
    <div class="mx-auto max-w-295">
        <h2 class="mb-8 text-3xl font-bold tracking-tight">Demos</h2>
        <div class="grid gap-6 sm:grid-cols-2">
            {% for demo in demos %}
            <a class="js-{{ demo.id }}-card group {{ demo.cardClass }} flex flex-col overflow-hidden rounded-2xl border border-gray-200 transition-colors hover:border-gray-950" href="{{ demo.url }}">
                <div class="flex aspect-4/3 items-center justify-center overflow-hidden px-6 {{ demo.class }}">
                    <p class="js-{{ demo.id }}-preview text-4xl font-bold tracking-tight {{ demo.previewClass }}">{{ demo.word | safe }}</p>
                </div>
                <div class="flex flex-1 flex-col p-6">
                    <h3 class="mb-2 text-xl font-semibold">{{ demo.title }}</h3>
                    <p class="mb-6 flex-1 text-gray-600">{{ demo.text }}</p>
                    <p class="mb-4 font-mono text-xs text-gray-500">{{ demo.utils }}</p>
                    <span class="inline-flex items-center gap-1 text-sm font-medium">Open demo {{ angle('right', 'group-hover:translate-x-0.5') }}</span>
                </div>
            </a>
            {% endfor %}
        </div>
    </div>
</section>

{% footerscript %}
<script type="module">
// demo only: each card plays its effect on hover, typing loops on its own
_textRoll('.js-roll-preview');
document.querySelector('.js-roll-card').dataset.textRoll = '';

new _scrambleText({ target: document.querySelector('.js-scramble-preview'), trigger: document.querySelector('.js-scramble-card') });

// line reveal: _animate's split text classes, played again on each hover
const _lines = document.querySelector('.js-line-reveal-preview');
_lines.classList.add('js-splittext', 'js-splittext-animate', 'js-splittext-animated');
new _splitText({ target: _lines });
document.querySelector('.js-line-reveal-card').addEventListener('pointerenter', () => {
    _lines.classList.remove('js-splittext-animated');
    _lines.offsetWidth;
    _lines.classList.add('js-splittext-animated');
});

// blur reveal: the keyframe from data-animate.css, played again on each hover
const _blur = document.querySelector('.js-blur-preview');
const _blurIn = () => {
    _blur.classList.remove('animate__animated', 'animate__blurIn');
    _blur.offsetWidth;
    _blur.classList.add('animate__animated', 'animate__blurIn');
};
_blurIn();
document.querySelector('.js-blur-card').addEventListener('pointerenter', _blurIn);

// highlight: the keyframe from data-animate.css, played again on each hover
const _mark = document.querySelector('.js-highlight-preview mark');
const _highlight = () => {
    _mark.classList.remove('animate__animated', 'animate__highlight');
    _mark.offsetWidth;
    _mark.classList.add('animate__animated', 'animate__highlight');
};
_highlight();
document.querySelector('.js-highlight-card').addEventListener('pointerenter', _highlight);

// marquee runs while the card is hovered
const _marquee = new _horizontalLoop({ target: document.querySelector('.js-marquee-preview'), paused: true, draggable: false });
document.querySelector('.js-marquee-card').addEventListener('pointerenter', () => _marquee.play());
document.querySelector('.js-marquee-card').addEventListener('pointerleave', () => _marquee.pause());

// weight hover, felt across the card
new _weightHover({ target: document.querySelector('.js-weight-preview'), max: 1000, radius: 160 });

// weight pop, plays as the card is hovered
new _weightPop({ target: document.querySelector('.js-weight-pop-preview'), trigger: document.querySelector('.js-weight-pop-card'), tilt: 10, scale: 1.2 });

new _typing({ target: document.querySelector('.js-typing-preview'), lines: ['Hello', 'Bonjour', 'Hola', 'Ciao'], loop: true, pause: 1500 });
</script>
{% endfooterscript %}
