{% set markup %}{% raw %}
<a class="js-text-roll" href="#">About</a>

<!-- letter by letter, or a flip -->
<a class="js-text-roll-letters" href="#">Work</a>
<a class="js-text-roll-flip" href="#">Projects</a>

<!-- after _textRoll(), svgs are left alone -->
<a href="#" data-text-roll>
    <span class="text-roll"><span>About</span></span>
</a>
{% endraw %}{% endset %}

{% set pageScript %}{% raw %}
// Requirements
    // JS
        // split-type (npm)
        // src/assets/js/utils/_textRoll.js
    // CSS
        // src/assets/css/components/text-roll.css

_textRoll('.js-text-roll');

// letter by letter, ms per letter
_textRoll('.js-text-roll-letters', { stagger: 20 });
_textRoll('.js-text-roll-slow', { stagger: 40 });

// each letter turns over like a cube
_textRoll('.js-text-roll-flip', { flip: true, stagger: 30 });

// or any selector, and only inside a part of the page
// _textRoll('footer a, .button-primary', { root: document.querySelector('.js-popup') });
{% endraw %}{% endset %}

{{ scriptUsage({
    markup: markup,
    markupNote: 'Each text gets wrapped in <code class="font-mono text-sm">.text-roll</code>, the target gets <code class="font-mono text-sm">[data-text-roll]</code>. Running it twice skips what is already wrapped.',
    code: pageScript,
    note: '<code class="font-mono text-sm">_textRoll(selector, { root, stagger, flip })</code>. <code class="font-mono text-sm">stagger</code> rolls each letter after the one before, <code class="font-mono text-sm">flip</code> turns each letter over instead, split with split-type, screen readers still get the word. It rolls on hover and keyboard focus. Touch screens and reduced motion keep the text still.'
}) }}

{% footerscript %}
<script type="module">{{ pageScript | safe }}</script>
{% endfooterscript %}
