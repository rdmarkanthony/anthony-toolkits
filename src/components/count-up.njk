---
title: Count up | Anthony Toolkits
---

{% from "components/atoms/component-page.njk" import pageIntro, scriptUsage %}

{{ pageIntro({ label: '_countUp · _inview', title: 'Count up', description: 'Counts a number from one value to another, with commas and optional decimals. For stats that count up on screen, or a price that changes.' }) }}

{% set heading = 'text-3xl font-bold tracking-tight' %}

{% set markup %}{% raw %}
<!-- the html holds the end number, so it reads right without js -->
<p><span class="js-count-up tabular-nums">1,200</span>+ projects</p>
<p><span class="js-count-up tabular-nums" data-decimals="1">4.9</span> rating</p>

<!-- pricing: each price has both values -->
<label><input class="js-billing" type="radio" name="billing" value="monthly" checked /> Monthly</label>
<label><input class="js-billing" type="radio" name="billing" value="yearly" /> Yearly</label>
<p>$<span class="js-price tabular-nums" data-monthly="19" data-yearly="190">19</span></p>
{% endraw %}{% endset %}

<section id="stats" class="px-4 pb-16">
    <div class="mx-auto flex max-w-295 flex-col gap-6">
        <div>
            <h2 class="{{ heading }}">Stats</h2>
            <p class="mt-2 max-w-2xl text-gray-600">Each one counts up from 0 the first time it comes on screen.</p>
        </div>
        <div class="grid grid-cols-2 gap-6 rounded-3xl bg-gray-50 p-8 md:grid-cols-4 md:p-12">
            {% for stat in [
                { value: '1,200', after: '+', label: 'Projects' },
                { value: '98', after: '%', label: 'Happy clients' },
                { value: '15', after: '', label: 'Years' },
                { value: '4.9', after: '/5', label: 'Rating', decimals: 1 }
            ] %}
            <div>
                <p class="text-5xl font-bold tracking-tight md:text-6xl"><span class="js-count-up tabular-nums"{% if stat.decimals %} data-decimals="{{ stat.decimals }}"{% endif %}>{{ stat.value }}</span>{{ stat.after }}</p>
                <p class="mt-2 text-gray-600">{{ stat.label }}</p>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

<section id="pricing" class="bg-gray-50 px-4 py-16">
    <div class="mx-auto flex max-w-295 flex-col gap-6">
        <div>
            <h2 class="{{ heading }}">Pricing</h2>
            <p class="mt-2 max-w-2xl text-gray-600">Switching the billing counts each price from where it is to the new one.</p>
        </div>
        <div class="flex w-fit rounded-full bg-white p-1">
            {% for period in ['monthly', 'yearly'] %}
            <label class="cursor-pointer rounded-full px-5 py-2 font-medium text-gray-600 transition-colors has-checked:bg-gray-950 has-checked:text-white">
                <input class="js-billing sr-only" type="radio" name="billing" value="{{ period }}"{% if loop.first %} checked{% endif %} />
                {{ period | capitalize }}
            </label>
            {% endfor %}
        </div>
        <div class="grid gap-6 md:grid-cols-3">
            {% for plan in [
                { name: 'Starter', monthly: 19, yearly: 190 },
                { name: 'Pro', monthly: 49, yearly: 490 },
                { name: 'Team', monthly: 99, yearly: 990 }
            ] %}
            <div class="flex flex-col gap-4 rounded-3xl bg-white p-8">
                <p class="text-lg font-semibold">{{ plan.name }}</p>
                <p class="text-5xl font-bold tracking-tight">$<span class="js-price tabular-nums" data-monthly="{{ plan.monthly }}" data-yearly="{{ plan.yearly }}">{{ plan.monthly }}</span><span class="js-price-period text-lg font-medium text-gray-500">/mo</span></p>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

{% set pageScript %}{% raw %}
// Requirements
    // JS
        // src/assets/js/utils/_emitter.js
        // src/assets/js/utils/_countUp.js
        // src/assets/js/utils/_inview.js (to start on screen)

// stats: count from 0 to the number in the html, once on screen
document.querySelectorAll('.js-count-up').forEach((target) => {
    const _to = parseFloat(target.textContent.replace(/,/g, ''));
    target.textContent = '0';

    new _inview({
        target,
        callback: () => new _countUp({ target, to: _to, decimals: Number(target.dataset.decimals) || null, duration: 2000 }),
    });
});

// pricing: from the price shown to the other billing's
const _prices = document.querySelectorAll('.js-price');
document.querySelectorAll('.js-billing').forEach((input) => {
    input.addEventListener('change', () => {
        _prices.forEach((target) => {
            new _countUp({
                target,
                from: parseFloat(target.textContent.replace(/,/g, '')),
                to: Number(target.dataset[input.value]),
                duration: 400,
                // events: { update: (count) => console.log(count.value), complete: () => console.log('done') },
            });
        });
        document.querySelectorAll('.js-price-period').forEach((period) => (period.textContent = input.value === 'yearly' ? '/yr' : '/mo'));
    });
});
{% endraw %}{% endset %}

{{ scriptUsage({
    markup: markup,
    code: pageScript,
    note: '<code class="font-mono text-sm">new _countUp({ target, from, to, decimals, duration, events })</code>, the duration in ms. A new count on the same target stops the one running. Events: <code class="font-mono text-sm">update</code> each step (<code class="font-mono text-sm">count.value</code>), <code class="font-mono text-sm">complete</code>.'
}) }}

{% footerscript %}
<script type="module">{{ pageScript | safe }}</script>
{% endfooterscript %}
