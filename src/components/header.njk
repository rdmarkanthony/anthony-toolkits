<!-- the header takes no space, so the first section leaves room for it -->
<section class="pt-28">...</section>
{% endset %}

{% set sticky %}{% raw %}
<!-- 0 while the header is hidden, its height while shown -->
<div class="sticky top-(--header-offset) z-30 transition-[top] duration-500">...</div>

<!-- or the full height, e.g. a screen tall section below it -->
<div class="h-[calc(100svh-var(--header-height,0px))]">...</div>
{% endraw %}{% endset %}

<section class="px-4 pb-16">
    <div class="mx-auto flex max-w-295 flex-col gap-6">
        <div>
            <h2 class="text-3xl font-bold tracking-tight">Desktop</h2>
            <p class="mt-2 text-gray-600">Scroll inside the box. Past the header it turns fixed, hidden above, and slides in when you scroll up.</p>
        </div>
        <iframe class="h-[36rem] w-full rounded-3xl border border-gray-200" src="/components/header/demo/" title="Header demo, desktop" loading="lazy"></iframe>
    </div>
</section>

<section class="bg-gray-50 px-4 py-16">
    <div class="mx-auto grid max-w-295 items-center gap-10 lg:grid-cols-[1fr_auto]">
        <div class="flex flex-col gap-6">
            <h2 class="text-3xl font-bold tracking-tight">Mobile menu</h2>
            <ul class="flex max-w-md flex-col gap-2 text-gray-600">
                <li>Opens from the burger, closes with the X, the shade, a link or Esc.</li>
                <li>The page behind can't scroll or take focus.</li>
                <li>Focus goes back to the burger on close.</li>
            </ul>
        </div>
        <div class="h-[40rem] w-[23rem] max-w-full justify-self-center overflow-hidden rounded-[2.5rem] border-10 border-gray-950 bg-white">
            <iframe class="size-full" src="/components/header/demo/" title="Header demo, phone" loading="lazy"></iframe>
        </div>
    </div>
</section>

<section class="px-4 py-16">
    <div class="mx-auto flex max-w-295 flex-col gap-6">
        <div>
            <h2 class="text-3xl font-bold tracking-tight">Something above it</h2>
            <p class="mt-2 max-w-2xl text-gray-600">A notice and a bar sit above the header. Close the notice and the header moves up with it. It turns fixed only once it has scrolled out, and back at its own spot.</p>
        </div>
        <iframe class="h-[36rem] w-full rounded-3xl border border-gray-200" src="/components/header/demo/top-bar/" title="Header demo, top bar" loading="lazy"></iframe>
    </div>
</section>

<section class="bg-gray-50 px-4 py-16">
    <div class="mx-auto flex max-w-295 flex-col gap-6">
        <div>
            <h2 class="text-3xl font-bold tracking-tight">Sticky below it</h2>
            <p class="mt-2 max-w-2xl text-gray-600">The filters stick at <code class="font-mono text-sm">--header-offset</code>, so they move up when the header hides and down when it comes back.</p>
        </div>
        <iframe class="h-[36rem] w-full rounded-3xl border border-gray-200 bg-white" src="/components/header/demo/sticky/" title="Header demo, sticky" loading="lazy"></iframe>
    </div>
</section>

