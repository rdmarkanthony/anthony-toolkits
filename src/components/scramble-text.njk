{% set pageScript %}{% raw %}
// Requirements
    // JS
        // src/assets/js/utils/_emitter.js
        // src/assets/js/utils/_scrambleText.js

// hover
document.querySelectorAll('.js-scramble-hover').forEach((target) => {
    new _scrambleText({
        target,
        // defaults: hover: true, duration: 400, speed: 40, order: 'start', chars: the text's own letters
        order: target.dataset.order,
        chars: target.dataset.chars,
    });
});

// plays on its own, no hover
const _interval = new _scrambleText({ target: document.querySelector('.js-scramble-interval'), hover: false });
setInterval(() => _interval.play(), 3000);

// a new word after each one settles
const _words = ['design', 'build', 'ship'];
let _index = 0;

new _scrambleText({
    target: document.querySelector('.js-scramble-words'),
    hover: false,
    events: {
        complete: (instance) => {
            _index = (_index + 1) % _words.length;
            setTimeout(() => instance.play(_words[_index]), 1500);
        },
    },
}).play();

// methods and events
const _log = document.querySelector('.js-scramble-log');
const _control = new _scrambleText({
    target: document.querySelector('.js-scramble-control'),
    hover: false,
    duration: 1500,
    events: {
        start: () => (_log.textContent = 'start'),
        // instance.progress goes 0 to 1
        update: (instance) => (_log.textContent = `update, ${Math.round(instance.progress * 100)}%`),
    },
});
_control.on('complete', () => (_log.textContent = 'complete'));
window._control = _control; // for trying it in the console

document.querySelector('.js-scramble-play').addEventListener('click', () => _control.play());
document.querySelector('.js-scramble-new').addEventListener('click', () => _control.play(_control.text === 'New text' ? 'Press play' : 'New text'));
document.querySelector('.js-scramble-stop').addEventListener('click', () => _control.stop());
{% endraw %}{% endset %}

