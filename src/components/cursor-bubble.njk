---
title: Cursor bubble | Anthony Toolkits
---

{% from "components/atoms/component-page.njk" import pageIntro, scriptUsage %}
{% from "components/atoms/icon.njk" import external, angle, search %}

{{ pageIntro({ label: '_cursorBubble', title: 'Cursor bubble', description: 'A dot that trails the mouse. It grows over big type, shows a label over cards and sticks to buttons. Mouse only, off on touch screens.' }) }}

<section class="px-4 pb-4">
    <div class="mx-auto grid max-w-295 gap-4 md:grid-cols-3">
        <div class="flex min-h-72 flex-col justify-end gap-4 rounded-3xl bg-gray-100 p-8 md:col-span-2">
            <h2 class="text-3xl font-bold tracking-tight">Default</h2>
            <p class="max-w-sm text-gray-600">A dot that inverts what's under it.</p>
            <button class="w-fit cursor-pointer rounded-full bg-white px-5 py-2 font-medium transition-colors hover:bg-gray-950 hover:text-white" type="button" data-cursor="hidden">No dot on me</button>
        </div>
        <div class="flex min-h-72 flex-col justify-end gap-4 rounded-3xl bg-gray-950 p-8 text-white">
            <h2 class="text-3xl font-bold tracking-tight">Dark</h2>
            <p class="text-gray-400">Works on any background.</p>
        </div>
        <div class="rounded-3xl bg-gray-100 p-8 md:col-span-3" data-cursor="grow">
            <p class="text-5xl leading-none font-bold tracking-tight md:text-8xl">Big type, bigger dot.</p>
        </div>
    </div>
</section>

<section class="px-4 pt-12">
    <div class="mx-auto max-w-295">
        <h2 class="mb-2 text-3xl font-bold tracking-tight">Sticky</h2>
        <p class="mb-8 max-w-2xl text-gray-600">Over a button the dot takes its shape and stays on it, still leaning toward the mouse.</p>
        <div class="flex flex-wrap items-center gap-x-10 gap-y-6 rounded-3xl border border-gray-200 px-6 py-16 md:px-16">
            <nav class="flex flex-wrap gap-2">
                {% for link in ['Work', 'Studio', 'Contact'] %}
                <a class="rounded-full px-4 py-2 font-medium" href="#" data-cursor-stick="4">{{ link }}</a>
                {% endfor %}
            </nav>
            <a class="inline-flex h-14 items-center rounded-full bg-gray-950 px-8 font-medium text-white" href="#" data-cursor-stick>Get in touch</a>
            <div class="flex gap-3">
                <a class="flex size-12 items-center justify-center rounded-full border border-gray-300" href="#" data-cursor-stick="6" aria-label="Search">{{ search() }}</a>
                <a class="flex size-12 items-center justify-center rounded-xl border border-gray-300" href="#" data-cursor-stick="6" aria-label="Next">{{ angle('right') }}</a>
            </div>
        </div>
    </div>
</section>

{% set cards = [
    { title: 'Text', text: 'View project', bg: 'bg-sky-200' },
    { title: 'Icon', text: 'Visit', icon: '#cursor-arrow', bg: 'bg-amber-200' },
    { title: 'Emoji', text: '👀', bg: 'bg-emerald-200' },
    { title: 'Own state', text: 'Open', bg: 'bg-rose-200', state: 'blue' }
] %}
<template id="cursor-arrow">{{ external() }}</template>
<section class="px-4 pt-12 pb-16">
    <div class="mx-auto max-w-295">
        <h2 class="mb-2 text-3xl font-bold tracking-tight">Labels</h2>
        <p class="mb-8 max-w-2xl text-gray-600">Text, an icon, an emoji, and a blue label from its own state.</p>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {% for card in cards %}
            <a class="flex aspect-4/3 items-end rounded-3xl {{ card.bg }} p-6 text-xl font-bold" href="#" data-cursor-text="{{ card.text }}"{% if card.icon %} data-cursor-icon="{{ card.icon }}"{% endif %}{% if card.state %} data-cursor="{{ card.state }}"{% endif %}>{{ card.title }}</a>
            {% endfor %}
        </div>
    </div>
</section>

{% set markup %}{% raw %}
<!-- a bigger dot -->
<h2 data-cursor="grow">...</h2>

<!-- a label next to the dot -->
<a data-cursor-text="View project">...</a>

<!-- an icon from a template, text optional, emoji are text -->
<template id="cursor-arrow"><svg>...</svg></template>
<a data-cursor-icon="#cursor-arrow" data-cursor-text="Visit">...</a>
<a data-cursor-text="👀">...</a>

<!-- the dot sticks to it in its shape, 4px bigger each side -->
<a class="rounded-full" data-cursor-stick="4">...</a>

<!-- no dot over this -->
<button data-cursor="hidden">...</button>

<!-- your own state, style it in classes -->
<a data-cursor="blue" data-cursor-text="Open">...</a>
{% endraw %}{% endset %}

{% set pageScript %}{% raw %}
// Requirements
    // JS
        // src/assets/js/utils/_cursorBubble.js

// once per page, or just new _cursorBubble()
new _cursorBubble({
    ease: 0.2, // 1 follows with no delay
    pull: 0.15, // how far a stuck dot still follows the mouse
    // a "blue" state on top of the default look
    classes: {
        label: `${_cursorBubble.classes.label} group-data-[state=blue]:bg-blue-600`,
    },
});
{% endraw %}{% endset %}

{{ scriptUsage({
    markup: markup,
    markupNote: 'Only attributes, the script makes the dot.',
    code: pageScript,
    note: 'A stuck dot takes the element\'s size and border radius, and the bubble gets <code class="font-mono text-sm">data-stuck</code>. Style a state with <code class="font-mono text-sm">group-data-[state=name]:</code>. The default look is in <code class="font-mono text-sm">_cursorBubble.classes</code>.'
}) }}

{% footerscript %}
<script type="module">{{ pageScript | safe }}</script>
{% endfooterscript %}
