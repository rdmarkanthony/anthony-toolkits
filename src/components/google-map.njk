        <h2 class="text-3xl font-bold tracking-tight">One pin, dark theme</h2>
        <div class="js-contact-map grid aspect-square place-items-center overflow-hidden rounded-2xl bg-gray-100 sm:aspect-[21/9]" data-api-key="{{ site.googleMapsKey }}">{{ noKey | safe }}</div>
    </div>
</section>

{% set pageScript %}{% raw %}
// Requirements
    // JS
        // src/assets/js/utils/_emitter.js
        // src/assets/js/utils/_accordion.js
        // src/assets/js/utils/_googleMap.js

// JSON themes from mapstyle.withgoogle.com or snazzymaps.com, null is Google's own look
const _themes = {
    light: [
        { elementType: 'geometry', stylers: [{ color: '#f3f4f6' }] },
        { elementType: 'labels.icon', stylers: [{ visibility: 'off' }] },
        { elementType: 'labels.text.fill', stylers: [{ color: '#6b7280' }] },
        { elementType: 'labels.text.stroke', stylers: [{ color: '#f3f4f6' }] },
        { featureType: 'administrative', elementType: 'geometry.stroke', stylers: [{ color: '#d1d5db' }] },
        { featureType: 'poi', stylers: [{ visibility: 'off' }] },
        { featureType: 'road', elementType: 'geometry', stylers: [{ color: '#ffffff' }] },
        { featureType: 'road.highway', elementType: 'geometry', stylers: [{ color: '#e5e7eb' }] },
        { featureType: 'transit', stylers: [{ visibility: 'off' }] },
        { featureType: 'water', elementType: 'geometry', stylers: [{ color: '#cbd5e1' }] },
    ],
    dark: [
        { elementType: 'geometry', stylers: [{ color: '#1f2937' }] },
        { elementType: 'labels.icon', stylers: [{ visibility: 'off' }] },
        { elementType: 'labels.text.fill', stylers: [{ color: '#9ca3af' }] },
        { elementType: 'labels.text.stroke', stylers: [{ color: '#111827' }] },
        { featureType: 'administrative', elementType: 'geometry.stroke', stylers: [{ color: '#4b5563' }] },
        { featureType: 'poi', stylers: [{ visibility: 'off' }] },
        { featureType: 'road', elementType: 'geometry', stylers: [{ color: '#374151' }] },
        { featureType: 'road.highway', elementType: 'geometry', stylers: [{ color: '#4b5563' }] },
        { featureType: 'transit', stylers: [{ visibility: 'off' }] },
        { featureType: 'water', elementType: 'geometry', stylers: [{ color: '#0f172a' }] },
    ],
    default: null,
};

const _lastEvent = document.querySelector('.js-map-event');

// places: the map and the accordion follow the same pick
const _places = document.querySelector('.js-places');
const _placeButtons = [..._places.querySelectorAll('.js-place')];
const _countries = new _accordion({ target: _places.querySelector('.js-accordion'), openFirst: false });
const _mapTarget = _places.querySelector('.js-google-map');

const _mark = (id) => _placeButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.id === id)));
const _reveal = (button) => button?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

const _placeMap = new _googleMap({
    target: _mapTarget,
    apiKey: _mapTarget.dataset.apiKey,
    styles: _themes.light,
    selectZoom: 15,
    markers: _placeButtons.map(({ dataset }) => ({ id: dataset.id, title: dataset.title, lat: Number(dataset.lat), lng: Number(dataset.lng) })),
    // a star badge, warm and pulsing when picked
    render: () => `
        <span class="relative flex flex-col items-center drop-shadow-md">
            <span class="absolute top-0 size-9 rounded-full bg-rose-400/60 opacity-0 in-aria-pressed:animate-ping in-aria-pressed:opacity-100"></span>
            <span class="relative grid size-9 place-items-center rounded-full border-[3px] border-white bg-linear-to-br from-sky-400 to-indigo-600 text-white in-aria-pressed:from-amber-400 in-aria-pressed:to-rose-500">
                <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg>
            </span>
            <span class="-mt-2 mb-[2.5px] size-3 rotate-45 border-r-[3px] border-b-[3px] border-white bg-indigo-600 in-aria-pressed:bg-rose-500"></span>
        </span>`,
    events: {
        select: (instance) => {
            const _button = _placeButtons.find((item) => item.dataset.id === instance.item.id);
            const _set = _button.closest('.js-accordion-set');
            _mark(instance.item.id);

            // a closed country scrolls to it once open, see _countries.on('open')
            if (_countries.isOpen(_set)) _reveal(_button);
            else _countries.open(_set);
            _lastEvent.textContent = `select, ${instance.item.title}`;
        },
        deselect: (instance) => {
            _mark(null);
            instance.reset();
            _lastEvent.textContent = 'deselect';
        },
    },
});

_countries.on('open', (instance) => _reveal(instance.item.querySelector('.js-place[aria-pressed="true"]')));
_placeButtons.forEach((button) => button.addEventListener('click', () => _placeMap.select(button.dataset.id)));

// opening a country picks its first place, closing it lets go
_places.querySelectorAll('.js-accordion-set-title').forEach((title) => {
    title.addEventListener('click', () => {
        const _set = title.closest('.js-accordion-set');
        const _picked = _set.querySelector('.js-place[aria-pressed="true"]');

        if (!_countries.isOpen(_set)) return _picked && _placeMap.deselect();
        if (!_picked) _placeMap.select(_set.querySelector('.js-place').dataset.id);
    });
});

const _themeButtons = [...document.querySelectorAll('[data-map-theme]')];
_themeButtons.forEach((button) => {
    button.addEventListener('click', () => {
        _placeMap.setStyles(_themes[button.dataset.mapTheme]);
        _themeButtons.forEach((each) => each.setAttribute('aria-pressed', String(each === button)));
    });
});

// contact: one pin, its popup open
const _contactTarget = document.querySelector('.js-contact-map');

new _googleMap({
    target: _contactTarget,
    apiKey: _contactTarget.dataset.apiKey,
    styles: _themes.dark,
    zoom: 15,
    markers: [{ id: 'times-square', title: 'Times Square', lat: 40.758, lng: -73.9855, popup: '<p class="font-semibold">Times Square</p><p class="text-gray-600">Broadway and 7th Avenue, New York, NY 10036</p>' }],
    events: {
        ready: (instance) => instance.select('times-square'),
    },
});
{% endraw %}{% endset %}

{{ scriptUsage({
    markup: markup,
    markupNote: 'Give the map element a size. The key goes on the markup here so the script stays the same in every project.',
    code: pageScript,
    note: '<code class="font-mono text-sm">new _googleMap({ target, apiKey, markers, center, zoom, selectZoom, styles, render, anchor, classes, options, lazy, events })</code>. Markers are <code class="font-mono text-sm">{ id, lat, lng, title, popup }</code> plus any data for <code class="font-mono text-sm">render</code>; <code class="font-mono text-sm">popup</code> is html. Without <code class="font-mono text-sm">center</code> the map fits every marker. Methods: <code class="font-mono text-sm">select(id)</code> (the selected one again zooms back in on it), <code class="font-mono text-sm">focus()</code>, <code class="font-mono text-sm">deselect()</code>, <code class="font-mono text-sm">reset()</code>, <code class="font-mono text-sm">fit()</code>, <code class="font-mono text-sm">zoomTo(zoom, position)</code>, <code class="font-mono text-sm">setMarkers(list)</code>, <code class="font-mono text-sm">setStyles(styles)</code>, <code class="font-mono text-sm">destroy()</code>. Events: <code class="font-mono text-sm">ready</code>, <code class="font-mono text-sm">select</code>, <code class="font-mono text-sm">deselect</code>, <code class="font-mono text-sm">error</code>; <code class="font-mono text-sm">instance.map</code> is the google.maps.Map. Restrict the key to your site in Google Cloud, it is public in the page.'
}) }}

{% footerscript %}
<script type="module">{{ pageScript | safe }}</script>
{% endfooterscript %}
