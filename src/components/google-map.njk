{% set noKey %}
{% if not site.googleMapsKey %}
<p class="max-w-xs p-6 text-center text-sm text-gray-500">Add a Maps JavaScript API key as <code class="font-mono">googleMapsKey</code> in src/_data/site.js to see the map.</p>
{% endif %}
{% endset %}

{% set markup %}{% raw %}
<!-- a map on its own, give it a size -->
<div class="js-google-map aspect-video" data-api-key="YOUR_API_KEY"></div>

<!-- places: a sticky map, and an accordion of countries holding the places -->
<div class="js-places grid lg:grid-cols-2">
    <div class="js-google-map sticky top-0 h-[35svh] lg:h-svh" data-api-key="YOUR_API_KEY"></div>
    <div class="js-accordion">
        <div class="js-accordion-set">
            <button class="js-accordion-set-title" type="button">Singapore</button>
            <div class="js-accordion-set-content" hidden="until-found">
                <!-- each place is a button with its marker data, aria-pressed when picked -->
                <button class="js-place" type="button" aria-pressed="false" data-id="merlion-park" data-title="Merlion Park" data-lat="1.2868" data-lng="103.8545">Merlion Park</button>
            </div>
        </div>
    </div>
</div>
{% endraw %}{% endset %}

{% set title = 'js-accordion-set-title group flex w-full cursor-pointer items-center justify-between gap-6 px-5 py-4 text-left text-lg font-semibold transition-colors hover:text-gray-600' %}
{% set chevron = '<svg class="size-5 shrink-0 transition-transform duration-300 group-aria-expanded:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>' %}

{# demo: tourist spots by country, the map and the accordion follow the same pick #}
<section class="px-4 py-16">
    <div class="mx-auto flex max-w-295 flex-col gap-6">
        <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
                <h2 class="text-3xl font-bold tracking-tight">Places to visit</h2>
                <p class="mt-2 font-mono text-sm text-gray-500">last event: <span class="js-map-event">-</span></p>
            </div>
            <div class="flex flex-wrap gap-2">
                {% for theme in ['light', 'dark', 'default'] %}
                <button class="cursor-pointer rounded-full border border-gray-300 px-4 py-1.5 text-sm font-medium capitalize transition-colors hover:border-gray-950 aria-pressed:border-gray-950 aria-pressed:bg-gray-950 aria-pressed:text-white" type="button" data-map-theme="{{ theme }}" aria-pressed="{{ 'true' if theme == 'light' else 'false' }}">{{ theme }}</button>
                {% endfor %}
            </div>
        </div>
        <div class="js-places grid items-start gap-6 lg:grid-cols-[1fr_20rem]">
            <div class="sticky top-[var(--header-height,0px)] z-10 -mx-4 h-[35svh] bg-white lg:top-[calc(var(--header-height,0px)+1.5rem)] lg:mx-0 lg:h-[calc(100svh-var(--header-height,0px)-3rem)]">
                <div class="js-google-map grid size-full place-items-center overflow-hidden bg-gray-100 lg:rounded-2xl" data-api-key="{{ site.googleMapsKey }}">{{ noKey | safe }}</div>
            </div>
            <div class="js-accordion border-t border-gray-200">
                {% for country in countries %}
                <div class="js-accordion-set border-b border-gray-200">
                    <button class="{{ title }}" type="button">
                        <span>{{ country.name }} <span class="ml-1 font-mono text-sm font-normal text-gray-500">{{ country.places | length }}</span></span>
                        {{ chevron | safe }}
                    </button>
                    <div class="js-accordion-set-content" hidden="until-found">
                        <ul class="grid gap-1 pb-4">
                            {% for place in country.places %}
                            <li>
                                <button class="js-place w-full scroll-mt-[calc(35svh+var(--header-height,0px)+1rem)] cursor-pointer rounded-xl px-5 py-3 text-left transition-colors hover:bg-gray-50 aria-pressed:bg-gray-950 aria-pressed:text-white lg:scroll-mt-[calc(var(--header-height,0px)+1.5rem)]" type="button" aria-pressed="false" data-id="{{ place.id }}" data-title="{{ place.title }}" data-lat="{{ place.lat }}" data-lng="{{ place.lng }}">
                                    <span class="block font-medium">{{ place.title }}</span>
                                    <span class="block text-sm opacity-60">{{ place.about }}</span>
                                </button>
                            </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>

{# demo: one pin with its popup open, like a contact page #}
