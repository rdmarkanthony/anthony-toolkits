{% set markup %}{% raw %}
<!-- the text inside is the line when there's no lines option -->
<h2 class="js-typing-hero">I'm a Front-End Developer</h2>

<!-- after _typing, the label is for screen readers -->
<h2 class="js-typing-hero">
    <span class="typing-label">I'm a Front-End Developer</span>
    <span class="typing" aria-hidden="true">
        <span class="typing-ghost">...</span>
        <span>
            <span class="typing-text">...</span>
            <span class="typing-cursor"></span>
        </span>
    </span>
</h2>
{% endraw %}{% endset %}

{% set pageScript %}{% raw %}
// Requirements
    // JS
        // src/assets/js/utils/_emitter.js
        // src/assets/js/utils/_typing.js
    // CSS
        // src/assets/css/components/typing.css

// lines are strings, or parts with their own class, "\n" breaks
const _name = 'text-emerald-400';
new _typing({
    target: document.querySelector('.js-typing-hero'),
    // defaults: speed: 60, eraseSpeed: 28, pause: 2000, gap: 350, delay: 0, loop: false, autoplay: true, cursor: true
    lines: [
        [{ text: "Hi, I'm\n" }, { text: 'Mark Anthony Recto', className: _name }],
        [{ text: 'You can call me\n' }, { text: 'Anthony', className: _name }],
        [{ text: "I'm a\n" }, { text: 'Front-End Developer', className: _name }],
    ],
    delay: 500,
});

new _typing({
    target: document.querySelector('.js-typing-loop'),
    lines: ['design', 'build', 'ship'],
    loop: true,
    pause: 1500,
});

// methods and events
const _log = document.querySelector('.js-typing-log'); // demo
const _control = new _typing({
    target: document.querySelector('.js-typing-control'),
    lines: ['Press a button', 'Second line', 'Last line'],
    autoplay: false,
    events: {
        // type: (instance) => console.log('type', instance.index),
        // erase: () => console.log('erase'),
        type: (instance) => (_log.textContent = `type, line ${instance.index}`), // demo
        erase: () => (_log.textContent = 'erase'), // demo
    },
});
// more listeners with on()
// _control.on('complete', () => console.log('complete'));
_control.on('complete', () => (_log.textContent = 'complete')); // demo
window._control = _control; // demo

document.querySelector('.js-typing-play').addEventListener('click', () => _control.play());
document.querySelector('.js-typing-type').addEventListener('click', () => _control.type('Something new'));
document.querySelector('.js-typing-erase').addEventListener('click', () => _control.erase());
document.querySelector('.js-typing-stop').addEventListener('click', () => _control.stop());
{% endraw %}{% endset %}

