{% set pageScript %}{% raw %}
// Requirements
    // JS
        // lottie-web (npm, its own chunk, loaded when needed)
        // src/assets/js/utils/_emitter.js
        // src/assets/js/utils/_lottie.js
        // src/assets/js/utils/_inview.js

const _list = document.querySelector('.js-food-list');
const _template = document.querySelector('.js-food-template');
const _loading = document.querySelector('.js-food-loading');
const _more = document.querySelector('.js-food-more');
const _perPage = 6;
let _page = 0;

// the cook loops while it shows
const _loader = new _lottie({ target: document.querySelector('.js-food-loader'), play: 'none' });
_loader.ready.then((animation) => animation.setLoop(true));

const _toggleLoading = async (on) => {
    _loading.toggleAttribute('data-on', on);
    _list.setAttribute('aria-busy', String(on));
    const _animation = await _loader.ready;
    if (!_loader.reduce) on ? _animation.play() : _animation.pause();
};

const _addFood = (food, index) => {
    const _item = _template.content.firstElementChild.cloneNode(true);
    _item.style.transitionDelay = `${index * 100}ms`;
    _item.querySelector('.js-food-name').textContent = food.label;
    _item.querySelector('.js-food-text').textContent = food.text;
    _item.querySelector('.js-food-price').textContent = `$${food.price}`;
    _list.append(_item);

    // plays once as it comes in, again on hover
    // rest stops it on a full frame, some foods get eaten by the end
    const _emoji = new _lottie({ target: _item.querySelector('.js-food-emoji'), src: `/assets/lottie/emoji-${food.emoji}.json`, play: 'none' });
    const _play = async () => {
        const _animation = await _emoji.ready;
        if (_emoji.reduce) return _emoji.seek(food.rest ?? 1);
        _animation.playSegments([0, Math.round((food.rest ?? 1) * _animation.animationData.op)], true);
    };
    new _inview({ target: _item, callback: _play });
    _item.addEventListener('pointerenter', _play);
};

const _loadFoods = async () => {
    _more.disabled = true;
    // a quick fetch never shows the loader
    const _timer = setTimeout(() => _toggleLoading(true), 300);

    try {
        // a real api sends one page, here the file is sliced
        const _foods = await fetch('/assets/data/foods.json').then((response) => response.json());
        // demo only: a slow network
        await new Promise((resolve) => setTimeout(resolve, 1200));

        _foods.slice(_page * _perPage, ++_page * _perPage).forEach(_addFood);
        if (_page * _perPage >= _foods.length) {
            _more.hidden = true;
            document.querySelector('.js-food-done').hidden = false;
        }
    } finally {
        clearTimeout(_timer);
        _toggleLoading(false);
        _more.disabled = false;
    }
};

_more.addEventListener('click', _loadFoods);
_loadFoods();
{% endraw %}{% endset %}

