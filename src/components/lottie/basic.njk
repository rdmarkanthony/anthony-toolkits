{{ pageIntro({ back: { label: 'Lottie', url: '/components/lottie/' }, label: '_lottie · lottie-web', title: 'Basic', description: 'Put a lottie on the page, set how it plays, and control it from your own script.' }) }}

{% set card = 'flex flex-col items-center gap-6 rounded-3xl border border-gray-200 bg-white p-10 text-center' %}
{% set heading = 'text-3xl font-bold tracking-tight' %}
{% set control = 'inline-flex h-11 cursor-pointer items-center rounded-full border border-gray-300 px-5 font-medium transition-colors hover:border-gray-950' %}

{% set markup %}{% raw %}
<!-- the animation is drawn inside, give it a size -->
<div class="js-lottie size-24" data-lottie="/assets/lottie/check.json"></div>

<!-- or no data-lottie, the path goes in the script as src -->
<div class="js-lottie-src size-24"></div>
{% endraw %}{% endset %}

{# demo: the options #}
<section id="options" class="px-4 pb-16">
    <div class="mx-auto flex max-w-295 flex-col gap-6">
        <div>
            <h2 class="{{ heading }}">Options</h2>
            <p class="mt-2 max-w-2xl text-gray-600">Each card is one line of the script below.</p>
        </div>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
            <div class="{{ card }}">
                <div class="js-lottie size-24" data-lottie="/assets/lottie/check.json"></div>
                <p class="text-gray-600"><b class="block font-semibold text-gray-950">Default</b>Plays once on screen, stays on the last frame.</p>
            </div>
            <div class="{{ card }}">
                <div class="js-lottie-loop size-24" data-lottie="/assets/lottie/emoji-party.json"></div>
                <p class="text-gray-600"><b class="block font-semibold text-gray-950">loop: true</b>Loops, pauses while off screen.</p>
            </div>
            <div class="{{ card }}">
                <div class="flex h-24 items-center gap-4">
                    {% for speed in ['0.5', '2'] %}
                    <div class="js-lottie-speed size-16" data-lottie="/assets/lottie/spinner.json" data-speed="{{ speed }}"></div>
                    {% endfor %}
                </div>
                <p class="text-gray-600"><b class="block font-semibold text-gray-950">speed: 0.5, 2</b>Slower or faster, 1 is normal.</p>
            </div>
            <div class="{{ card }}">
                <div class="js-lottie-src size-24"></div>
                <p class="text-gray-600"><b class="block font-semibold text-gray-950">src</b>The path in the script, not in the markup.</p>
            </div>
        </div>
    </div>
</section>

{# demo: your own controls #}
<section id="controls" class="bg-gray-50 px-4 py-16">
    <div class="mx-auto flex max-w-295 flex-col gap-6">
        <div>
            <h2 class="{{ heading }}">Your own controls</h2>
            <p class="mt-2 max-w-2xl text-gray-600"><code class="font-mono text-sm">play: 'none'</code> never plays by itself. Play, pause and drag it from your script.</p>
        </div>
        <div class="flex flex-col items-center gap-8 rounded-3xl bg-white px-6 py-12">
            <div class="js-lottie-player aspect-5/3 w-full max-w-md" data-lottie="/assets/lottie/plane.json"></div>
            <input class="js-lottie-range w-full max-w-md accent-gray-950" type="range" min="0" max="100" value="0" aria-label="Progress" />
            <div class="flex flex-wrap items-center justify-center gap-3">
                <button class="js-lottie-play {{ control }}" type="button">Play</button>
                <button class="js-lottie-pause {{ control }}" type="button">Pause</button>
                <button class="js-lottie-stop {{ control }}" type="button">Stop</button>
            </div>
            <p class="font-mono text-sm text-gray-500">complete: <span class="js-lottie-status">-</span></p>
        </div>
    </div>
</section>

{% set pageScript %}{% raw %}
// Requirements
    // JS
        // lottie-web (npm, its own chunk, loaded when needed)
        // src/assets/js/utils/_emitter.js
        // src/assets/js/utils/_lottie.js

// default: plays once on screen
new _lottie({ target: document.querySelector('.js-lottie') });

// loops, paused while off screen
new _lottie({ target: document.querySelector('.js-lottie-loop'), loop: true });

// 1 is normal speed
document.querySelectorAll('.js-lottie-speed').forEach((target) => new _lottie({ target, loop: true, speed: Number(target.dataset.speed) }));

// the path as src, no data-lottie
new _lottie({ target: document.querySelector('.js-lottie-src'), src: '/assets/lottie/check.json' });

// your own controls: ready gives lottie-web's animation
const _range = document.querySelector('.js-lottie-range');
const _status = document.querySelector('.js-lottie-status');
const _player = new _lottie({
    target: document.querySelector('.js-lottie-player'),
    play: 'none',
    events: { complete: () => (_status.textContent = 'yes') },
});

document.querySelector('.js-lottie-play').addEventListener('click', async () => {
    const _animation = await _player.ready;
    _status.textContent = '-';
    // from the start again once it has ended
    if (_animation.currentFrame >= _animation.totalFrames - 1) _animation.goToAndStop(0, true);
    _animation.play();
});
document.querySelector('.js-lottie-pause').addEventListener('click', async () => (await _player.ready).pause());
document.querySelector('.js-lottie-stop').addEventListener('click', async () => (await _player.ready).stop());

// seek: 0 is the first frame, 1 the last
_range.addEventListener('input', () => _player.seek(_range.value / 100));
_player.ready.then((animation) => {
    animation.addEventListener('enterFrame', () => (_range.value = (animation.currentFrame / (animation.totalFrames - 1)) * 100));
});
{% endraw %}{% endset %}

