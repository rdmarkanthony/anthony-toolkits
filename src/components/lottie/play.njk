{% set card = 'flex flex-col items-center gap-6 rounded-3xl border border-gray-200 bg-white p-10' %}
{% set heading = 'text-3xl font-bold tracking-tight' %}
{% set control = 'flex size-12 cursor-pointer items-center justify-center rounded-full bg-white transition-colors hover:bg-gray-100' %}

{% set markup %}{% raw %}
<!-- hover: the whole card is the trigger -->
<div class="js-lottie-card">
    <span class="js-lottie-emoji block size-20" data-lottie="/assets/lottie/emoji-rocket.json"></span>
    <h3>Launch faster</h3>
</div>

<!-- click: a toggle, aria-pressed follows it -->
<button class="js-lottie-like" type="button" aria-pressed="false">
    <span class="js-lottie-like-icon block size-10" data-lottie="/assets/lottie/heart.json"></span>
    <span class="js-lottie-like-count">24</span>
</button>

<!-- video controls -->
<video class="js-video" src="/assets/video/name.mp4" playsinline loop></video>
<button class="js-video-play" type="button" aria-label="Play" aria-pressed="false">
    <span class="js-video-play-icon block size-8" data-lottie="/assets/lottie/play.json"></span>
</button>
<button class="js-video-mute" type="button" aria-label="Mute" aria-pressed="false">
    <span class="js-video-mute-icon block size-8" data-lottie="/assets/lottie/sound.json"></span>
</button>
{% endraw %}{% endset %}

<section id="hover" class="px-4 pb-16">
    <div class="mx-auto flex max-w-295 flex-col gap-6">
        <div>
            <h2 class="{{ heading }}">Hover</h2>
            <p class="mt-2 max-w-2xl text-gray-600">With <code class="font-mono text-sm">loop: true</code> it loops while hovered, then ends its round when the mouse leaves. Keyboard focus does the same.</p>
        </div>
        <div class="grid gap-6 md:grid-cols-3">
            {% for feature in [
                { emoji: 'rocket', title: 'Launch faster', text: 'From brief to live in weeks, not months.' },
                { emoji: 'party', title: 'Celebrate wins', text: 'Share the good news with the whole team.' },
                { emoji: 'fire', title: 'Stay on trend', text: 'Fresh ideas, picked from what works now.' }
            ] %}
            <div class="js-lottie-card flex flex-col gap-4 rounded-3xl border border-gray-200 bg-white p-8 transition-colors hover:border-gray-950">
                <span class="js-lottie-emoji block size-20" data-lottie="/assets/lottie/emoji-{{ feature.emoji }}.json"></span>
                <h3 class="text-xl font-semibold">{{ feature.title }}</h3>
                <p class="text-gray-600">{{ feature.text }}</p>
            </div>
            {% endfor %}
        </div>
        <div class="flex flex-col gap-4 rounded-3xl bg-gray-50 p-6 md:flex-row md:items-center md:justify-between md:px-12">
            <p class="text-lg font-semibold">How was this post?</p>
            <div class="flex gap-2">
                {% for emoji in ['heart', 'joy', 'wow', 'thumbs-up'] %}
                <button class="js-lottie-reaction flex size-16 cursor-pointer items-center justify-center rounded-full transition-colors hover:bg-white aria-pressed:bg-white aria-pressed:ring-2 aria-pressed:ring-gray-950" type="button" aria-label="{{ emoji | replace('-', ' ') }}" aria-pressed="false">
                    <span class="js-lottie-reaction-icon block size-11" data-lottie="/assets/lottie/emoji-{{ emoji }}.json"></span>
                </button>
                {% endfor %}
            </div>
        </div>
    </div>
</section>

<section id="click" class="bg-gray-50 px-4 py-16">
    <div class="mx-auto flex max-w-295 flex-col gap-6">
        <div>
            <h2 class="{{ heading }}">Click</h2>
            <p class="mt-2 max-w-2xl text-gray-600">Each click plays it forward or back, so it works as a toggle. The <code class="font-mono text-sm">toggle</code> event does the real work.</p>
        </div>
        <div class="grid gap-6 md:grid-cols-2">
            <div class="{{ card }}">
                <button class="js-lottie-like inline-flex h-14 cursor-pointer items-center gap-2 rounded-full border border-gray-200 pr-6 pl-3 font-medium transition-colors hover:border-gray-950" type="button" aria-pressed="false">
                    <span class="js-lottie-like-icon block size-10" data-lottie="/assets/lottie/heart.json"></span>
                    <span class="js-lottie-like-count">24</span>
                </button>
                <p class="text-gray-600">A like, the count follows.</p>
            </div>
            <div class="{{ card }}">
                <button class="js-lottie-menu flex size-14 cursor-pointer items-center justify-center rounded-full bg-gray-950 text-white" type="button" aria-label="Menu" aria-pressed="false">
                    <span class="js-lottie-menu-icon block size-8 [&_path]:stroke-current" data-lottie="/assets/lottie/menu.json"></span>
                </button>
                <p class="text-gray-600">A menu button, lines to an X and back.</p>
            </div>
        </div>
        <div class="overflow-hidden rounded-3xl bg-gray-950">
            <video class="js-video aspect-video w-full cursor-pointer object-cover" src="/assets/video/sample.mp4" playsinline loop preload="metadata"></video>
            <div class="flex items-center gap-3 p-4">
                <button class="js-video-play {{ control }}" type="button" aria-label="Play" aria-pressed="false">
                    <span class="js-video-play-icon block size-8" data-lottie="/assets/lottie/play.json"></span>
                </button>
                <button class="js-video-mute {{ control }}" type="button" aria-label="Mute" aria-pressed="false">
                    <span class="js-video-mute-icon block size-8" data-lottie="/assets/lottie/sound.json"></span>
                </button>
                <p class="ml-auto text-sm text-gray-400">Click the video to play or pause too.</p>
            </div>
        </div>
    </div>
</section>

{% set pageScript %}{% raw %}
// Requirements
    // JS
        // lottie-web (npm, its own chunk, loaded when needed)
        // src/assets/js/utils/_emitter.js
        // src/assets/js/utils/_lottie.js

// hover: the whole card is the trigger
document.querySelectorAll('.js-lottie-card').forEach((trigger) => {
    new _lottie({ target: trigger.querySelector('.js-lottie-emoji'), play: 'hover', loop: true, trigger });
});

// reactions: the same, a click picks one
const _reactions = document.querySelectorAll('.js-lottie-reaction');
_reactions.forEach((trigger) => {
    new _lottie({ target: trigger.querySelector('.js-lottie-reaction-icon'), play: 'hover', loop: true, trigger });
    trigger.addEventListener('click', () => _reactions.forEach((reaction) => reaction.setAttribute('aria-pressed', String(reaction === trigger))));
});

// click: isOn is the state after each click
const _pressed = (trigger, isOn) => trigger.setAttribute('aria-pressed', String(isOn));

// like: the count follows
const _like = document.querySelector('.js-lottie-like');
const _likes = _like.querySelector('.js-lottie-like-count');
new _lottie({
    target: _like.querySelector('.js-lottie-like-icon'),
    play: 'click',
    trigger: _like,
    events: {
        toggle: ({ isOn }) => {
            _pressed(_like, isOn);
            _likes.textContent = Number(_likes.textContent) + (isOn ? 1 : -1);
        },
    },
});

// menu: open your nav in the toggle event
document.querySelectorAll('.js-lottie-menu').forEach((trigger) => {
    new _lottie({ target: trigger.querySelector('.js-lottie-menu-icon'), play: 'click', trigger, events: { toggle: ({ isOn }) => _pressed(trigger, isOn) } });
});

// video: the buttons play and mute it
const _video = document.querySelector('.js-video');
const _playButton = document.querySelector('.js-video-play');
const _muteButton = document.querySelector('.js-video-mute');

const _play = new _lottie({
    target: _playButton.querySelector('.js-video-play-icon'),
    play: 'click',
    trigger: _playButton,
    events: {
        toggle: ({ isOn }) => {
            _pressed(_playButton, isOn);
            isOn ? _video.play() : _video.pause();
        },
    },
});
new _lottie({
    target: _muteButton.querySelector('.js-video-mute-icon'),
    play: 'click',
    trigger: _muteButton,
    events: {
        toggle: ({ isOn }) => {
            _pressed(_muteButton, isOn);
            _video.muted = isOn;
        },
    },
});

// toggle() from code, the icon follows
_video.addEventListener('click', () => _play.toggle());
{% endraw %}{% endset %}

