{% set pageScript %}{% raw %}
// Requirements
    // JS
        // src/assets/js/utils/_device.js

// is-ios is-safari is-mobile on <html>, for CSS fixes
_device.classes();

// in JS
if (_device.os === 'ios') {
    // e.g. an iOS-only fix
}

// show what this device reports
const _list = document.querySelector('.js-device-list');

const _render = () => {
    const _items = { os: _device.os, browser: _device.browser, mobile: _device.mobile, touch: _device.touch, hover: _device.hover };

    _list.innerHTML = Object.entries(_items).map(([key, value]) => `
        <div class="rounded-2xl border border-gray-200 p-5">
            <dt class="font-mono text-sm text-gray-500">_device.${key}</dt>
            <dd class="mt-1 text-2xl font-bold tracking-tight">${value}</dd>
        </div>`).join('');
};

_render();

// touch and hover change when a mouse is plugged in
['(pointer: coarse)', '(hover: hover)'].forEach((query) => window.matchMedia(query).addEventListener('change', _render));

document.querySelector('.js-device-classes').textContent = document.documentElement.className;
document.querySelector('.js-device-ua').textContent = navigator.userAgent;
{% endraw %}{% endset %}

