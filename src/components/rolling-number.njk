{% set pageScript %}{% raw %}
const _wrap = document.querySelector('.js-rolling-number');
const _label = _wrap.querySelector('.js-rolling-number-label');
const _input = _wrap.querySelector('input');

const _cleanNumber = (value) => value.replace(/,/g, '').replace(/[^0-9.]/g, '');

// one _rollingNumber per character
const _digits = [];
let _rolling = false;

const _update = (value) => {
    if (_rolling) return;
    _rolling = true;

    const _characters = value.toLocaleString('en-US', value % 1 !== 0 ? { minimumFractionDigits: 2, maximumFractionDigits: 2 } : {}).split('');

    // hide the extra digits
    _digits.forEach((digit, index) => {
        digit.target.style.display = index >= _characters.length ? 'none' : 'block';
    });

    // add digits when needed, numeric: false to also roll commas and points
    _characters.forEach((character, index) => {
        if (_digits[index]) return;

        const _div = document.createElement('div');
        _label.appendChild(_div);
        _digits.push(new _rollingNumber({ target: _div, numeric: false }));
    });

    // roll each digit
    _characters.forEach((character, index) => {
        const _digit = _digits[index];

        _digit.roll({
            from: _digit.currentNumber,
            to: character,
            duration: 1000,
            callback: () => (_rolling = false),
        });
    });
};

// only numbers, one decimal point and 2 decimals, with commas
_input.addEventListener('input', () => {
    const _parts = _cleanNumber(_input.value).split('.');
    const _integer = _parts[0] ? Number(_parts[0]).toLocaleString() : '';
    const _decimal = _parts.length > 1 ? '.' + _parts.slice(1).join('').slice(0, 2) : '';

    _input.value = _integer + _decimal;
});

// roll to the entered number
_wrap.querySelector('form').addEventListener('submit', (e) => {
    e.preventDefault();

    const _value = parseFloat(_cleanNumber(_input.value));
    if (!isNaN(_value)) _update(_value);
});

// roll when it scrolls into view
new _inview({
    target: _label,
    delay: 500,
    callback: () => {
        _label.innerHTML = '';
        _update(123456789.1);
    },
});
{% endraw %}{% endset %}

