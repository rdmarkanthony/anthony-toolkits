{% set pageScript %}{% raw %}
// Requirements
    // JS
        // src/assets/js/utils/_emitter.js
        // src/assets/js/utils/_event.js
        // src/assets/js/utils/_rollingDigit.js
        // src/assets/js/utils/_inview.js (to start on screen)

// rolls a whole number: one _rollingDigit per character, numeric: false rolls commas and dots too
const _digits = new WeakMap();
const _roll = (target, text) => {
    if (!_digits.has(target)) {
        target.textContent = '';
        _digits.set(target, []);
    }
    const _list = _digits.get(target);
    const _characters = text.split('');

    // add digits as the number grows, hide the extras as it shrinks
    while (_list.length < _characters.length) {
        const _div = document.createElement('div');
        target.append(_div);
        _list.push(new _rollingDigit({ target: _div, numeric: false }));
    }
    _list.forEach((digit, index) => (digit.target.hidden = index >= _characters.length));

    // resolves once every digit has landed
    return Promise.all(_characters.map((character, index) => _list[index].roll({ to: character, duration: 1000 })));
};

// on screen: zeros first, then the number from the html
document.querySelectorAll('.js-rolling-digit').forEach((target) => {
    const _text = target.textContent.trim();
    _roll(target, _text.replace(/\d/g, '0'));
    new _inview({ target, callback: () => _roll(target, _text) });
});

// cart total: rolls when the amount changes
const _price = 249;
const _amount = document.querySelector('.js-cart-amount');
const _total = document.querySelector('.js-cart-total');
const _less = document.querySelector('.js-cart-less');
const _more = document.querySelector('.js-cart-more');

const _setAmount = (amount) => {
    _amount.textContent = amount;
    _less.disabled = amount <= 1;
    _more.disabled = amount >= 20;
    _roll(_total, (_price * amount).toLocaleString('en-US', { minimumFractionDigits: 2 }));
};
_less.addEventListener('click', () => _setAmount(Number(_amount.textContent) - 1));
_more.addEventListener('click', () => _setAmount(Number(_amount.textContent) + 1));
_setAmount(1);
{% endraw %}{% endset %}

