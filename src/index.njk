---
layout: base.njk
title: Anthony Toolkits
---

<section class="border-b border-slate-200 bg-slate-950 px-4 py-16 text-white md:py-24">
    <div class="container mx-auto">
        <h1 class="text-4xl font-semibold md:text-6xl">{{ site.name }}</h1>
        <p class="mt-4 max-w-xl text-lg text-slate-300">{{ site.description }}</p>
        <label class="mt-8 block max-w-md">
            <span class="sr-only">Search components</span>
            <input class="w-full rounded-md border border-slate-700 bg-slate-900 px-4 py-3 text-white placeholder:text-slate-500 focus:border-slate-400 focus:outline-none" type="search" placeholder="Search components…" autocomplete="off" data-filter-input />
        </label>
    </div>
</section>

<section id="components" class="scroll-mt-20 px-4 py-14 md:py-20">
    <div class="container mx-auto space-y-12">
        {% for group in components %}
            <div data-filter-group>
                <h2 class="text-xs font-semibold tracking-wider text-slate-500 uppercase">{{ group.category }}</h2>
                <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4">
                    {% for item in group.items %}
                        <li data-filter-item="{{ item.label }} {{ item.description }} {{ group.category }}">
                            {% if item.ready %}
                                <a class="block h-full rounded-lg border border-slate-200 p-5 transition hover:-translate-y-0.5 hover:border-slate-400 hover:shadow-sm" href="{{ item.url }}">
                                    <span class="font-medium text-slate-900">{{ item.label }}</span>
                                    <span class="mt-1 block text-sm text-slate-600">{{ item.description }}</span>
                                </a>
                            {% else %}
                                <div class="h-full rounded-lg border border-dashed border-slate-200 p-5">
                                    <div class="flex items-start justify-between gap-2">
                                        <span class="font-medium text-slate-400">{{ item.label }}</span>
                                        <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-500">Soon</span>
                                    </div>
                                    <span class="mt-1 block text-sm text-slate-400">{{ item.description }}</span>
                                </div>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% endfor %}
        <p class="hidden text-slate-500" data-filter-empty>No components match your search.</p>
    </div>
</section>
