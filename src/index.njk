---
layout: base.njk
title: Anthony Toolkits
---

{% from "components/atoms/icon.njk" import angle, search %}
{% from "components/atoms/tag.njk" import tags %}

<section class="px-4 pt-20 md:pt-32">
    <div class="mx-auto max-w-295">
        <h1 class="mb-6 font-display text-[--spacing(13)] leading-[0.95] font-semibold tracking-tight md:text-[--spacing(26)]">{{ site.name }}<span class="text-kit-accent">.</span></h1>
        <p class="max-w-2xl text-lg text-kit-muted md:text-xl">{{ site.description }} Each component shows its markup and script, ready to copy into any website.</p>
    </div>
</section>

{# sticks under the header, so the search is always in reach #}
<div class="pointer-events-none sticky top-16 z-30 mt-7 mb-13 px-4 py-3 md:top-20">
    <div class="mx-auto max-w-295">
        <form class="pointer-events-auto relative w-full" action="/" method="get" role="search" data-search data-home-search>
            <label class="group relative block">
                <span class="sr-only">Search components</span>
                <span class="pointer-events-none absolute top-1/2 left-5 -translate-y-1/2 text-kit-text md:left-6 md:text-xl">{{ search() }}</span>
                <input id="search-home" class="h-14 w-full rounded-full border border-kit-text/25 bg-kit-bg pr-6 pl-12 shadow-[0_12px_32px_-16px_rgb(0_0_0/0.25)] transition-[border-color,box-shadow] duration-300 placeholder:text-kit-muted hover:border-kit-text/50 focus:border-kit-accent focus:ring-4 focus:ring-kit-accent/20 focus:outline-none md:h-16 md:pr-16 md:pl-15 md:text-lg" type="search" name="q" placeholder="Search components or utils…" autocomplete="off" data-filter-input data-search-input />
                <kbd class="pointer-events-none absolute top-1/2 right-5 hidden size-7 -translate-y-1/2 items-center justify-center rounded-lg border border-kit-text/20 bg-kit-bg font-mono text-sm text-kit-muted transition-opacity duration-300 group-focus-within:opacity-0 group-has-[input:not(:placeholder-shown)]:opacity-0 md:flex" aria-hidden="true">/</kbd>
            </label>
            <div id="search-home-list" class="absolute top-full left-0 mt-2 max-h-[70vh] w-full overflow-y-auto rounded-3xl border border-kit-line bg-kit-bg p-2 shadow-xl" hidden data-search-list></div>
        </form>
    </div>
</div>

<section id="components" class="scroll-mt-36 md:scroll-mt-42 px-4 pt-8 pb-24 md:pb-32">
    <div class="mx-auto max-w-295 space-y-16 md:space-y-24">
        {% for group in components %}
        <div data-filter-group>
            <div class="mb-8 flex flex-wrap items-baseline justify-between gap-4 border-b border-kit-line pb-4">
                <h2 class="font-display text-3xl font-semibold tracking-tight md:text-4xl">{{ group.category }}</h2>
                {% if group.url %}
                <a class="group inline-flex items-center gap-1 font-medium transition-colors duration-300 hover:text-kit-accent" href="{{ group.url }}">Overview {{ angle('right', 'duration-500 ease-out-expo group-hover:translate-x-0.5') }}</a>
                {% endif %}
            </div>
            <ul class="grid gap-4 md:grid-cols-2 md:gap-6 lg:grid-cols-3">
                {% for item in group.items %}
                <li class="flex" data-filter-item="{{ item.label }} {{ item.description }} {{ item.utils }} {{ group.category }}">
                    {% if item.ready %}
                    <a class="group flex w-full flex-col rounded-3xl border border-kit-line p-6 transition-colors duration-500 hover:border-kit-accent md:p-8" href="{{ item.url }}">
                        <h3 class="mb-2 font-display text-2xl font-medium tracking-tight">{{ item.label }}</h3>
                        <p class="mb-6 flex-1 text-kit-muted">{{ item.description }}</p>
                        {% if item.utils %}
                        {{ tags(item.utils, 'mb-6') }}
                        {% endif %}
                        <span class="inline-flex items-center gap-1 font-medium transition-colors duration-300 group-hover:text-kit-accent">Open demo {{ angle('right', 'duration-500 ease-out-expo group-hover:translate-x-0.5') }}</span>
                    </a>
                    {% else %}
                    <div class="flex w-full flex-col rounded-3xl border border-dashed border-kit-line p-6 md:p-8">
                        <div class="mb-2 flex items-start justify-between gap-2">
                            <h3 class="font-display text-2xl font-medium tracking-tight text-kit-muted">{{ item.label }}</h3>
                            <span class="rounded-full bg-kit-surface px-3 py-1 text-xs font-medium text-kit-muted">Soon</span>
                        </div>
                        <p class="text-kit-muted">{{ item.description }}</p>
                    </div>
                    {% endif %}
                </li>
                {% endfor %}
            </ul>
        </div>
        {% endfor %}
        <p class="hidden text-kit-muted" data-filter-empty>No components match your search.</p>
    </div>
</section>

{% footerscript %}
<script type="module">
    // component search, the input is in the hero, so the scope is the whole page
    _filter.init();

    // ?q= from the header search, kept in the url
    const _form = document.querySelector("[data-home-search]");
    const _input = _form.querySelector("[data-filter-input]");
    const _query = _urlVars.get("q");

    if (_query) {
        _input.value = _query;
        _input.dispatchEvent(new Event("input"));
    }

    _input.addEventListener("input", () => _urlVars.set({ q: _input.value.trim() }));

    // "/" jumps to the search, unless typing somewhere else
    document.addEventListener("keydown", (e) => {
        if (e.key !== "/" || e.metaKey || e.ctrlKey || e.target.closest("input, textarea, select, [contenteditable]")) return;
        e.preventDefault();
        _input.focus();
    });

    // typing while stuck goes back to the top of the list
    const _list = document.getElementById("components");
    _input.addEventListener("input", () => {
        if (_list.getBoundingClientRect().top < _form.getBoundingClientRect().bottom) _list.scrollIntoView();
    });

    // Enter only closes the phone keyboard
    _form.addEventListener("submit", (e) => {
        e.preventDefault();
        _input.blur();
    });
</script>
{% endfooterscript %}
