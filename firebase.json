{
    "hosting": {
        "public": "public",
        "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
        "cleanUrls": true,
        "headers": [
            {
                "regex": "^[^.]*$",
                "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
            },
            {
                "source": "**/*.html",
                "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
            },
            {
                "source": "/assets/@(js|css)/**",
                "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
            },
            {
                "source": "**/*.@(png|jpg|webp|svg|ico|webmanifest|mp4)",
                "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
            }
        ],
        "redirects": [
            { "source": "/components/lazy-load{,/**}", "destination": "/components/lazyload/", "type": 301 },
            { "source": "/components/text-roll{,/**}", "destination": "/components/text-effects/roll/", "type": 301 },
            { "source": "/components/scramble-text{,/**}", "destination": "/components/text-effects/scramble/", "type": 301 },
            { "source": "/components/typing-animation{,/**}", "destination": "/components/text-effects/typing/", "type": 301 },
            { "source": "/components/text-effects/line-reveal{,/**}", "destination": "/components/animate/#split-text", "type": 301 }
        ]
    }
}
