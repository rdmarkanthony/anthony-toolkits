{
    "name": "anthony-toolkits",
    "version": "1.0.0",
    "type": "module",
    "description": "Reusable components and utilities for site development",
    "main": "index.js",
    "scripts": {
        "dev": "npm-run-all -p 'dev:*'",
        "dev:eleventy": "eleventy --serve --watch",
        "dev:css": "pnpm dlx @tailwindcss/cli -i ./src/assets/css/style.css -o ./public/assets/css/style.css --watch",
        "dev:js": "node esbuild.config.js --watch",
        "build": "npm-run-all -s 'build:*'",
        "build:eleventy": "eleventy",
        "build:css": "pnpm dlx @tailwindcss/cli -i ./src/assets/css/style.css -o ./public/assets/css/style.css --minify",
        "build:js": "node esbuild.config.js",
        "test": "echo \"Error: no test specified\" && exit 1",
        "format": "prettier --write .",
        "preinstall": "npx only-allow pnpm"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "packageManager": "pnpm@10.28.2",
    "dependencies": {
        "@11ty/eleventy": "^3.1.2",
        "animate.css": "^4.1.1",
        "flatpickr": "^4.6.13",
        "gsap": "^3.15.0",
        "hls.js": "^1.7.3",
        "luxon": "^3.7.2",
        "plyr": "^3.8.5",
        "split-type": "^0.3.4"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.2.0",
        "autoprefixer": "^10.4.24",
        "cssnano": "^7.1.2",
        "dotenv": "^17.3.1",
        "esbuild": "^0.27.3",
        "npm-run-all": "^4.1.5",
        "postcss": "^8.5.6",
        "prettier": "^3.8.1",
        "prettier-plugin-jinja-template": "^2.1.0",
        "tailwindcss": "^4.2.0"
    }
}
